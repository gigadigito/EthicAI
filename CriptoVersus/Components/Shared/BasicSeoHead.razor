@using System.Text.Json
@using CriptoVersus.Web.Services

<PageTitle>@Title</PageTitle>
<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Robots))
    {
        <meta name="robots" content="@Robots" />
    }
    <meta name="description" content="@Description" />
    @if (RenderKeywords)
    {
        <meta name="keywords" content="@ResolvedKeywords" />
    }
    <link rel="canonical" href="@CanonicalUrl" />
    @if (AlternateLinks is { Count: > 0 })
    {
        @foreach (var alternate in AlternateLinks)
        {
            <link rel="alternate" hreflang="@alternate.HrefLang" href="@alternate.Href" />
        }
    }
    else if (!string.IsNullOrWhiteSpace(EnglishUrl))
    {
        <link rel="alternate" hreflang="en-US" href="@EnglishUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(PortugueseUrl))
    {
        <link rel="alternate" hreflang="pt-BR" href="@PortugueseUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(XDefaultUrl))
    {
        <link rel="alternate" hreflang="x-default" href="@XDefaultUrl" />
    }
    <meta property="og:title" content="@ResolvedOgTitle" />
    <meta property="og:description" content="@ResolvedOgDescription" />
    <meta property="og:url" content="@ResolvedOgUrl" />
    <meta property="og:type" content="@OgType" />
    @if (!string.IsNullOrWhiteSpace(OgLocale))
    {
        <meta property="og:locale" content="@OgLocale" />
    }
    @if (!string.IsNullOrWhiteSpace(OgAlternateLocale))
    {
        <meta property="og:locale:alternate" content="@OgAlternateLocale" />
    }
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <meta property="og:image" content="@ImageUrl" />
        <meta name="twitter:image" content="@TwitterImageUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(ImageAlt))
    {
        <meta property="og:image:alt" content="@ImageAlt" />
        <meta name="twitter:image:alt" content="@ImageAlt" />
    }
    <meta name="twitter:card" content="@TwitterCard" />
    <meta name="twitter:title" content="@ResolvedTwitterTitle" />
    <meta name="twitter:description" content="@ResolvedTwitterDescription" />
    <script type="application/ld+json">@((MarkupString)StructuredDataJson)</script>
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string CanonicalUrl { get; set; } = string.Empty;
    [Parameter] public string? Keywords { get; set; }
    [Parameter] public bool RenderKeywords { get; set; } = true;
    [Parameter] public IReadOnlyList<AlternateLink>? AlternateLinks { get; set; }
    [Parameter] public string? EnglishUrl { get; set; }
    [Parameter] public string? PortugueseUrl { get; set; }
    [Parameter] public string? XDefaultUrl { get; set; }
    [Parameter] public string? OgLocale { get; set; }
    [Parameter] public string? OgAlternateLocale { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? ImageAlt { get; set; }
    [Parameter] public string? OpenGraphTitle { get; set; }
    [Parameter] public string? OpenGraphDescription { get; set; }
    [Parameter] public string? OpenGraphUrl { get; set; }
    [Parameter] public string? TwitterTitle { get; set; }
    [Parameter] public string? TwitterDescription { get; set; }
    [Parameter] public string TwitterCard { get; set; } = "summary_large_image";
    [Parameter] public string OgType { get; set; } = "website";
    [Parameter] public string? Robots { get; set; }
    [Parameter] public string? JsonLd { get; set; }

    private string ResolvedKeywords => string.IsNullOrWhiteSpace(Keywords) ? SeoDefaults.GlobalKeywords : Keywords!;
    private string ResolvedOgTitle => string.IsNullOrWhiteSpace(OpenGraphTitle) ? Title : OpenGraphTitle!;
    private string ResolvedOgDescription => string.IsNullOrWhiteSpace(OpenGraphDescription) ? Description : OpenGraphDescription!;
    private string ResolvedOgUrl => string.IsNullOrWhiteSpace(OpenGraphUrl) ? CanonicalUrl : OpenGraphUrl!;
    private string ResolvedTwitterTitle => string.IsNullOrWhiteSpace(TwitterTitle) ? Title : TwitterTitle!;
    private string ResolvedTwitterDescription => string.IsNullOrWhiteSpace(TwitterDescription) ? Description : TwitterDescription!;
    private string TwitterImageUrl => string.IsNullOrWhiteSpace(ImageUrl) ? string.Empty : ImageUrl!;
    private string StructuredDataJson => string.IsNullOrWhiteSpace(JsonLd) ? BuildDefaultStructuredData() : JsonLd!;

    private string BuildDefaultStructuredData()
    {
        var payload = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebPage",
            ["name"] = Title,
            ["description"] = Description,
            ["url"] = CanonicalUrl
        };

        if (!string.IsNullOrWhiteSpace(ImageUrl))
            payload["image"] = ImageUrl;

        return JsonSerializer.Serialize(payload);
    }
}

