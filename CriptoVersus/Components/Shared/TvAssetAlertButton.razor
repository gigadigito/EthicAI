@inject LocalizationService L

<button type="button"
        class="tv-alert-btn @(IsSubscribed ? "tv-alert-btn--active" : string.Empty)"
        title="@T(IsSubscribed ? "tvAssetAlertRemove" : "tvAssetAlertFollow")"
        aria-label="@T(IsSubscribed ? "tvAssetAlertRemove" : "tvAssetAlertFollow")"
        @onclick="HandleClickAsync">
    <i class="bi @(IsSubscribed ? "bi-bell-fill" : "bi-bell")" aria-hidden="true"></i>
</button>

@code {
    [Parameter, EditorRequired] public int CurrencyId { get; set; }
    [Parameter] public string? Symbol { get; set; }
    [Parameter] public string? Culture { get; set; }
    [Parameter] public bool IsSubscribed { get; set; }
    [Parameter] public EventCallback OnClicked { get; set; }

    private string T(string key) => L.T($"matchDetail.{key}", Culture ?? "en");

    private async Task HandleClickAsync()
    {
        if (CurrencyId <= 0) return;
        await OnClicked.InvokeAsync();
    }
}
