@using CriptoVersus.Web.Services
@using DTOs
@inject CriptoVersusApiClient Api
@inject HotMatchService HotMatches
@inject MatchSlugHelper MatchSlugHelper
@inject RouteLocalizationService RouteLocalization
@inject DashboardHubClient Hub
@inject LocalizationService L
@inject IJSRuntime JS
@inject ILogger<ArenaPressureGameHost> Logger
@implements IAsyncDisposable

<section class="arena-pressure" aria-label="@T("title")">
    <header class="arena-pressure__toolbar">
        <div class="arena-pressure__brand">
            <strong>@T("title")</strong>
            <span class="arena-pressure__pair">
                <em class="arena-pressure__side arena-pressure__side--left">@DisplayLeftSymbol</em>
                <b>VS</b>
                <em class="arena-pressure__side arena-pressure__side--right">@DisplayRightSymbol</em>
            </span>
        </div>
        <div class="arena-pressure__badges">
            @if (IsFinished)
            {
                <span class="arena-pressure__badge arena-pressure__badge--finished">@T("finished")</span>
            }
            else
            {
                <span class="arena-pressure__badge arena-pressure__badge--live">@T("live")</span>
            }
            @if (MatchId > 0)
            {
                <a class="arena-pressure__link" href="@MatchUrl">@T("watchOnTv")</a>
            }
        </div>
    </header>

    <div class="arena-pressure__stage" @ref="_stage" role="img" aria-label="@T("stageAria")">
        @if (_failed)
        {
            <div class="arena-pressure__error">
                <p>@T("error")</p>
                <button type="button" @onclick="RetryAsync">@T("retry")</button>
            </div>
        }
    </div>

    @if (_hasHistory)
    {
        <div class="arena-pressure__transport">
            <button type="button" @onclick="TogglePlaybackAsync" aria-label="@(_playing ? T("pause") : T("play"))">
                @(_playing ? T("pause") : T("play"))
            </button>
            <input type="range"
                   min="0"
                   max="@((int)Math.Ceiling(_durationSeconds))"
                   step="1"
                   value="@((int)Math.Round(_playheadSeconds))"
                   @onchange="SeekAsync"
                   aria-label="@T("timeline")" />
            <span class="arena-pressure__clock">@FormatClock(MatchSeconds) / @FormatClock(_matchSpanSeconds)</span>
            <label class="arena-pressure__speed">
                @T("speed")
                <select value="@_speed" @onchange="ChangeSpeedAsync">
                    <option value="0.5">0.5x</option>
                    <option value="1">1x</option>
                    <option value="2">2x</option>
                    <option value="4">4x</option>
                </select>
            </label>
        </div>
    }

    <footer class="arena-pressure__footer" role="status" aria-live="polite">
        <span>@(_hasHistory ? T("historyCaption") : T("liveCaption"))</span>
        <span>@_status</span>
    </footer>
</section>

<style>
    .arena-pressure {
        width: 100%;
        display: grid;
        gap: 0.65rem;
        color: #e6edf7;
    }

    .arena-pressure__toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
    }

    .arena-pressure__brand {
        display: flex;
        align-items: baseline;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .arena-pressure__brand strong {
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 900;
    }

    .arena-pressure__pair {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
    }

    .arena-pressure__side {
        font-style: normal;
        font-weight: 800;
        letter-spacing: 0.06em;
    }

    .arena-pressure__side--left {
        color: #ff9100;
    }

    .arena-pressure__side--right {
        color: #18d8d2;
    }

    .arena-pressure__badges {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
    }

    .arena-pressure__badge {
        padding: 0.15rem 0.65rem;
        border-radius: 999px;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border: 1px solid rgba(148, 163, 184, 0.35);
    }

    .arena-pressure__badge--live {
        color: #7cf7c5;
        border-color: rgba(124, 247, 197, 0.5);
    }

    .arena-pressure__badge--finished {
        color: #f4c66b;
        border-color: rgba(244, 198, 107, 0.5);
    }

    .arena-pressure__link {
        color: #9fb3cc;
        text-decoration: none;
        border-bottom: 1px solid rgba(159, 179, 204, 0.4);
    }

    .arena-pressure__link:hover {
        color: #e6edf7;
    }

    .arena-pressure__stage {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        background: #09111f;
        border: 1px solid rgba(48, 66, 92, 0.85);
        border-radius: 10px;
        overflow: hidden;
    }

    .arena-pressure__stage canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    .arena-pressure__error {
        position: absolute;
        inset: 0;
        display: grid;
        place-content: center;
        gap: 0.75rem;
        text-align: center;
        background: rgba(9, 17, 31, 0.92);
    }

    .arena-pressure__transport {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 0.5rem 0.75rem;
        border: 1px solid rgba(48, 66, 92, 0.85);
        border-radius: 10px;
        background: rgba(9, 17, 31, 0.7);
    }

    .arena-pressure__transport input[type="range"] {
        flex: 1 1 220px;
        min-width: 160px;
        accent-color: #ff9100;
    }

    .arena-pressure__clock,
    .arena-pressure__speed {
        font-variant-numeric: tabular-nums;
        font-size: 0.82rem;
        color: #a9bad0;
    }

    .arena-pressure__speed select {
        margin-left: 0.35rem;
        background: #0c1727;
        color: #e6edf7;
        border: 1px solid rgba(48, 66, 92, 0.85);
        border-radius: 6px;
        padding: 0.15rem 0.35rem;
    }

    .arena-pressure__transport button,
    .arena-pressure__error button {
        background: #12233a;
        color: #e6edf7;
        border: 1px solid rgba(90, 120, 160, 0.6);
        border-radius: 8px;
        padding: 0.35rem 0.95rem;
        cursor: pointer;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .arena-pressure__transport button:hover,
    .arena-pressure__error button:hover {
        background: #1b3352;
    }

    .arena-pressure__footer {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        font-size: 0.78rem;
        color: #8ea1b8;
    }

    @@media (max-width: 767.98px) {
        .arena-pressure__toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .arena-pressure__brand {
            gap: 0.5rem;
        }

        .arena-pressure__transport {
            gap: 0.5rem;
        }
    }
</style>

@code {
    [Parameter] public int MatchId { get; set; }
    [Parameter] public string Culture { get; set; } = AppCultureService.DefaultRouteCulture;
    [Parameter] public MatchDto? Match { get; set; }
    [Parameter] public TvHotMatchDto? HotMatch { get; set; }

    private const int LiveRefreshIntervalSeconds = 5;

    private static readonly string[] LabelKeys =
    [
        "title", "leftPressure", "rightPressure", "leftDominance", "rightDominance",
        "balanced", "live", "finished", "pressureEngine"
    ];

    private ElementReference _stage;
    private IJSObjectReference? _module;
    private IJSObjectReference? _engine;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _refresh = new(1, 1);
    private Task? _initialization;
    private Task? _liveLoop;
    private Task? _transportLoop;
    private bool _disposed;
    private bool _failed;
    private bool _hasHistory;
    private bool _playing;
    private double _playheadSeconds;
    private double _durationSeconds;
    private double _matchSpanSeconds;
    private string _speed = "1";
    private string _status = string.Empty;

    private string T(string key) => L.T($"arenaPressure.{key}", Culture);
    private string DisplayLeftSymbol => !string.IsNullOrWhiteSpace(Match?.TeamA) ? Match!.TeamA : (HotMatch?.LeftSymbol ?? "--");
    private string DisplayRightSymbol => !string.IsNullOrWhiteSpace(Match?.TeamB) ? Match!.TeamB : (HotMatch?.RightSymbol ?? "--");
    private string MatchUrl => RouteLocalization.BuildTvMatchPath(Culture, MatchId, MatchSlug());
    private bool IsFinished => Match is not null
        && (Match.EndTime is not null || TvProceduralCyclePolicy.IsTerminal(Match.IsFinished, Match.Status));

    private string MatchSlug()
        => Match is null
            ? (HotMatch?.Slug ?? "match")
            : MatchSlugHelper.BuildSlug(Match.TeamA, Match.TeamB);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await (_initialization = InitializeAsync());
    }

    private async Task InitializeAsync()
    {
        var stage = "module_import";
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/dist/arena-pressure/engine.20261105a.js");
            if (_disposed) return;

            stage = "history_load";
            var history = await LoadHistoryAsync(_lifetime.Token);
            if (_disposed) return;

            stage = "engine_initialization";
            var pair = ArenaPressureSource.GetPair(Match, HotMatch);
            _hasHistory = history.Count > 0;
            _matchSpanSeconds = history.Count > 0 ? history[^1].SecondsFromStart : 0;

            // A match can span hours or days; the replay compresses that into a short
            // watchable window while the transport still reports the real match clock.
            _durationSeconds = ResolvePlaybackSeconds(_matchSpanSeconds);
            _playing = _hasHistory;
            var scaledHistory = _hasHistory
                ? history.Select(p => new { t = ScaleToPlayback(p.SecondsFromStart, _matchSpanSeconds, _durationSeconds), l = p.LeftPercent }).ToArray()
                : [];

            _engine ??= await _module.InvokeAsync<IJSObjectReference>("create", _stage,
                new
                {
                    baseUrl = "/games/arena-pressure/assets/",
                    initialLeft = pair.Left,
                    initialRight = pair.Right,
                    leftSymbol = DisplayLeftSymbol,
                    rightSymbol = DisplayRightSymbol,
                    culture = Culture,
                    labels = LabelKeys.ToDictionary(k => k, T),
                    reducedMotion = false,
                    isFinished = IsFinished,
                    isLive = !IsFinished,
                    history = scaledHistory,
                    historyDurationSeconds = _durationSeconds
                });

            if (_disposed) return;
            _failed = false;
            _status = IsFinished ? T("finished") : T("live");

            if (_hasHistory)
            {
                // Transport only: keeps the scrubber in sync with the replay clock.
                // It never recomputes pressure, so it cannot race the live update path.
                _transportLoop ??= RunTransportLoopAsync(_lifetime.Token);
            }

            if (!IsFinished && MatchId > 0)
            {
                Hub.DashboardChanged -= OnDashboardChanged;
                Hub.DashboardChanged += OnDashboardChanged;
                try { await Hub.EnsureStartedAsync(_lifetime.Token); }
                catch (OperationCanceledException) { }
                catch (Exception ex) { Logger.LogDebug(ex, "Arena Pressure hub connection unavailable; polling continues."); }

                _liveLoop ??= RunLiveLoopAsync(_lifetime.Token);
            }
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Arena Pressure renderer disconnected. MatchId={MatchId} Stage={Stage}", MatchId, stage);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Arena Pressure initialization failed. MatchId={MatchId} Stage={Stage}", MatchId, stage);
            _failed = true;
            _status = T("error");
        }

        if (!_disposed)
            await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Loads the real recorded history and reconstructs the pressure evolution from it.
    /// Returns an empty list when the match has no usable history, in which case the
    /// game shows the last real state instead of inventing a timeline.
    /// </summary>
    private async Task<IReadOnlyList<ArenaPressureHistoryPoint>> LoadHistoryAsync(CancellationToken ct)
    {
        if (MatchId <= 0 || Match is null)
            return [];

        try
        {
            var eventsTask = Api.GetMatchScoreEventsAsync(MatchId, Culture, ct);
            var snapshotsTask = Api.GetMatchMetricSnapshotsAsync(MatchId, 500, ct);
            await Task.WhenAll(eventsTask, snapshotsTask);

            var events = await eventsTask ?? [];
            var snapshots = await snapshotsTask ?? [];
            return ArenaPressureSource.BuildHistory(Match, events, snapshots);
        }
        catch (OperationCanceledException)
        {
            return [];
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Arena Pressure history unavailable. MatchId={MatchId}", MatchId);
            return [];
        }
    }

    /// <summary>
    /// Single live update loop. Reads the same match state the Match Arena gauge reads
    /// and pushes the resulting pressure into the running engine.
    /// </summary>
    private async Task RunLiveLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(LiveRefreshIntervalSeconds));
        try
        {
            while (!_disposed && await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(RefreshPressureAsync);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnDashboardChanged(string? payload)
    {
        if (!_disposed)
            _ = InvokeAsync(RefreshPressureAsync);
    }

    /// <summary>
    /// Reads back the replay clock so the transport controls follow the engine. This is
    /// presentation only and never feeds the pressure value.
    /// </summary>
    private async Task RunTransportLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (!_disposed && await timer.WaitForNextTickAsync(ct))
            {
                if (_disposed || _engine is null || !_hasHistory)
                    return;

                ArenaEngineState? state;
                try
                {
                    state = await _engine.InvokeAsync<ArenaEngineState?>("getState");
                }
                catch (JSDisconnectedException)
                {
                    return;
                }

                if (state is null)
                    continue;

                _playheadSeconds = state.PlayheadSeconds;
                _durationSeconds = state.DurationSeconds;
                _playing = state.Playing;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshPressureAsync()
    {
        if (_disposed || _engine is null || MatchId <= 0)
            return;

        try
        {
            if (!await _refresh.WaitAsync(0, _lifetime.Token))
                return;
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            var match = await Api.GetMatchByIdAsync(MatchId, includeParticipants: false, _lifetime.Token);
            if (_disposed || match is null)
                return;

            TvHotMatchDto? hotMatch = HotMatch;
            if (!match.IsFinished && match.EndTime is null)
            {
                try
                {
                    var hotMatches = await HotMatches.GetHotMatchesAsync(_lifetime.Token);
                    var current = hotMatches.FirstOrDefault(x => x.MatchId == MatchId);
                    if (current is not null)
                        hotMatch = HotMatches.ToTvHotMatch(current, Culture, RouteLocalization);
                }
                catch (OperationCanceledException)
                {
                    return;
                }
                catch (Exception ex)
                {
                    Logger.LogDebug(ex, "Arena Pressure hot match refresh failed. MatchId={MatchId}", MatchId);
                }
            }

            Match = match;
            HotMatch = hotMatch;

            var pair = ArenaPressureSource.GetPair(match, hotMatch);
            await _engine.InvokeVoidAsync("updatePressure", pair.Left, IsFinished);
            _status = IsFinished ? T("finished") : T("live");

            if (IsFinished)
            {
                Hub.DashboardChanged -= OnDashboardChanged;
                _liveLoop = null;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "Arena Pressure renderer disconnected during refresh. MatchId={MatchId}", MatchId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Arena Pressure refresh failed. MatchId={MatchId}", MatchId);
        }
        finally
        {
            _refresh.Release();
        }

        if (!_disposed)
            await InvokeAsync(StateHasChanged);
    }

    private async Task TogglePlaybackAsync()
    {
        _playing = !_playing;
        await CommandAsync(_playing ? "play" : "pause");
    }

    private async Task SeekAsync(ChangeEventArgs e)
    {
        if (!double.TryParse(Convert.ToString(e.Value), out var seconds))
            return;

        _playheadSeconds = seconds;
        await CommandAsync("seek", seconds);
    }

    private async Task ChangeSpeedAsync(ChangeEventArgs e)
    {
        var value = Convert.ToString(e.Value);
        if (string.IsNullOrWhiteSpace(value) || !double.TryParse(value, out var speed))
            return;

        _speed = value;
        await CommandAsync("speed", speed);
    }

    private async Task RetryAsync()
    {
        _failed = false;
        await (_initialization = InitializeAsync());
    }

    private async Task CommandAsync(string action, double? value = null)
    {
        if (_disposed || _engine is null)
            return;

        try
        {
            if (value is null)
                await _engine.InvokeVoidAsync("command", action);
            else
                await _engine.InvokeVoidAsync("command", action, value);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private static string FormatClock(double seconds)
    {
        var total = Math.Max(0, (int)Math.Round(seconds));
        return $"{total / 60:00}:{total % 60:00}";
    }

    /// <summary>Real match seconds represented by the current replay playhead.</summary>
    private double MatchSeconds
        => _durationSeconds > 0d ? (_playheadSeconds / _durationSeconds) * _matchSpanSeconds : 0d;

    /// <summary>
    /// Watchable replay length: real time for short matches, compressed to at most two
    /// minutes for matches that span hours or days.
    /// </summary>
    private static double ResolvePlaybackSeconds(double matchSpanSeconds)
        => Math.Clamp(matchSpanSeconds, 15d, 120d);

    private static double ScaleToPlayback(double secondsFromStart, double matchSpanSeconds, double playbackSeconds)
    {
        if (matchSpanSeconds <= 0d)
            return 0d;

        return Math.Round((secondsFromStart / matchSpanSeconds) * playbackSeconds, 3);
    }

    /// <summary>Replay clock exposed by the engine for the transport controls.</summary>
    private sealed record ArenaEngineState(
        string Mode,
        bool Playing,
        double PlayheadSeconds,
        double DurationSeconds,
        double Speed,
        int LeftPercent);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Hub.DashboardChanged -= OnDashboardChanged;
        _lifetime.Cancel();

        if (_initialization is not null)
        {
            try { await _initialization; } catch (OperationCanceledException) { }
        }

        if (_liveLoop is not null)
        {
            try { await _liveLoop; } catch (OperationCanceledException) { }
        }

        if (_transportLoop is not null)
        {
            try { await _transportLoop; } catch (OperationCanceledException) { }
        }

        await _refresh.WaitAsync();
        try
        {
            if (_engine is not null)
            {
                try
                {
                    await _engine.InvokeVoidAsync("dispose");
                    await _engine.DisposeAsync();
                }
                catch (JSDisconnectedException) { }
            }

            if (_module is not null)
            {
                try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
            }
        }
        finally
        {
            _refresh.Release();
            _refresh.Dispose();
            _lifetime.Dispose();
        }
    }
}
