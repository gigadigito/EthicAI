@using CriptoVersus.Web.Services
@using DTOs
@inject ICandleBattleDataSource DataSource
@inject DashboardHubClient Hub
@inject LocalizationService L
@inject IJSRuntime JS
@inject IConfiguration Config
@inject ILogger<CandleBattlesHost> Logger
@implements IAsyncDisposable

<link rel="stylesheet" href="/css/candle-battles-dialogue.css?v=20261023c" />
@if (SocialCapture)
{
    <div class="candle-battles__canvas candle-battles__canvas--capture" @ref="_canvas" role="img" aria-label="@T("arena")">
        <button type="button" class="candle-battles__freeze" data-cb-action="socialFreeze" hidden aria-hidden="true"></button>
    </div>
}
else
{
<section class="candle-battles" aria-label="Candle Battles">
    <header class="candle-battles__toolbar">
        <strong class="candle-battles__brand"><span aria-hidden="true">▂▅▇</span> CANDLE BATTLES <small>@T("arcade")</small></strong>
        <div class="candle-battles__controls">
            <button type="button" data-cb-action="start">▶ @T("start")</button>
            <button type="button" data-cb-action="pause">Ⅱ @T("pause")</button>
            <button type="button" data-cb-action="restart">↻ @T("restart")</button>
            <button type="button" data-cb-action="replay">@T("replay")</button>
            @if (MatchId > 0) { <button type="button" data-cb-action="live" class="candle-battles__live">● LIVE</button> }
            <label>@T("speed") <select data-cb-action="speed"><option value="1">1x</option><option value="2">2x</option><option value="5">5x</option><option value="10">10x</option></select></label>
            <button type="button" data-cb-action="mute">♫ @T("sound")</button>
            <button type="button" data-cb-action="fullscreen" aria-label='@T("fullscreen")'>⛶</button>
        </div>
    </header>
    <div class="candle-battles__audio">
        <label>@T("volume") <input type="range" min="0" max="1" step="0.05" value="0.65" data-cb-action="volume" /></label>
        <label>@T("music") <input type="range" min="0" max="1" step="0.05" value="0.35" data-cb-action="music" /></label>
        <label>@T("effects") <input type="range" min="0" max="1" step="0.05" value="0.7" data-cb-action="effects" /></label>
    </div>
    <div class="candle-battles__dashboard" data-cb-shell>
        <div class="candle-battles__top">
            @AssetPanel("left")
            <section class="candle-battles__countdown" aria-label='@T("nextBattle")'>
                <h2>@T("nextBattle")</h2>
                <div class="candle-battles__clock" data-cb="countdown">--:--</div>
                <p data-cb="countdownCaption">@T("candleClose")</p>
                <div class="candle-battles__progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-cb="progress"><i></i></div>
                <small data-cb="countdownNote">@T("forming")</small>
            </section>
            @AssetPanel("right")
        </div>
        <div class="candle-battles__score-row">
            <div class="candle-battles__match-clock"><small>@T("matchTime")</small><strong data-cb="matchTime">--:-- / 90:00</strong></div>
            <div class="candle-battles__scoreboard"><div><span data-cb="leftSymbol">—</span><strong data-cb="leftScore">0</strong><b>VS</b><strong data-cb="rightScore">0</strong><span data-cb="rightSymbol">—</span></div><small data-cb="round">@T("round") — / 18</small></div>
            <div class="candle-battles__mode" data-cb="mode">LIVE</div>
        </div>
    </div>
    <div class="candle-battles__canvas" @ref="_canvas" role="img" aria-label="@T("arena")">
        <div class="candle-battles__bubble" data-cb-bubble hidden aria-hidden="true"><span data-cb-bubble-text></span></div>
        <div class="candle-battles__arena-status" data-cb="battleStatus" aria-live="polite"></div>
        <div class="candle-battles__force candle-battles__force--left"><small>@T("strength")</small><strong data-cb="leftArenaStrength">—</strong><div><i data-cb="leftForceFill"></i></div></div>
        <div class="candle-battles__force candle-battles__force--right"><small>@T("strength")</small><strong data-cb="rightArenaStrength">—</strong><div><i data-cb="rightForceFill"></i></div></div>
        <div class="candle-battles__final" data-cb="finalPanel" hidden><div><small>@T("matchFinished")</small><h2 data-cb="champion">—</h2><strong data-cb="finalScore">—</strong><p data-cb="finalDetails"></p><button type="button" data-cb-action="replay">@T("watchReplay")</button></div></div>
    </div>
    <div class="candle-battles__bottom" data-cb-shell-bottom>
        <section class="candle-battles__card candle-battles__recent"><h2>@T("recent") <button type="button" data-cb-action="history">@T("viewAll")</button></h2><div data-cb="history"></div></section>
        <section class="candle-battles__card candle-battles__territory"><h2>@T("territory") <small data-cb="territoryCount">0 / 18</small></h2><div class="candle-battles__tiles" data-cb="territory"></div><strong data-cb="territoryPercent">0% / 0%</strong><div class="candle-battles__domain"><i data-cb="domainFill"></i></div></section>
        <section class="candle-battles__card candle-battles__info"><h2>@T("information")</h2><dl><div><dt>@T("candleState")</dt><dd data-cb="candleState">—</dd></div><div><dt>@T("matchTime")</dt><dd data-cb="infoMatchTime">—</dd></div><div><dt>@T("round")</dt><dd data-cb="infoRound">—</dd></div><div><dt>@T("finalScore")</dt><dd data-cb="infoScore">—</dd></div><div><dt>@T("status")</dt><dd data-cb="infoStatus">—</dd></div></dl></section>
    </div>
    <footer class="candle-battles__footer" role="status" aria-live="polite">
        <span>@(MatchId == 0 ? T("demo") : T("independent"))</span>
        <span>@_status</span>
        @if (_failed) { <button type="button" @onclick="Retry">@T("retry")</button> }
    </footer>
</section>
}

@code {
    [Parameter] public int MatchId { get; set; }
    [Parameter] public string Culture { get; set; } = "en";
    [Parameter] public bool SocialCapture { get; set; }
    [Parameter] public EventCallback<string> OnFailure { get; set; }
    /// <summary>Dev tooling: start the replay timeline paused so the panel drives every step.</summary>
    [Parameter] public bool ManualTimeline { get; set; }
    /// <summary>Dev tooling: pin the capture poster to one confrontation (0-based). Default is the final frame.</summary>
    [Parameter] public int? CaptureRound { get; set; }
    /// <summary>Dev tooling: hold a specific battle phase pose for capture.</summary>
    [Parameter] public string? CapturePhase { get; set; }
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private IJSObjectReference? _moneyFlowModule;
    private IJSObjectReference? _engine;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _refresh = new(1, 1);
    private readonly List<CandleBattlesRoundDto> _rounds = [];
    private Task? _poll;
    private Task? _initialization;
    private long? _cursor;
    private bool _disposed;
    private bool _failed;
    private bool _baseline;
    private bool _finished;
    private bool _moneyFlowSubscribed;
    private int _moneyFlowSubscribedMatchId;
    private string? _lastFailure;
    private string _status = string.Empty;
    private string _renderedCulture = string.Empty;
    private static readonly string[] LabelKeys = ["arcade", "forming", "waiting", "finished", "matchTime", "nextBattle", "round", "fight", "wins", "matchFinished", "finalScore", "incomplete", "recent", "lines", "page", "territory", "draw", "strength", "nextStrength", "crushing", "combo", "domination", "comeback", "candleClose", "awaitingClose", "viewAll", "information", "candleState", "status", "champion", "watchReplay", "volume", "change5m", "currentBattle"];
    private string T(string key) => L.T($"candleBattles.{key}", Culture);

    private RenderFragment AssetPanel(string side) => @<section class="candle-battles__asset candle-battles__asset--@side">
        <div class="candle-battles__asset-heading"><img data-cb="@(side)Logo" alt="" /><span class="candle-battles__logo-fallback" data-cb="@(side)LogoFallback" hidden>—</span><div><h2 data-cb="@(side)Asset">—</h2><strong data-cb="@(side)Price">—</strong><em data-cb="@(side)Change">—</em></div></div>
        <div class="candle-battles__metrics"><div><small>@T("strength")</small><strong data-cb="@(side)Strength">—</strong></div><div><small>@T("marketVolume")</small><strong data-cb="@(side)Volume">—</strong></div><div><small>@T("change5m")</small><strong data-cb="@(side)Delta">—</strong></div></div>
    </section>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await (_initialization = InitializeAsync());
        if (!_disposed && _engine is not null && _renderedCulture != Culture)
        {
            _renderedCulture = Culture;
            try { await _engine.InvokeVoidAsync("setLabels", LabelKeys.ToDictionary(k => k, T), Culture); }
            catch (JSDisconnectedException) { }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_moneyFlowSubscribed && _moneyFlowSubscribedMatchId != MatchId)
            await StopMoneyFlowAsync();
        await base.OnParametersSetAsync();
    }
    private async Task InitializeAsync()
    {
        var stage = "module_import";
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/dist/candle-battles/game.20261030a.js");
            stage = "renderer_initialization";
            _engine ??= await _module.InvokeAsync<IJSObjectReference>("create", _canvas,
                new
                {
                    mode = MatchId == 0 ? "demo" : "live",
                    culture = Culture,
                    labels = LabelKeys.ToDictionary(k => k, T),
                    battleDurationMs = Math.Clamp(Config.GetValue("CandleBattles:AnimationDurationMs", 3800), 3000, 5000),
                    crushingDifference = Math.Clamp(Config.GetValue("CandleBattles:CrushingDifference", 25), 0, 100),
                    socialCapture = SocialCapture,
                    shell = SocialCapture ? true : (bool?)null,
                    autoplay = !ManualTimeline,
                    moneyFlowVisualEffects = IsMoneyFlowVisualEffectsEnabled,
                    localLogos = DataSource.GetLocalLogos(MatchId),
                    captureTarget = CaptureRound is null && CapturePhase is null
                        ? null
                        : new { round = CaptureRound, phase = CapturePhase }
                });
            if (IsMoneyFlowEnabled && !SocialCapture)
                _moneyFlowModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/dist/candle-battles/money-flow.20261030a.js");
            if (_disposed) return;
            _failed = false; _lastFailure = null;
            if (MatchId > 0)
            {
                await RefreshAsync();
                if (_disposed) return;
                await EnsureMoneyFlowSubscriptionAsync();
                if (!_finished)
                {
                    if (DataSource.UsesLiveNotifications)
                    {
                        Hub.DashboardChanged -= OnDashboardChanged;
                        Hub.DashboardChanged += OnDashboardChanged;
                        try { await Hub.EnsureStartedAsync(_lifetime.Token); } catch (OperationCanceledException) { } catch { _status = T("polling"); }
                    }
                    _poll ??= PollAsync(_lifetime.Token);
                }
            }
        }
        catch (JSDisconnectedException ex) { Logger.LogDebug(ex, "Candle Battles renderer disconnected. MatchId={MatchId}, Stage={Stage}", MatchId, stage); }
        catch (Exception ex)
        {
            var failure = stage == "renderer_initialization" && ex.Message.Contains("asset", StringComparison.OrdinalIgnoreCase)
                ? "sprite_load" : stage;
            await ReportFailureAsync(failure, ex);
        }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    private bool IsMoneyFlowEnabled
        => !SocialCapture && MatchId > 0
            && Config.GetValue("CandleBattles:MoneyFlow:Enabled", false)
            && Config.GetValue("CandleBattles:MoneyFlow:TransportEnabled", false);

    private bool IsMoneyFlowVisualEffectsEnabled
        => IsMoneyFlowEnabled && Config.GetValue("CandleBattles:MoneyFlow:VisualEffectsEnabled", false);

    private void OnDashboardChanged(string? payload) { if (!_disposed) _ = InvokeAsync(RefreshAsync); }

    private void OnMoneyFlowBatch(MoneyFlowClientBatchDto batch)
    {
        if (_disposed || !_moneyFlowSubscribed || batch.MatchId != MatchId || _moneyFlowModule is null) return;
        _ = ForwardMoneyFlowAsync(batch);
    }

    private async Task ForwardMoneyFlowAsync(MoneyFlowClientBatchDto batch)
    {
        try
        {
            if (!_disposed && _moneyFlowModule is not null)
                await _moneyFlowModule.InvokeVoidAsync("receiveMoneyFlowBatch", batch, Config.GetValue("CandleBattles:MoneyFlow:FrontendBufferCapacity", 32));
        }
        catch (JSDisconnectedException) { }
    }

    private async Task EnsureMoneyFlowSubscriptionAsync()
    {
        if (!IsMoneyFlowEnabled || _finished || _moneyFlowSubscribed) return;
        Hub.MoneyFlowBatchReceived -= OnMoneyFlowBatch;
        Hub.MoneyFlowBatchReceived += OnMoneyFlowBatch;
        _moneyFlowSubscribed = await Hub.SubscribeToMoneyFlowAsync(MatchId, _lifetime.Token);
        if (_moneyFlowSubscribed) _moneyFlowSubscribedMatchId = MatchId;
    }

    private async Task StopMoneyFlowAsync()
    {
        if (!_moneyFlowSubscribed && !IsMoneyFlowEnabled) return;
        Hub.MoneyFlowBatchReceived -= OnMoneyFlowBatch;
        var subscribedMatchId = _moneyFlowSubscribedMatchId;
        if (_moneyFlowSubscribed && subscribedMatchId > 0)
            await Hub.UnsubscribeFromMoneyFlowAsync(subscribedMatchId, _lifetime.Token);
        _moneyFlowSubscribed = false;
        _moneyFlowSubscribedMatchId = 0;
        if (_moneyFlowModule is not null)
        {
            try { await _moneyFlowModule.InvokeVoidAsync("resetMoneyFlowBuffer", subscribedMatchId > 0 ? subscribedMatchId : MatchId); } catch (JSDisconnectedException) { }
        }
    }
    private async Task PollAsync(CancellationToken ct)
    {
        var interval = DataSource.UpdateInterval;
        if (interval is null) return;
        using var timer = new PeriodicTimer(interval.Value);
        try { while (!_finished && await timer.WaitForNextTickAsync(ct)) await InvokeAsync(RefreshAsync); }
        catch (OperationCanceledException) { }
    }
    private async Task RefreshAsync()
    {
        if (_disposed || _engine is null) return;
        try { if (!await _refresh.WaitAsync(0, _lifetime.Token)) return; }
        catch (OperationCanceledException) { return; }
        var stage = "api_unavailable";
        try
        {
            CandleBattlesFeedDto feed;
            do
            {
                feed = await DataSource.GetFeedAsync(MatchId, _cursor, _lifetime.Token)
                    ?? throw new InvalidOperationException();
                foreach (var round in feed.Rounds)
                    if (_rounds.All(r => r.Id != round.Id)) _rounds.Add(round);
                if (feed.HasMore && feed.NextCursor == _cursor) throw new InvalidOperationException();
                _cursor = feed.NextCursor;
            } while (feed.HasMore && !_disposed);
            if (_disposed) return;
            stage = "replay_execution";
            await _engine.InvokeVoidAsync("receive", feed with { Rounds = _rounds.ToArray() }, !_baseline || _failed);
            _baseline = true; _failed = false; _lastFailure = null;
            _finished = feed.Finished;
            if (_finished)
            {
                Hub.DashboardChanged -= OnDashboardChanged;
                await StopMoneyFlowAsync();
            }
            else
            {
                await EnsureMoneyFlowSubscriptionAsync();
            }
            _status = feed.Finished ? T("finished") : feed.Status == "live" ? T("forming") : T("waiting");
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException ex) { Logger.LogDebug(ex, "Candle Battles renderer disconnected. MatchId={MatchId}, Stage={Stage}", MatchId, stage); }
        catch (Exception ex) { await ReportFailureAsync(stage, ex); }
        finally { _refresh.Release(); }
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }
    private Task Retry() => _engine is null ? (_initialization = InitializeAsync()) : RefreshAsync();
    /// <summary>Dev tooling: forward one command to the shared engine (play/pause/seek/step/end/freeze/...).</summary>
    public async Task EngineCommandAsync(string action, double? value = null)
    {
        if (_disposed || _engine is null) return;
        try
        {
            if (value is null) await _engine.InvokeVoidAsync("command", action);
            else await _engine.InvokeVoidAsync("command", action, value);
        }
        catch (JSDisconnectedException) { }
    }
    /// <summary>Dev tooling: engine frame/state inspection payload for the sprite panel.</summary>
    public async Task<System.Text.Json.JsonElement?> InspectAsync()
    {
        if (_disposed || _engine is null) return null;
        try { return await _engine.InvokeAsync<System.Text.Json.JsonElement?>("inspect"); }
        catch (JSDisconnectedException) { return null; }
    }
    /// <summary>Dev tooling: re-read the data source and push the feed again.</summary>
    public Task ReloadAsync() => RefreshAsync();
    private async Task ReportFailureAsync(string failure, Exception ex)
    {
        _failed = true; _status = T("error");
        Logger.LogError(ex, "Candle Battles failed. MatchId={MatchId}, Failure={Failure}", MatchId, failure);
        if (_lastFailure == failure) return;
        _lastFailure = failure;
        if (OnFailure.HasDelegate) await OnFailure.InvokeAsync(failure);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Hub.DashboardChanged -= OnDashboardChanged; await StopMoneyFlowAsync(); _lifetime.Cancel();
        if (_initialization is not null) { try { await _initialization; } catch (OperationCanceledException) { } }
        if (_poll is not null) { try { await _poll; } catch (OperationCanceledException) { } }
        await _refresh.WaitAsync();
        try
        {
            if (_engine is not null) { try { await _engine.InvokeVoidAsync("dispose"); await _engine.DisposeAsync(); } catch (JSDisconnectedException) { } }
            if (_module is not null) { try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
            if (_moneyFlowModule is not null) { try { await _moneyFlowModule.DisposeAsync(); } catch (JSDisconnectedException) { } }
        }
        finally { _refresh.Release(); _refresh.Dispose(); _lifetime.Dispose(); }
    }
}
