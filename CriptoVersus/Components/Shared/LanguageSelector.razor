@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using CriptoVersus.Web.Services

@inject SupportedLanguageCatalog Languages
@inject IJSRuntime JS

@implements IAsyncDisposable

<div class="cv-language-selector" @ref="_root">
    <button type="button"
            class="cv-language-selector__trigger"
            aria-haspopup="listbox"
            aria-expanded="@_isOpen"
            aria-controls="@_listId"
            aria-label="@AriaLabel"
            title="@CurrentLanguage.NativeName"
            @onclick="ToggleAsync"
            @onkeydown="HandleTriggerKeyDownAsync"
            @ref="_trigger">

        <span class="cv-language-selector__globe"
              aria-hidden="true">
            &#127760;
        </span>

        <span class="cv-language-selector__label cv-language-selector__label--full">
            @CurrentLanguage.NativeName
        </span>

        <span class="cv-language-selector__label cv-language-selector__label--compact">
            @CurrentLanguage.ShortName
        </span>

        <span class="cv-language-selector__chevron"
              aria-hidden="true">
        </span>
    </button>

    @if (_isOpen)
    {
        <div id="@_listId"
             class="cv-language-selector__menu"
             role="listbox"
             aria-label="@AriaLabel">

            @for (var index = 0; index < _languages.Count; index++)
            {
                /*
                * IMPORTANTE:
                *
                * Não utilizar diretamente:
                *
                * @ref="_optionReferences[index]"
                *
                * porque o callback do @ref pode ser executado depois que
                * o for terminou. Nesse momento "index" pode ser igual a
                * _languages.Count, causando IndexOutOfRangeException.
                */
                var optionIndex = index;
                var option = _languages[optionIndex];

                var isSelected =
                option.RouteCulture.Equals(
                CurrentCulture,
                StringComparison.OrdinalIgnoreCase);

                <button type="button"
                        class="cv-language-selector__option @(isSelected
                                                    ? "cv-language-selector__option--selected"
                                                    : string.Empty)"
                role="option"
                aria-selected="@isSelected"
                @onclick="() => SelectAsync(option.RouteCulture)"
                @onkeydown="args => HandleOptionKeyDownAsync(args, optionIndex)"
                @ref="_optionReferences[optionIndex]">

                    <span>@option.NativeName</span>

            @if (isSelected)
                    {
                        <span class="cv-language-selector__check"
                              aria-hidden="true">
                            &#10003;
                        </span>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    private readonly string _listId =
        $"cv-language-options-{Guid.NewGuid():N}";

    private IReadOnlyList<SupportedLanguage> _languages =
        Array.Empty<SupportedLanguage>();

    private ElementReference[] _optionReferences =
        Array.Empty<ElementReference>();

    private ElementReference _root;
    private ElementReference _trigger;

    private IJSObjectReference? _module;

    private DotNetObjectReference<LanguageSelector>?
        _selfReference;

    private bool _isOpen;

    [Parameter, EditorRequired]
    public string CurrentCulture { get; set; } =
        AppCultureService.DefaultRouteCulture;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } =
        "Language";

    [Parameter]
    public EventCallback<string> OnCultureSelected { get; set; }

    private SupportedLanguage CurrentLanguage =>
        Languages.GetOrDefault(CurrentCulture);

    protected override void OnInitialized()
    {
        _languages = Languages.EnabledLanguages;

        _optionReferences =
            new ElementReference[_languages.Count];
    }

    private async Task ToggleAsync()
    {
        _isOpen = !_isOpen;

        await SynchronizeOutsideClickAsync();
    }

    private async Task SelectAsync(string culture)
    {
        if (string.IsNullOrWhiteSpace(culture))
            return;

        _isOpen = false;

        await SynchronizeOutsideClickAsync();

        await OnCultureSelected.InvokeAsync(culture);
    }

    private async Task HandleTriggerKeyDownAsync(
        KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " ")
        {
            await ToggleAsync();
            return;
        }

        if (args.Key is not ("ArrowDown" or "ArrowUp"))
            return;

        if (_languages.Count == 0)
            return;

        _isOpen = true;

        await SynchronizeOutsideClickAsync();

        /*
         * Força a renderização do menu antes de tentar
         * acessar os ElementReference das opções.
         */
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        var selectedIndex =
            FindCurrentLanguageIndex();

        /*
         * Se a cultura atual não estiver na lista,
         * usamos a primeira opção como fallback.
         */
        if (selectedIndex < 0)
            selectedIndex = 0;

        var targetIndex =
            args.Key == "ArrowUp"
                ? Math.Max(0, selectedIndex - 1)
                : Math.Min(
                    _languages.Count - 1,
                    selectedIndex + 1);

        await FocusOptionAsync(targetIndex);
    }

    private async Task HandleOptionKeyDownAsync(
        KeyboardEventArgs args,
        int currentIndex)
    {
        if (args.Key == "Escape")
        {
            _isOpen = false;

            await SynchronizeOutsideClickAsync();

            await _trigger.FocusAsync();

            return;
        }

        if (args.Key is not (
            "ArrowDown" or
            "ArrowUp" or
            "Home" or
            "End"))
        {
            return;
        }

        if (_languages.Count == 0)
            return;

        /*
         * Proteção extra contra índices inválidos.
         */
        currentIndex =
            Math.Clamp(
                currentIndex,
                0,
                _languages.Count - 1);

        var targetIndex =
            args.Key switch
            {
                "ArrowDown" =>
                    Math.Min(
                        _languages.Count - 1,
                        currentIndex + 1),

                "ArrowUp" =>
                    Math.Max(
                        0,
                        currentIndex - 1),

                "Home" =>
                    0,

                "End" =>
                    _languages.Count - 1,

                _ =>
                    currentIndex
            };

        await FocusOptionAsync(targetIndex);
    }

    private int FindCurrentLanguageIndex()
    {
        for (var index = 0;
             index < _languages.Count;
             index++)
        {
            if (_languages[index]
                .RouteCulture
                .Equals(
                    CurrentCulture,
                    StringComparison.OrdinalIgnoreCase))
            {
                return index;
            }
        }

        return -1;
    }

    private async Task FocusOptionAsync(int index)
    {
        if (index < 0)
            return;

        if (index >= _optionReferences.Length)
            return;

        await _optionReferences[index].FocusAsync();
    }

    private async Task SynchronizeOutsideClickAsync()
    {
        _module ??=
            await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/languageSelector.js");

        _selfReference ??=
            DotNetObjectReference.Create(this);

        if (_isOpen)
        {
            await _module.InvokeVoidAsync(
                "registerOutsideClick",
                _root,
                _selfReference);
        }
        else
        {
            await _module.InvokeVoidAsync(
                "unregisterOutsideClick",
                _root);
        }
    }

    [JSInvokable]
    public async Task CloseFromOutsideAsync()
    {
        if (!_isOpen)
            return;

        _isOpen = false;

        await InvokeAsync(StateHasChanged);

        /*
         * Remove também o listener JS quando
         * o fechamento veio de clique externo.
         */
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync(
                    "unregisterOutsideClick",
                    _root);
            }
            catch (JSDisconnectedException)
            {
                // Circuito Blazor já foi encerrado.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync(
                    "unregisterOutsideClick",
                    _root);

                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // O circuito pode fechar antes da limpeza JS.
            }
        }

        _selfReference?.Dispose();
    }
}