@page "/tv/match/{MatchId:int}/{Slug}"
@page "/{Culture}/tv/match/{MatchId:int}/{Slug}"
@using System.Diagnostics
@using System.Text.Json
@using DTOs
@using CriptoVersus.Web.Services
@inject CriptoVersusApiClient Api
@inject HotMatchService HotMatches
@inject AppCultureService AppCulture
@inject IConfiguration Config
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject LocalizationService L
@inject NavigationManager Nav
@inject RouteLocalizationService RouteLocalization
@inject MatchSlugHelper MatchSlugHelper
@inject ILogger<TvMatchPage> Logger
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>@PageTitleText</PageTitle>
<HeadContent>
    <meta name="description" content="@MetaDescription" />
    <meta name="keywords" content="@MetaKeywords" />
    <link rel="canonical" href="@CanonicalUrl" />
    <link rel="alternate" hreflang="en-US" href="@EnglishUrl" />
    <link rel="alternate" hreflang="pt-BR" href="@PortugueseUrl" />
    <link rel="alternate" hreflang="x-default" href="@EnglishUrl" />
    <meta property="og:title" content="@PageTitleText" />
    <meta property="og:description" content="@MetaDescription" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@SocialImageUrl" />
    <meta property="og:image:alt" content="@PageTitleText" />
    <meta property="og:locale" content="@AppCulture.ToOgLocale(_culture)" />
    <meta property="og:locale:alternate" content="@AppCulture.GetAlternateOgLocale(_culture)" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@PageTitleText" />
    <meta name="twitter:description" content="@MetaDescription" />
    <meta name="twitter:image" content="@SocialImageUrl" />
    <meta name="twitter:image:alt" content="@PageTitleText" />
    <script type="application/ld+json">@((MarkupString)StructuredDataMarkup)</script>
</HeadContent>

<main class="tv-match-page">
    <div class="tv-match-page__context" aria-hidden="@(_loadState != TvMatchPageLoadState.Loaded)">
        @if (_match is not null)
        {
            <TvStage Culture="@_culture"
                     IsBroadcastMode="false"
                     HotMatch="@_hotMatch"
                     Match="@_match"
                     Stats="@_stats"
                     Snapshot="@_snapshot"
                     TopCoinsLoading="@_topCoinsLoading"
                     TopCoinsError="@_topCoinsError"
                     LatestBattlesLoading="@_latestBattlesLoading"
                     LatestBattlesError="@_latestBattlesError"
                     MarketPulseLoading="@_marketPulseLoading"
                     MarketPulseError="@_marketPulseError" />
        }
        else
        {
            <section class="tv-match-page__ambient-context" aria-hidden="true">
                <div class="tv-match-page__ambient-grid"></div>
                <div class="tv-match-page__ambient-brand">CRIPTOVERSUS TV</div>
            </section>
        }
    </div>

    @if (_loadState != TvMatchPageLoadState.Loaded)
    {
        <section class="tv-match-page-state-shell @StateShellClass"
                 role="@(_loadState == TvMatchPageLoadState.Loading ? "status" : "dialog")"
                 aria-modal="@(_loadState == TvMatchPageLoadState.Loading ? null : "true")"
                 aria-live="polite"
                 aria-busy="@(_loadState == TvMatchPageLoadState.Loading)">
            <div class="tv-match-page-state-card @StateCardClass">
                <div class="tv-match-page-state-card__eyebrow">@LocalizedTvMatchText("eyebrow")</div>
                @if (_loadState == TvMatchPageLoadState.Loading)
                {
                    <div class="tv-match-page-state-card__spinner" aria-hidden="true"></div>
                }
                <h2>@LoadStateTitle</h2>
                <p>@LoadStateBody</p>

                @if (_loadState != TvMatchPageLoadState.Loading)
                {
                    <div class="tv-match-page-state-card__actions">
                        @if (_loadState == TvMatchPageLoadState.Unavailable && NextMatchUrl is not null)
                        {
                            <a class="tv-match-page-state-card__action tv-match-page-state-card__action--primary"
                               href="@NextMatchUrl">
                                @LocalizedTvMatchText("watchNext")
                            </a>
                        }

                        <a class="tv-match-page-state-card__action" href="@OtherMatchesUrl">
                            @LocalizedTvMatchText("viewMatches")
                        </a>
                        <a class="tv-match-page-state-card__action" href="@TvUrl">
                            @LocalizedTvMatchText("returnToTv")
                        </a>
                        <a class="tv-match-page-state-card__action tv-match-page-state-card__action--quiet" href="@HomeUrl">
                            @LocalizedTvMatchText("returnHome")
                        </a>

                        @if (_loadState == TvMatchPageLoadState.Error)
                        {
                            <button type="button"
                                    class="tv-match-page-state-card__action tv-match-page-state-card__action--retry"
                                    @onclick="RetryLoadAsync">
                                @LocalizedTvMatchText("retry")
                            </button>
                        }
                    </div>
                }
            </div>
        </section>
    }
</main>

@code {
    private const int RefreshIntervalSeconds = 15;
    private static readonly TimeSpan InitialLoadTimeout = TimeSpan.FromSeconds(8);
    private static readonly TimeSpan SecondaryFeedTimeout = TimeSpan.FromSeconds(8);

    [Parameter] public string? Culture { get; set; }
    [Parameter] public int MatchId { get; set; }
    [Parameter] public string? Slug { get; set; }

    private string _culture = AppCultureService.DefaultRouteCulture;
    private MatchDto? _match;
    private TvHotMatchDto? _hotMatch;
    private HotMatchDto? _nextAvailableMatch;
    private StatsOverviewDto? _stats;
    private DashboardSnapshotDto? _snapshot;
    private IJSObjectReference? _tvModule;
    private CancellationTokenSource? _refreshCts;
    private CancellationTokenSource? _routeLoadCts;
    private Task? _refreshLoopTask;
    private int _refreshInProgress;
    private bool _interactiveLoadRetryAttempted;
    private bool _secondaryDataLoadStarted;
    private int _secondaryRefreshInProgress;
    private bool _hasRenderedInteractiveOnce;
    private bool _isDisposed;
    private string _activeRouteKey = string.Empty;
    private TvMatchPageLoadState _loadState = TvMatchPageLoadState.Loading;
    private bool _topCoinsLoading = true;
    private bool _latestBattlesLoading = true;
    private bool _marketPulseLoading = true;
    private string? _topCoinsError;
    private string? _latestBattlesError;
    private string? _marketPulseError;

    private string LoadStateTitle => _loadState switch
    {
        TvMatchPageLoadState.NotFound => LocalizedTvMatchText("notFound"),
        TvMatchPageLoadState.Unavailable => LocalizedTvMatchText("unavailable"),
        TvMatchPageLoadState.Error => LocalizedTvMatchText("error"),
        _ => LocalizedTvMatchText("loading")
    };

    private string LoadStateBody => _loadState switch
    {
        TvMatchPageLoadState.NotFound => LocalizedTvMatchText("notFoundBody"),
        TvMatchPageLoadState.Unavailable => LocalizedTvMatchText("unavailableBody"),
        TvMatchPageLoadState.Error => LocalizedTvMatchText("errorBody"),
        _ => LocalizedTvMatchText("loadingBody")
    };

    private string StateShellClass => _loadState == TvMatchPageLoadState.Loading
        ? "tv-match-page-state-shell--loading"
        : "tv-match-page-state-shell--blocking";

    private string StateCardClass => _loadState is TvMatchPageLoadState.Error or TvMatchPageLoadState.NotFound
        ? "tv-match-page-state-card--error"
        : string.Empty;

    private string? NextMatchUrl => _nextAvailableMatch is null
        ? null
        : RouteLocalization.BuildTvMatchPath(
            _culture,
            _nextAvailableMatch.MatchId,
            ResolveHotMatchSlug(_nextAvailableMatch));

    private string OtherMatchesUrl => RouteLocalization.BuildStatsMatchesPath(_culture);
    private string TvUrl => RouteLocalization.BuildTvPath(_culture);
    private string HomeUrl => RouteLocalization.BuildHomePath(_culture);

    private string PageTitleText
        => _match is null
            ? L.T("tv.seo.title", _culture)
            : L.T("tv.seo.matchTitle", _culture, _match.TeamA, _match.TeamB);

    private string MetaDescription
        => _match is null
            ? L.T("tv.seo.matchDescriptionFallback", _culture)
            : L.T("tv.seo.matchDescription", _culture, _match.TeamA, _match.TeamB);

    private string CanonicalUrl => BuildAbsolute(RouteLocalization.BuildTvMatchPath(_culture, MatchId, ResolvedSlug));
    private string EnglishUrl => BuildAbsolute(RouteLocalization.BuildTvMatchPath(AppCultureService.DefaultRouteCulture, MatchId, ResolvedSlug));
    private string PortugueseUrl => BuildAbsolute(RouteLocalization.BuildTvMatchPath(AppCultureService.SecondaryRouteCulture, MatchId, ResolvedSlug));

    private string MetaKeywords => _match is null
        ? $"{SeoDefaults.GlobalKeywords}, CriptoVersus TV match, #CriptoVersus TV, crypto battle stream"
        : $"{SeoDefaults.GlobalKeywords}, CriptoVersus TV match, #CriptoVersus TV, {_match.TeamA} vs {_match.TeamB}, crypto match stream";

    private string SocialImageUrl => SeoDefaults.BuildPublicAbsoluteUrl(Config, SeoDefaults.DefaultSocialImagePath);

    private string StructuredDataMarkup
        => JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebPage",
            ["name"] = PageTitleText,
            ["description"] = MetaDescription,
            ["url"] = CanonicalUrl,
            ["image"] = SocialImageUrl,
            ["keywords"] = MetaKeywords,
            ["inLanguage"] = _culture
        });

    private string ResolvedSlug => !string.IsNullOrWhiteSpace(_match?.TeamA) && !string.IsNullOrWhiteSpace(_match?.TeamB)
        ? MatchSlugHelper.BuildSlug(_match.TeamA, _match.TeamB)
        : Slug?.Trim().ToLowerInvariant() ?? "match";

    protected override async Task OnParametersSetAsync()
    {
        _culture = !string.IsNullOrWhiteSpace(Culture)
            ? AppCulture.NormalizeRouteCulture(Culture)
            : AppCulture.DetectPreferredRouteCulture(HttpContextAccessor.HttpContext);

        var nextRouteKey = BuildRouteKey();
        if (string.Equals(_activeRouteKey, nextRouteKey, StringComparison.Ordinal))
            return;

        _activeRouteKey = nextRouteKey;

        CancelRouteLoad();
        ResetPageStateForRouteChange();

        var sw = Stopwatch.StartNew();

        Logger.LogInformation(
            "[TV_MATCH_LOAD] Route parameters changed. Loading matchId={MatchId} slug={Slug} culture={Culture}",
            MatchId,
            Slug,
            _culture);

        try
        {
            _routeLoadCts = new CancellationTokenSource(InitialLoadTimeout);
            await RefreshAsync(_routeLoadCts.Token);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning(
                "[TV_MATCH_LOAD] Route load timeout. Waiting for interactive retry. MatchId={MatchId}",
                MatchId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "[TV_MATCH_LOAD] Route load failed. MatchId={MatchId}",
                MatchId);
        }
        finally
        {
            Logger.LogInformation(
                "[TV_MATCH_LOAD] OnParametersSetAsync completed matchId={MatchId} elapsedMs={ElapsedMs}",
                MatchId,
                sw.ElapsedMilliseconds);
        }
    }

    protected override Task OnInitializedAsync()
    {
        // Loading is intentionally handled in OnParametersSetAsync.
        // Blazor can reuse this component when navigating between /tv/match routes;
        // OnInitializedAsync would not run again, leaving the page stuck on Loading until F5.
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _hasRenderedInteractiveOnce = true;
        var sw = Stopwatch.StartNew();

        try
        {
            _tvModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/tvMode.js?v=20260624-tvmatch-route-reload-1");

            Logger.LogInformation(
                "[TV_MATCH_LOAD] JS import tvMode matchId={MatchId} elapsedMs={ElapsedMs}",
                MatchId,
                sw.ElapsedMilliseconds);

            await LogAsync("loaded");
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            Logger.LogWarning(
                ex,
                "TvMatchPage JS module import failed. Match data load remains available without TV JS bootstrap. MatchId={MatchId}",
                MatchId);
        }

        if (_loadState == TvMatchPageLoadState.Loading && !_interactiveLoadRetryAttempted)
        {
            _interactiveLoadRetryAttempted = true;
            await RefreshAsync(CancellationToken.None);
        }

        EnsureRefreshLoopStarted();
    }

    private string BuildRouteKey()
        => $"{_culture}|{MatchId}|{Slug?.Trim().ToLowerInvariant()}";

    private void ResetPageStateForRouteChange()
    {
        _match = null;
        _hotMatch = null;
        _nextAvailableMatch = null;
        _stats = null;
        _snapshot = null;

        _loadState = TvMatchPageLoadState.Loading;

        _topCoinsLoading = true;
        _latestBattlesLoading = true;
        _marketPulseLoading = true;

        _topCoinsError = null;
        _latestBattlesError = null;
        _marketPulseError = null;

        _interactiveLoadRetryAttempted = false;
        _secondaryDataLoadStarted = false;

        Interlocked.Exchange(ref _refreshInProgress, 0);
        Interlocked.Exchange(ref _secondaryRefreshInProgress, 0);

        CancelRefreshLoop();
    }

    private void CancelRouteLoad()
    {
        try
        {
            _routeLoadCts?.Cancel();
        }
        catch
        {
        }

        _routeLoadCts?.Dispose();
        _routeLoadCts = null;
    }

    private void CancelRefreshLoop()
    {
        try
        {
            _refreshCts?.Cancel();
        }
        catch
        {
        }

        _refreshCts?.Dispose();
        _refreshCts = null;
        _refreshLoopTask = null;
    }

    private void EnsureRefreshLoopStarted()
    {
        if (_isDisposed)
            return;

        if (_refreshLoopTask is not null && !_refreshLoopTask.IsCompleted)
            return;

        _refreshCts?.Dispose();
        _refreshCts = new CancellationTokenSource();
        _refreshLoopTask = RunRefreshLoopAsync(_refreshCts.Token);

        Logger.LogInformation(
            "TvMatchPage refresh loop started. MatchId={MatchId} IntervalSeconds={IntervalSeconds}",
            MatchId,
            RefreshIntervalSeconds);
    }

    private async Task RunRefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(RefreshIntervalSeconds));

        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshMatchOnlyAsync(ct);
                await LoadSecondaryDataAsync(_activeRouteKey, ct);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshMatchOnlyAsync(CancellationToken ct)
    {
        if (_match is null || _isDisposed)
            return;

        var sw = Stopwatch.StartNew();

        try
        {
            Logger.LogInformation(
                "[TV_MATCH_REFRESH] Match refresh start matchId={MatchId}",
                MatchId);

            var updatedMatch = await MeasureLoadCallAsync(
                $"Api.GetMatchByIdAsync refresh matchId={MatchId}",
                () => Api.GetMatchByIdAsync(MatchId, includeParticipants: false, ct));

            if (updatedMatch is null)
            {
                Logger.LogWarning(
                    "[TV_MATCH_REFRESH] Match became null matchId={MatchId}",
                    MatchId);

                return;
            }

            _match = updatedMatch;

            if (IsUnavailableForTv(updatedMatch))
            {
                _loadState = TvMatchPageLoadState.Unavailable;
            }

            await InvokeAsync(StateHasChanged);

            Logger.LogInformation(
                "[TV_MATCH_REFRESH] Match refresh completed matchId={MatchId} elapsedMs={ElapsedMs}",
                MatchId,
                sw.ElapsedMilliseconds);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "[TV_MATCH_REFRESH] Match refresh failed matchId={MatchId}",
                MatchId);
        }
    }

    private async Task RefreshAsync(CancellationToken ct)
    {
        if (_isDisposed)
            return;

        if (Interlocked.Exchange(ref _refreshInProgress, 1) == 1)
        {
            Logger.LogInformation(
                "TvMatchPage refresh skipped because another refresh is already running. MatchId={MatchId}",
                MatchId);

            return;
        }

        var startedAtUtc = DateTime.UtcNow;
        var totalSw = Stopwatch.StartNew();
        var isInitialLoad = _match is null && _loadState != TvMatchPageLoadState.Loaded;

        try
        {
            Logger.LogInformation(
                "[TV_MATCH_LOAD] RefreshAsync start matchId={MatchId} slug={Slug} initial={Initial}",
                MatchId,
                Slug,
                isInitialLoad);

            if (isInitialLoad)
            {
                _loadState = TvMatchPageLoadState.Loading;
                _hotMatch = null;
                _secondaryDataLoadStarted = false;

                await InvokeAsync(StateHasChanged);
            }

            if (MatchId <= 0)
            {
                _loadState = TvMatchPageLoadState.NotFound;
                await InvokeAsync(StateHasChanged);
                return;
            }

            var match = await MeasureLoadCallAsync(
                $"Api.GetMatchByIdAsync matchId={MatchId} includeParticipants=false",
                () => Api.GetMatchByIdAsync(MatchId, includeParticipants: false, ct));

            if (match is null)
            {
                _loadState = TvMatchPageLoadState.NotFound;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (IsUnavailableForTv(match))
            {
                _match = match;
                await TryLoadInitialHotMatchAsync(ct);
                _loadState = TvMatchPageLoadState.Unavailable;
                await InvokeAsync(StateHasChanged);
                EnsureRefreshLoopStarted();
                StartSecondaryDataLoad();
                return;
            }

            var expectedPath = RouteLocalization.BuildTvMatchPath(
                _culture,
                match.MatchId,
                MatchSlugHelper.BuildSlug(match.TeamA, match.TeamB));

            var currentPath = "/" + Nav.ToBaseRelativePath(Nav.Uri)
                .Split('?', '#')[0]
                .Trim('/');

            if (!PathsEquivalent(currentPath, expectedPath))
            {
                Nav.NavigateTo(expectedPath, replace: true);
                return;
            }

            _match = match;

            if (isInitialLoad)
            {
                await TryLoadInitialHotMatchAsync(ct);
            }

            _loadState = TvMatchPageLoadState.Loaded;

            await InvokeAsync(StateHasChanged);

            EnsureRefreshLoopStarted();

            Logger.LogInformation(
                "[TV_MATCH_LOAD] FirstRenderReady matchId={MatchId} initial={Initial} hasHotMatch={HasHotMatch} elapsedMs={ElapsedMs}",
                MatchId,
                isInitialLoad,
                _hotMatch is not null,
                totalSw.ElapsedMilliseconds);

            if (isInitialLoad)
            {
                StartSecondaryDataLoad();
            }

            Logger.LogInformation(
                "TvMatchPage refresh completed. Mode={Mode} MatchId={MatchId} HasHotMatch={HasHotMatch} AvailableMatches={AvailableMatches} DurationMs={DurationMs}",
                "fixed-match-fast-path",
                MatchId,
                _hotMatch is not null,
                _stats?.LatestMatches?.Count ?? 0,
                (DateTime.UtcNow - startedAtUtc).TotalMilliseconds);
        }
        catch (OperationCanceledException)
        {
            if (isInitialLoad && _interactiveLoadRetryAttempted)
            {
                _loadState = TvMatchPageLoadState.Error;
                _topCoinsLoading = false;
                _latestBattlesLoading = false;
                _marketPulseLoading = false;
                _topCoinsError ??= LocalizedTvMatchText("error");
                _latestBattlesError ??= LocalizedTvMatchText("error");
                _marketPulseError ??= LocalizedTvMatchText("error");

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            if (isInitialLoad && _interactiveLoadRetryAttempted)
            {
                _loadState = TvMatchPageLoadState.Error;
                _topCoinsLoading = false;
                _latestBattlesLoading = false;
                _marketPulseLoading = false;
                _topCoinsError ??= LocalizedTvMatchText("error");
                _latestBattlesError ??= LocalizedTvMatchText("error");
                _marketPulseError ??= LocalizedTvMatchText("error");
            }

            Logger.LogWarning(ex, "TvMatchPage refresh failed. MatchId={MatchId}", MatchId);

            await LogAsync("refresh error", ex.Message);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            Logger.LogInformation(
                "[TV_MATCH_LOAD] Total matchId={MatchId} elapsedMs={ElapsedMs}",
                MatchId,
                totalSw.ElapsedMilliseconds);

            Interlocked.Exchange(ref _refreshInProgress, 0);
        }
    }

    private async Task TryLoadInitialHotMatchAsync(CancellationToken ct)
    {
        if (MatchId <= 0)
            return;

        var sw = Stopwatch.StartNew();

        try
        {
            Logger.LogInformation(
                "[TV_MATCH_LOAD] InitialHotMatch start matchId={MatchId}",
                MatchId);

            var hotMatches = await MeasureLoadCallAsync(
                "HotMatchService.GetHotMatchesAsync initial",
                () => HotMatches.GetHotMatchesAsync(ct));

            ApplyHotMatches(hotMatches);

            Logger.LogInformation(
                "[TV_MATCH_LOAD] InitialHotMatch completed matchId={MatchId} hasHotMatch={HasHotMatch} elapsedMs={ElapsedMs}",
                MatchId,
                _hotMatch is not null,
                sw.ElapsedMilliseconds);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning(
                "[TV_MATCH_LOAD] InitialHotMatch canceled. TvStage will render with Match fallback. MatchId={MatchId}",
                MatchId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "[TV_MATCH_LOAD] InitialHotMatch failed. TvStage will render with Match fallback. MatchId={MatchId}",
                MatchId);
        }
    }

    private void StartSecondaryDataLoad()
    {
        if (_secondaryDataLoadStarted || _isDisposed)
            return;

        _secondaryDataLoadStarted = true;

        var token = _refreshCts?.Token ?? CancellationToken.None;
        var routeKey = _activeRouteKey;

        _ = Task.Run(async () =>
        {
            try
            {
                await LoadSecondaryDataAsync(routeKey, token);
            }
            catch (Exception ex)
            {
                Logger.LogWarning(
                    ex,
                    "[TV_MATCH_LOAD] SecondaryData background task crashed. MatchId={MatchId}",
                    MatchId);
            }
        }, token);
    }

    private async Task LoadSecondaryDataAsync(string routeKey, CancellationToken ct)
    {
        if (_isDisposed || !string.Equals(routeKey, _activeRouteKey, StringComparison.Ordinal))
            return;

        if (Interlocked.Exchange(ref _secondaryRefreshInProgress, 1) == 1)
            return;

        var sw = Stopwatch.StartNew();

        try
        {
            Logger.LogInformation(
                "[TV_MATCH_LOAD] SecondaryData start matchId={MatchId}",
                MatchId);

            var hotTask = RefreshFixedHotMatchAsync(routeKey, ct);
            var statsTask = RefreshFixedStatsPanelsAsync(routeKey, ct);
            var snapshotTask = RefreshFixedMarketPulseAsync(routeKey, ct);

            await Task.WhenAll(hotTask, statsTask, snapshotTask);

            if (_hotMatch is not null)
            {
                await LogAsync(
                    "[HOT_MATCH] refreshed",
                    new
                    {
                        _hotMatch.MatchId,
                        _hotMatch.HotScore
                    });
            }

            await InvokeAsync(StateHasChanged);

            Logger.LogInformation(
                "[TV_MATCH_LOAD] SecondaryData loaded matchId={MatchId} hasHotMatch={HasHotMatch} elapsedMs={ElapsedMs}",
                MatchId,
                _hotMatch is not null,
                sw.ElapsedMilliseconds);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "[TV_MATCH_LOAD] SecondaryData failed. MatchId={MatchId}",
                MatchId);
        }
        finally
        {
            Interlocked.Exchange(ref _secondaryRefreshInProgress, 0);
        }
    }

    private async Task RefreshFixedHotMatchAsync(string routeKey, CancellationToken ct)
    {
        try
        {
            var hotMatches = await LoadWithTimeoutAsync(
                token => HotMatches.GetHotMatchesAsync(token),
                ct,
                SecondaryFeedTimeout);
            if (!IsCurrentRoute(routeKey))
                return;

            ApplyHotMatches(hotMatches);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[TV_MATCH_LOAD] Fixed hot-match refresh failed. MatchId={MatchId}", MatchId);
        }
    }

    private async Task RefreshFixedStatsPanelsAsync(string routeKey, CancellationToken ct)
    {
        try
        {
            Logger.LogDebug("[TV] Arena ranking and feed refresh started. MatchId={MatchId}", MatchId);
            var stats = await LoadWithTimeoutAsync(
                token => Api.GetStatsOverviewAsync(token),
                ct,
                SecondaryFeedTimeout);
            if (!IsCurrentRoute(routeKey))
                return;

            _stats = stats;
            _topCoinsError = null;
            _latestBattlesError = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            if (IsCurrentRoute(routeKey))
            {
                _topCoinsError ??= LocalizedTvMatchText("error");
                _latestBattlesError ??= LocalizedTvMatchText("error");
            }
        }
        catch (Exception ex)
        {
            if (IsCurrentRoute(routeKey))
            {
                _topCoinsError ??= LocalizedTvMatchText("error");
                _latestBattlesError ??= LocalizedTvMatchText("error");
            }
            Logger.LogWarning(ex, "[TV_MATCH_LOAD] Fixed ranking/feed refresh failed. MatchId={MatchId}", MatchId);
        }
        finally
        {
            if (IsCurrentRoute(routeKey))
            {
                _topCoinsLoading = false;
                _latestBattlesLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RefreshFixedMarketPulseAsync(string routeKey, CancellationToken ct)
    {
        try
        {
            Logger.LogDebug("[TV] Market pulse refresh started. MatchId={MatchId}", MatchId);
            var snapshot = await LoadWithTimeoutAsync(
                token => Api.GetDashboardSnapshotAsync(token),
                ct,
                SecondaryFeedTimeout);
            if (!IsCurrentRoute(routeKey))
                return;

            _snapshot = snapshot;
            _marketPulseError = null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            if (IsCurrentRoute(routeKey))
                _marketPulseError ??= LocalizedTvMatchText("error");
        }
        catch (Exception ex)
        {
            if (IsCurrentRoute(routeKey))
                _marketPulseError ??= LocalizedTvMatchText("error");
            Logger.LogWarning(ex, "[TV_MATCH_LOAD] Fixed market-pulse refresh failed. MatchId={MatchId}", MatchId);
        }
        finally
        {
            if (IsCurrentRoute(routeKey))
            {
                _marketPulseLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentRoute(string routeKey)
        => !_isDisposed && string.Equals(routeKey, _activeRouteKey, StringComparison.Ordinal);

    private static async Task<T> LoadWithTimeoutAsync<T>(
        Func<CancellationToken, Task<T>> loader,
        CancellationToken ct,
        TimeSpan timeout)
    {
        using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(ct);
        timeoutCts.CancelAfter(timeout);
        return await loader(timeoutCts.Token);
    }

    private async Task<T> MeasureLoadCallAsync<T>(string name, Func<Task<T>?> action)
    {
        var sw = Stopwatch.StartNew();

        try
        {
            var task = action() ?? throw new InvalidOperationException($"TV match load call returned null task: {name}");
            var result = await task;

            Logger.LogInformation(
                "[TV_MATCH_LOAD] {Call} elapsedMs={ElapsedMs}",
                name,
                sw.ElapsedMilliseconds);

            return result;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(
                ex,
                "[TV_MATCH_LOAD] {Call} failed elapsedMs={ElapsedMs}",
                name,
                sw.ElapsedMilliseconds);

            throw;
        }
    }

    private async Task RetryLoadAsync()
    {
        _interactiveLoadRetryAttempted = true;
        _secondaryDataLoadStarted = false;
        await RefreshAsync(CancellationToken.None);
    }

    private string BuildAbsolute(string path)
        => SeoDefaults.BuildPublicAbsoluteUrl(Config, path);

    private async Task LogAsync(string message, object? payload = null)
    {
        if (_tvModule is null)
            return;

        try
        {
            await _tvModule.InvokeVoidAsync("log", "TV_MODE", message, payload);
        }
        catch
        {
        }
    }

    private void ApplyHotMatches(IReadOnlyList<HotMatchDto> hotMatches)
    {
        var currentHotMatch = hotMatches.FirstOrDefault(x => x.MatchId == MatchId);
        _hotMatch = currentHotMatch is not null
            ? HotMatches.ToTvHotMatch(currentHotMatch, _culture, RouteLocalization)
            : _hotMatch;
        _nextAvailableMatch = TvProceduralCyclePolicy.FindNextMatch(hotMatches, MatchId);
    }

    private string ResolveHotMatchSlug(HotMatchDto match)
        => !string.IsNullOrWhiteSpace(match.Slug)
            ? match.Slug
            : MatchSlugHelper.BuildSlug(match.HomeSymbol, match.AwaySymbol);

    private string LocalizedTvMatchText(string key)
        => L.T($"tv.matchPage.{key}", _culture);

    private static bool IsUnavailableForTv(MatchDto match)
        => match.EndTime is not null
           || TvProceduralCyclePolicy.IsTerminal(match.IsFinished, match.Status);

    private enum TvMatchPageLoadState
    {
        Loading,
        Loaded,
        NotFound,
        Unavailable,
        Error
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;

        CancelRouteLoad();

        if (_refreshCts is not null)
        {
            try
            {
                _refreshCts.Cancel();
            }
            catch
            {
            }

            _refreshCts.Dispose();
        }

        if (_refreshLoopTask is not null)
        {
            try
            {
                await _refreshLoopTask;
            }
            catch
            {
            }
        }

        Logger.LogInformation(
            "TvMatchPage refresh loop disposed. MatchId={MatchId}",
            MatchId);

        if (_tvModule is not null)
        {
            try
            {
                await _tvModule.DisposeAsync();
            }
            catch
            {
            }
        }
    }

    private static bool PathsEquivalent(string left, string right)
        => SafeUnescape(left).Equals(SafeUnescape(right), StringComparison.OrdinalIgnoreCase);

    private static string SafeUnescape(string value)
    {
        try
        {
            return Uri.UnescapeDataString(value);
        }
        catch
        {
            return value;
        }
    }
}
