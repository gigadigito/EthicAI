@using CriptoVersus.Components.Pages.Internet
@using Microsoft.Extensions.Options
@using System.Diagnostics
@using CriptoVersus.Web.Services
@using DTOs
@inject IJSRuntime JS
@inject FuturebolMatchAdapter MatchAdapter
@inject IOptions<FuturebolOptions> FuturebolOptionsAccessor
@inject IWebHostEnvironment Environment
@inject LocalizationService L
@inject ILogger<TvFuturebolField> Logger
@implements IAsyncDisposable

<div class="tv-futurebol-field"
     data-futurebol-match-id="@(_presentation?.MatchId)"
     data-futurebol-state="@FuturebolState"
     aria-busy="@IsLoading"
     style="position:relative;width:100%;height:100%;min-width:0;min-height:0;overflow:hidden;">
    <canvas id="@_canvasId"
            class="tv-futurebol-field__canvas"
            aria-label="@T("canvasAriaLabel")"
            style="position:absolute;inset:0;width:100%;height:100%;display:block;touch-action:none;outline:none;"></canvas>
    @if (!_isReady && string.IsNullOrWhiteSpace(_error))
    {
        <div class="tv-futurebol-field__loading"
             role="status"
             aria-live="polite">
            <span class="tv-futurebol-field__loading-spinner" aria-hidden="true"></span>
            <strong>FUTUREBOL 3D</strong>
            <span class="tv-futurebol-field__loading-copy">
                <small class="tv-futurebol-field__loading-message tv-futurebol-field__loading-message--initial">@T("loading")</small>
                <small class="tv-futurebol-field__loading-message tv-futurebol-field__loading-message--slow">@T("loadingSlow")</small>
            </span>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="tv-futurebol-field__fallback" role="status">
            <strong>@T("error")</strong>
            <span>@T("errorBody")</span>
        </div>
    }
</div>

@code {
    private static int _nextCanvasId;
    private readonly string _canvasId = $"tv-futurebol-canvas-{Interlocked.Increment(ref _nextCanvasId)}";
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private IJSObjectReference? _module;
    private DotNetObjectReference<TvFuturebolField>? _dotNetReference;
    private FuturebolMatchPresentationModel? _presentation;
    private string _pendingSignature = string.Empty;
    private string _appliedSignature = string.Empty;
    private bool _initialized;
    private bool _isReady;
    private bool _disposed;
    private int _loggedMatchId;
    private string? _error;

    [Parameter, EditorRequired] public MatchDto? Match { get; set; }
    [Parameter] public string? Culture { get; set; }
    [Parameter] public TvHotMatchDto? HotMatch { get; set; }
    [Parameter] public IReadOnlyCollection<MatchMetricSnapshotDto> Snapshots { get; set; } = [];
    [Parameter] public IReadOnlyCollection<MatchScoreEventDto> ScoreEvents { get; set; } = [];
    [Parameter] public bool InitialHistoryReady { get; set; }
    [Parameter] public string? HomeLogoUrl { get; set; }
    [Parameter] public string? AwayLogoUrl { get; set; }
    [Parameter] public EventCallback<FuturebolReplayHudState> ReplayStateChanged { get; set; }

    private string FuturebolState => !string.IsNullOrWhiteSpace(_error)
        ? "error"
        : _isReady ? "ready" : "loading";
    private bool IsLoading => FuturebolState == "loading";

    protected override void OnInitialized()
    {
        Logger.LogInformation("[TvFuturebolField] component initialized");
    }

    protected override void OnParametersSet()
    {
        var match = Match ?? BuildMatchFromHotMatch(HotMatch);
        if (match is null)
            return;

        if (_loggedMatchId != match.MatchId)
        {
            _loggedMatchId = match.MatchId;
            Logger.LogInformation("[TvFuturebolField] matchId={MatchId}", match.MatchId);
        }

        _presentation = MatchAdapter.Build(match, HotMatch, Snapshots, ScoreEvents, initialHistoryReady: InitialHistoryReady);
        Logger.LogInformation("[Futurebol][Bootstrap][Blazor] matchId={MatchId} historyReady={HistoryReady} score={ScoreA}x{ScoreB} scoreEvents={ScoreEvents}",
            match.MatchId, InitialHistoryReady, match.ScoreA, match.ScoreB, ScoreEvents.Count);
        if (!string.IsNullOrWhiteSpace(HomeLogoUrl))
            _presentation = _presentation with
            {
                HomeTeam = _presentation.HomeTeam with
                {
                    LogoUrl = FuturebolTeamLogoUrl.Resolve(HomeLogoUrl, _presentation.HomeTeam.Symbol)
                }
            };
        if (!string.IsNullOrWhiteSpace(AwayLogoUrl))
            _presentation = _presentation with
            {
                AwayTeam = _presentation.AwayTeam with
                {
                    LogoUrl = FuturebolTeamLogoUrl.Resolve(AwayLogoUrl, _presentation.AwayTeam.Symbol)
                }
            };
        _pendingSignature = BuildSignature(_presentation);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Logger.LogInformation(
                "[TvFuturebolField] OnAfterRender firstRender={FirstRender} matchId={MatchId} canvasId={CanvasId}",
                firstRender,
                _presentation?.MatchId ?? 0,
                _canvasId);
        }

        if (_disposed || _presentation is null || _pendingSignature == _appliedSignature)
            return;

        await _interopGate.WaitAsync();
        try
        {
            if (_disposed || _presentation is null || _pendingSignature == _appliedSignature)
                return;

            if (_module is null)
            {
                var importTimer = Stopwatch.StartNew();
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "/js/dist/futurebol/futurebol-bootstrap.js?v=20260820-replay-live-goal-opening-1");
                await _module.InvokeVoidAsync("reportBootstrapImport", importTimer.Elapsed.TotalMilliseconds);
            }
            _dotNetReference ??= DotNetObjectReference.Create(this);
            var presentation = _presentation;
            var signature = _pendingSignature;

        if (!_initialized)
        {
            Logger.LogInformation(
                "[Futurebol][Bootstrap][Blazor] initialize matchId={MatchId} historyReady={HistoryReady} scoreEvents={ScoreEvents}",
                presentation.MatchId, presentation.Official.IsInitialHistoryReady, presentation.Official.ScoreEvents.Count);
            _initialized = await _module.InvokeAsync<bool>(
                    "initialize",
                    _canvasId,
                    new
                    {
                        dataMode = "api",
                        homeSymbol = presentation.HomeTeam.Symbol,
                        awaySymbol = presentation.AwayTeam.Symbol,
                        homeLogoUrl = presentation.HomeTeam.LogoUrl,
                        awayLogoUrl = presentation.AwayTeam.LogoUrl,
                        matchId = presentation.MatchId,
                        initialMarketSnapshot = presentation.Market,
                        initialOfficialState = presentation.Official,
                        initialPresentationState = presentation,
                        dataError = (string?)null,
                        seed = $"futurebol-match-{presentation.MatchId}",
                        quality = ResolveTvQuality(),
                        development = Environment.IsDevelopment(),
                        simulateWebGlFailure = false,
                        simulatePlayerAssetFailure = false,
                        playerVisual = "Auto",
                        presentationMode = "tv",
                        hudRootId = (string?)null
                    },
                    _dotNetReference);
                if (!_initialized)
                {
                    _appliedSignature = signature;
                    return;
                }
                Logger.LogInformation(
                    "Futurebol TV initialized. MatchId={MatchId} Quality={Quality}",
                    presentation.MatchId,
                    ResolveTvQuality());
                _isReady = true;
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                Logger.LogInformation(
                    "[Futurebol][Bootstrap][Blazor] update matchId={MatchId} historyReady={HistoryReady} scoreEvents={ScoreEvents}",
                    presentation.MatchId, presentation.Official.IsInitialHistoryReady, presentation.Official.ScoreEvents.Count);
                await _module.InvokeVoidAsync("updatePresentation", _canvasId, presentation);
            }

            _error = null;
            _appliedSignature = signature;
        }
        catch (JSDisconnectedException)
        {
        }
        catch (Exception ex)
        {
            _error = T("errorBody");
            _isReady = false;
            Logger.LogWarning(ex, "Futurebol TV lifecycle failure. MatchId={MatchId}", _presentation?.MatchId);
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _interopGate.Release();
        }
    }

    [JSInvokable]
    public Task ReportFuturebolError(string message)
    {
        _error = T("errorBody");
        _initialized = false;
        _isReady = false;
        Logger.LogWarning("Futurebol TV reported an initialization failure. Detail={Detail}", message);
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ReportFuturebolReplayState(
        bool active,
        int homeScore,
        int awayScore,
        int targetHomeScore,
        int targetAwayScore)
    {
        if (_presentation is null || !ReplayStateChanged.HasDelegate)
            return Task.CompletedTask;

        var state = new FuturebolReplayHudState(
            _presentation.MatchId,
            active,
            Math.Max(0, homeScore),
            Math.Max(0, awayScore),
            Math.Max(0, targetHomeScore),
            Math.Max(0, targetAwayScore));
        return InvokeAsync(() => ReplayStateChanged.InvokeAsync(state));
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;
        _disposed = true;
        await _interopGate.WaitAsync();
        try
        {
            if (_module is not null)
            {
                try
                {
                    await _module.InvokeVoidAsync("dispose", _canvasId);
                    Logger.LogInformation("[FUTUREBOL-TV] dispose canvasId={CanvasId}", _canvasId);
                }
                catch (JSDisconnectedException)
                {
                }
                try
                {
                    await _module.DisposeAsync();
                }
                catch (JSDisconnectedException)
                {
                }
            }
            _dotNetReference?.Dispose();
        }
        finally
        {
            _interopGate.Release();
            _interopGate.Dispose();
        }
    }

    private string ResolveTvQuality()
        => FuturebolOptionsAccessor.Value.TvQuality is "Low" or "Medium" or "High"
            ? FuturebolOptionsAccessor.Value.TvQuality
            : "Auto";

    private string T(string key)
        => L.T($"tv.futurebol.{key}", Culture);

    private static string BuildSignature(FuturebolMatchPresentationModel state)
        => string.Join('|',
            state.MatchId,
            state.HomeTeam.TeamId,
            state.HomeTeam.Symbol,
            state.HomeTeam.Name,
            state.HomeTeam.LogoUrl,
            state.AwayTeam.TeamId,
            state.AwayTeam.Symbol,
            state.AwayTeam.Name,
            state.AwayTeam.LogoUrl,
            state.Official.Sequence,
            state.Official.HomeScore,
            state.Official.AwayScore,
            state.Official.Status,
            state.Official.IsFinished,
            state.Official.IsInitialHistoryReady,
            state.Market.Sequence,
            state.Result.WinnerTeamId,
            state.Result.WinnerTeamSymbol,
            state.Result.EndReasonCode,
            state.Result.EndReasonDetail,
            state.Clock.StartTimeUtc,
            state.Clock.EndTimeUtc,
            state.Clock.ElapsedSeconds,
            state.Clock.RemainingSeconds,
            state.Official.ScoreEvents.Count);

    private static MatchDto? BuildMatchFromHotMatch(TvHotMatchDto? hotMatch)
    {
        if (hotMatch is not { HasMatch: true, MatchId: > 0 })
            return null;

        return new MatchDto
        {
            MatchId = hotMatch.MatchId,
            TeamA = hotMatch.LeftSymbol,
            TeamB = hotMatch.RightSymbol,
            ScoreA = hotMatch.LeftScore,
            ScoreB = hotMatch.RightScore,
            Status = hotMatch.RemainingSeconds > 0 ? "Ongoing" : "Scheduled",
            StartTime = hotMatch.MatchStartTimeUtc,
            RemainingMinutes = Math.Max(0, (hotMatch.RemainingSeconds ?? 0) / 60),
            PctA = hotMatch.LeftChangePercent,
            PctB = hotMatch.RightChangePercent
        };
    }
}
