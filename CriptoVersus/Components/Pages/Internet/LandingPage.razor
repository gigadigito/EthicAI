    [Parameter] public string? Culture { get; set; }

    private string CurrentCulture => AppCulture.NormalizeRouteCulture(Culture
        ?? AppCulture.ResolveNavigationCulture(Nav, HttpContextAccessor.HttpContext));

    private HeroCopy CurrentCopy =>
        L.GetSection<HeroCopy>("landing", CurrentCulture)
        ?? LegacyCopy[AppCultureService.DefaultRouteCulture];

    private IReadOnlyList<VisualState> CurrentStates => CurrentCopy.States;

    private VisualState ActiveState =>
        CurrentStates[Math.Clamp(_selectedVisualState, 0, CurrentStates.Count - 1)];

    private string HomeHref => RouteLocalization.BuildHomePath(CurrentCulture);

    private string AboutHref => RouteLocalization.BuildAboutPath(CurrentCulture);

    private string CanonicalUrl => SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildLandingPath(CurrentCulture));

    private string EnglishUrl => SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildLandingPath(AppCultureService.DefaultRouteCulture));

    private string SocialImageUrl => SeoDefaults.BuildPublicAbsoluteUrl(Config, SeoDefaults.DefaultSocialImagePath);

   
