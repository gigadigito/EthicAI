@page "/landing"
@page "/{culture}/landing"
@layout CriptoVersus.Web.Components.Layout.BlankLayout
@using CriptoVersus.Web.Components.Shared
@using CriptoVersus.Web.Services
@using Microsoft.JSInterop
@inject IHttpContextAccessor HttpContextAccessor
@inject AppCultureService AppCulture
@inject NavigationManager Nav
@inject RouteLocalizationService RouteLocalization
@inject LocalizationService L
@inject IConfiguration Config
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@CurrentCopy.PageTitle</PageTitle>
<HeadContent>
    <meta name="description" content="@CurrentCopy.Subtitle" />
    <link rel="canonical" href="@CanonicalUrl" />
    <link rel="alternate" hreflang="x-default" href="@EnglishUrl" />
    <meta property="og:title" content="@CurrentCopy.PageTitle" />
    <meta property="og:description" content="@CurrentCopy.Subtitle" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@SocialImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@CurrentCopy.PageTitle" />
    <meta name="twitter:description" content="@CurrentCopy.Subtitle" />
    <meta name="twitter:image" content="@SocialImageUrl" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;600;700&family=Manrope:wght@400;500;600;700&display=swap" />
</HeadContent>

<LocalizedSeoAlternates />

<main @ref="_pageRef" class="landing-page">
    <section class="landing-hero" aria-labelledby="landing-hero-title">
        <div class="landing-hero__canvas" aria-hidden="true">
            <GatewayFlow />
        </div>

        <header class="landing-hero__navbar">
            <a class="landing-hero__brand" href="@HomeHref" aria-label="CriptoVersus">
