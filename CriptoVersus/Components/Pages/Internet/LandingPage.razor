                <span class="landing-hero__brand-name">CriptoVersus</span>
            </a>

            <nav class="landing-hero__nav" aria-label="@CurrentCopy.NavLabel">
                <a class="landing-hero__nav-link" href="@HomeHref">@CurrentCopy.NavHome</a>
                <a class="landing-hero__nav-btn" href="@AboutHref">@CurrentCopy.NavAbout</a>
            </nav>
        </header>

        <h1 id="landing-hero-title" class="landing-hero__title">
            <span class="landing-hero__title-line">@CurrentCopy.TitleLine1</span>
            <span class="landing-hero__title-line">@CurrentCopy.TitleLine2</span>
        </h1>

        <div class="landing-hero__sub">
            <p class="landing-hero__subtitle">@CurrentCopy.Subtitle</p>
            <div class="landing-hero__actions">
                <a class="landing-hero__cta" href="@HomeHref" onclick="CvAnalytics.trackLandingExploreClick('@CurrentCulture')">
                    <span>@CurrentCopy.Cta</span>
                    <svg class="landing-hero__cta-icon"
                         viewBox="0 0 20 20"
                         width="18"
                         height="18"
                         fill="none"
                         aria-hidden="true">
                        <path d="M4.5 10h11m0 0-4.5-4.5M15.5 10l-4.5 4.5"
                              stroke="currentColor"
                              stroke-width="1.75"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <section class="landing-translation" aria-labelledby="landing-translation-title">
        <div class="landing-translation__inner">
            <div class="landing-translation__copy">
                <h2 id="landing-translation-title" class="landing-translation__title">
                    @CurrentCopy.SectionTitle
                </h2>
                <p class="landing-translation__lead">
                    @CurrentCopy.SectionLead
                </p>

                <dl class="landing-translation__pillars">
                    <div class="landing-translation__pillar">
                        <dt>@CurrentCopy.Pillar1Title</dt>
                        <dd>@CurrentCopy.Pillar1Body</dd>
                    </div>
                    <div class="landing-translation__pillar">
                        <dt>@CurrentCopy.Pillar2Title</dt>
                        <dd>@CurrentCopy.Pillar2Body</dd>
                    </div>
                    <div class="landing-translation__pillar">
                        <dt>@CurrentCopy.Pillar3Title</dt>
                        <dd>@CurrentCopy.Pillar3Body</dd>
                    </div>
                </dl>
            </div>

            <div class="landing-translation__stage">
                <div class="landing-translation__raw" aria-hidden="true">
                    <span class="landing-translation__raw-label">@CurrentCopy.RawLabel</span>
                    <code class="landing-translation__raw-line">BTC/ETH · RSI(14) 58.4 · EMA 9/21 · VOL 24H · SPREAD 0.04</code>
                </div>

                <div class="landing-translation__visual">
                    <div class="landing-translation__visual-head">
                        <span class="landing-translation__visual-label">@CurrentCopy.VisualLabel</span>
                        <div class="landing-translation__states"
                             role="group"
                             aria-label="@CurrentCopy.StatesGroupLabel">
                            @for (var i = 0; i < CurrentStates.Count; i++)
                            {
                                var index = i;
                                var state = CurrentStates[i];
                                <button type="button"
                                        class="landing-translation__state-btn @(_selectedVisualState == index ? "is-active" : null)"
                                        aria-pressed="@(_selectedVisualState == index ? "true" : "false")"
                                        @onclick="() => SelectVisualState(index)">
                                    @state.Label
                                </button>
                            }
                        </div>
                    </div>

                    <div class="landing-translation__duel">
                        <div class="landing-translation__side landing-translation__side--left">
                            <span class="landing-translation__asset-name">Bitcoin</span>
                            <span class="landing-translation__asset-share">@ActiveState.LeftShare%</span>
                        </div>
                        <div class="landing-translation__side landing-translation__side--right">
                            <span class="landing-translation__asset-share">@ActiveState.RightShare%</span>
                            <span class="landing-translation__asset-name">Ethereum</span>
                        </div>
                    </div>

                    <div class="landing-translation__meter" aria-hidden="true">
                        <span class="landing-translation__meter-left"
                              style="width: @ActiveState.LeftShare%"></span>
                        <span class="landing-translation__meter-right"
                              style="width: @ActiveState.RightShare%"></span>
                    </div>

                    <p class="landing-translation__reading" aria-live="polite">
                        @ActiveState.Reading
                    </p>
                </div>

                <p class="landing-translation__footnote">
                    @CurrentCopy.VisualFootnote
                </p>
            </div>
        </div>
    </section>
</main>

@code {
    private sealed record VisualState(string Label, int LeftShare, int RightShare, string Reading);

    private sealed record HeroCopy(
        string PageTitle,
        string NavLabel,
        string NavHome,
        string NavAbout,
        string TitleLine1,
        string TitleLine2,
        string Subtitle,
        string Cta,
        string SectionTitle,
        string SectionLead,
        string Pillar1Title,
        string Pillar1Body,
        string Pillar2Title,
        string Pillar2Body,
        string Pillar3Title,
        string Pillar3Body,
        string RawLabel,
        string VisualLabel,
        string StatesGroupLabel,
        string VisualFootnote,
        IReadOnlyList<VisualState> States);

    private int _selectedVisualState = 1;
    private ElementReference _pageRef;
    private IJSObjectReference? _scrollModule;
    private bool _scrollMounted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _scrollModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "/js/dist/landing/landingScroll.js?v=20261115");
            await _scrollModule.InvokeVoidAsync("mountLandingScroll", _pageRef);
            _scrollMounted = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollModule is not null)
        {
            try
            {
                if (_scrollMounted)
                {
                    await _scrollModule.InvokeVoidAsync("destroyLandingScroll", _pageRef);
                }
            }
            catch (JSDisconnectedException)
            {
            }
            finally
            {
                await _scrollModule.DisposeAsync();
                _scrollModule = null;
            }
        }
    }

    private void SelectVisualState(int index)
    {
        if (index >= 0 && index < CurrentStates.Count)
        {
            _selectedVisualState = index;
        }
    }

