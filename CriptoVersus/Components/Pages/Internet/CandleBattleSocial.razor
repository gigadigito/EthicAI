@layout BlankLayout
@page "/social/candle-battle/{MatchId:int}"
@page "/en/social/candle-battle/{MatchId:int}"
@page "/pt/social/candle-battle/{MatchId:int}"
@page "/zh/social/candle-battle/{MatchId:int}"
@page "/es/social/candle-battle/{MatchId:int}"
@page "/fr/social/candle-battle/{MatchId:int}"
@page "/de/social/candle-battle/{MatchId:int}"
@page "/it/social/candle-battle/{MatchId:int}"
@page "/ja/social/candle-battle/{MatchId:int}"
@rendermode InteractiveServer
@using System.Globalization
@using DTOs
@using CriptoVersus.Web.Services
@inject CriptoVersusApiClient Api
@inject AppCultureService AppCulture
@inject LocalizationService L
@inject RouteLocalizationService Routes
@inject IConfiguration Config
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<CandleBattleSocial> Logger
@implements IAsyncDisposable

<PageTitle>@Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <link rel="canonical" href="@Canonical" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@Title" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Canonical" />
    <meta property="og:locale" content="@AppCulture.ToOgLocale(Culture)" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@Title" />
    <meta name="twitter:description" content="@Description" />
</HeadContent>

<main id="candle-battle-social-card" class="candle-social" data-social-ready="false"
      data-replay-available="@(_battle?.ReplayAvailable == true ? "true" : "false")"
      data-match-status="@(_battle?.Status ?? "unknown")">
    @if (_battle is null)
    {
        <div class="candle-social__state" role="status">@(_error ?? T("loading"))</div>
    }
    else
    {
        <header class="candle-social__header">
            <div class="candle-social__brand">Cripto<span>Versus</span><small>@T("title")</small></div>
            <div class="candle-social__heading">
                <h1>@Pair(_battle.AssetA) <span>VS</span> @Pair(_battle.AssetB)</h1>
                <p>@(_battle.StartTimeUtc?.ToString("dd MMM yyyy · HH:mm", CultureInfo.GetCultureInfo(CultureCode)) ?? "—") UTC</p>
            </div>
            <strong class="candle-social__status">@T(_battle.Status == "Completed" ? "completed" : "ongoing")</strong>
        </header>

        <section class="candle-social__result" aria-label="@T(IsFinal ? "result" : "currentScore")">
            @Asset(_battle.AssetA, "left")
            <div class="candle-social__score">
                <small>@T(IsFinal ? "result" : "currentScore")</small>
                <strong>@_battle.ScoreA <span>:</span> @_battle.ScoreB</strong>
                @if (IsFinal)
                {
                    <p>@(_battle.WinnerSymbol is null ? T("finalDraw") : $"{T("winner")}: {_battle.WinnerSymbol}")</p>
                    @if (LoserSymbol is not null) { <p>@T("loser"): @LoserSymbol</p> }
                }
                else
                {
                    <p>@(CurrentLeaderSymbol is null ? T("currentDraw") : $"{T("currentLeader")}: {CurrentLeaderSymbol}")</p>
                }
            </div>
            @Asset(_battle.AssetB, "right")
        </section>

        @if (_battle.ReplayAvailable)
        {
            <section class="candle-social__arena" aria-label="@T("replay")">
                <h2>@T("replay")</h2>
                <CandleBattlesHost @key="MatchId" MatchId="MatchId" Culture="@Culture" OnFailure="OnReplayFailureAsync" />
                @if (_replayFailure is not null)
                {
                    <section class="candle-social__empty" role="status">@T("replayError")</section>
                }
            </section>
        }
        else
        {
            <section class="candle-social__empty" role="status">@T("noReplay")</section>
        }

        <section class="candle-social__details">
            <div class="candle-social__metrics">
                <div><span>@T(IsFinal ? "duration" : "elapsed")</span><strong>@(_battle.DurationMinutes?.ToString(CultureInfo.GetCultureInfo(CultureCode)) ?? "—") @T("minutes")</strong></div>
                <div><span>@T("rounds")</span><strong>@T("roundsCompleted", _battle.ConfrontationCount, _battle.ExpectedConfrontations)</strong></div>
                <div><span>@T("green") / @T("red") · @Base(_battle.AssetA.Symbol)</span><strong>@_battle.AssetA.GreenCandles / @_battle.AssetA.RedCandles</strong></div>
                <div><span>@T("green") / @T("red") · @Base(_battle.AssetB.Symbol)</span><strong>@_battle.AssetB.GreenCandles / @_battle.AssetB.RedCandles</strong></div>
            </div>
            @if (_battle.Rounds.Count > 1 && _battle.ReplayAvailable)
            {
                <figure class="candle-social__chart">
                    <figcaption>@T("chart")</figcaption>
                    <svg viewBox="0 0 1000 220" preserveAspectRatio="none" role="img" aria-label="@T("chart")">
                        <path d="M0 55H1000 M0 110H1000 M0 165H1000" class="candle-social__grid" />
                        <polyline points="@ChartPoints(true)" class="candle-social__line candle-social__line--left" />
                        <polyline points="@ChartPoints(false)" class="candle-social__line candle-social__line--right" />
                    </svg>
                    <div class="candle-social__legend"><span>@Pair(_battle.AssetA)</span><span>@Pair(_battle.AssetB)</span></div>
                </figure>
            }
        </section>
        <footer class="candle-social__footer"><strong>CriptoVersus</strong><span>@T("disclaimer")</span></footer>
    }
</main>

@code {
    [Parameter] public int MatchId { get; set; }
    private CandleBattleSocialResponse? _battle;
    private string? _error;
    private CancellationTokenSource _lifetime = new();
    private IJSObjectReference? _module;
    private string? _replayFailure;
    private int _watchedMatchId;
    private string Culture => AppCulture.NormalizeRouteCulture(Nav.ToBaseRelativePath(Nav.Uri).Split('/')[0]);
    private string CultureCode => Culture switch { "pt" => "pt-BR", "zh" => "zh-CN", "en" => "en-US", "es" => "es-ES", "fr" => "fr-FR", "de" => "de-DE", "it" => "it-IT", "ja" => "ja-JP", _ => "en-US" };
    private string T(string key, params object?[] args) => L.T($"social.candleBattle.{key}", Culture, args);
    private string Title => _battle is null ? $"{T("title")} | CriptoVersus" :
        $"{T("title")}: {Pair(_battle.AssetA)} vs {Pair(_battle.AssetB)} | CriptoVersus";
    private string Description => _battle is null ? T("descriptionGeneric") :
        T("description", Base(_battle.AssetA.Symbol), Base(_battle.AssetB.Symbol));
    private string? LoserSymbol => _battle?.WinnerSymbol is null ? null
        : string.Equals(_battle.WinnerSymbol, _battle.AssetA.Symbol, StringComparison.OrdinalIgnoreCase)
            ? _battle.AssetB.Symbol : _battle.AssetA.Symbol;
    private bool IsFinal => _battle?.Status == "Completed";
    private string? CurrentLeaderSymbol => _battle is null || _battle.ScoreA == _battle.ScoreB ? null
        : _battle.ScoreA > _battle.ScoreB ? _battle.AssetA.Symbol : _battle.AssetB.Symbol;
    private string Canonical => SeoDefaults.BuildPublicAbsoluteUrl(Config, Routes.BuildCandleBattleSocialPath(Culture, MatchId));
    private static string Base(string symbol) => symbol.EndsWith("USDT", StringComparison.OrdinalIgnoreCase) ? symbol[..^4] : symbol;
    private static string Pair(CandleBattleSocialAssetDto asset) => asset.Pair;
    private string Performance(CandleBattleSocialAssetDto asset) => asset.PerformancePercent is decimal value
        ? $"{value:+0.##;-0.##;0}%" : "—";
    private RenderFragment Asset(CandleBattleSocialAssetDto asset, string side) => @<article class="candle-social__asset candle-social__asset--@side">
        <div class="candle-social__asset-head"><img src="@asset.LogoUrl" alt="" onerror="this.hidden=true;this.nextElementSibling.hidden=false" /><span hidden>@Base(asset.Symbol)</span></div>
        <h2>@Pair(asset)</h2><strong>@Performance(asset)</strong>
        <small>@T("opening"): @(asset.OpeningPrice?.ToString("G", CultureInfo.GetCultureInfo(CultureCode)) ?? "—") · @T("closing"): @(asset.ClosingPrice?.ToString("G", CultureInfo.GetCultureInfo(CultureCode)) ?? "—")</small>
    </article>;

    protected override async Task OnParametersSetAsync()
    {
        _battle = null; _error = null; _replayFailure = null;
        try { _battle = await Api.GetCandleBattleSocialAsync(MatchId, CultureCode, true, _lifetime.Token);
            if (_battle is null) _error = T("notFound"); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning(ex, "Candle Battle social load failed. MatchId={MatchId}", MatchId); _error = T("error"); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_battle is null || _watchedMatchId == MatchId) return;
        try { _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/candleBattleSocial.mjs?v=20261021a");
            await _module.InvokeVoidAsync("watchReadiness", "candle-battle-social-card", _battle.ReplayAvailable,
                _battle.Status == "Completed");
            _watchedMatchId = MatchId; }
        catch (JSDisconnectedException) { }
        catch (Exception ex) { Logger.LogError(ex, "Candle Battle social readiness failed. MatchId={MatchId}", MatchId); }
    }

    private async Task OnReplayFailureAsync(string reason)
    {
        _replayFailure = reason;
        Logger.LogWarning("Candle Battle social replay failed. MatchId={MatchId}, Reason={Reason}", MatchId, reason);
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("reportFailure", "candle-battle-social-card", reason); }
            catch (JSDisconnectedException) { }
        }
        await InvokeAsync(StateHasChanged);
    }

    private string ChartPoints(bool left)
    {
        if (_battle is null || _battle.Rounds.Count < 2) return string.Empty;
        var rounds = _battle.Rounds;
        var leftFirst = rounds[0].Left.Open; var rightFirst = rounds[0].Right.Open;
        if (leftFirst <= 0m || rightFirst <= 0m) return string.Empty;
        var leftValues = rounds.Select(x => x.Left.Close / leftFirst * 100m).ToArray();
        var rightValues = rounds.Select(x => x.Right.Close / rightFirst * 100m).ToArray();
        var values = left ? leftValues : rightValues;
        var min = leftValues.Concat(rightValues).Min(); var max = leftValues.Concat(rightValues).Max();
        var span = max - min; if (span == 0m) span = 1m;
        return string.Join(" ", values.Select((value, i) =>
            $"{(i * 1000d / (values.Length - 1)).ToString("F2", CultureInfo.InvariantCulture)},{(200m - (value - min) / span * 180m).ToString("F2", CultureInfo.InvariantCulture)}"));
    }

    public async ValueTask DisposeAsync()
    {
        _lifetime.Cancel(); _lifetime.Dispose();
        if (_module is not null) { try { await _module.InvokeVoidAsync("disposeReadiness", "candle-battle-social-card"); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
