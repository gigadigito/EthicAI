@rendermode InteractiveServer
@implements IDisposable
@page "/tokenomics"
@page "/en/how-it-works"
@page "/pt/como-funciona"
@page "/zh/how-it-works"
@page "/es/how-it-works"
@page "/fr/how-it-works"
@page "/de/how-it-works"
@page "/it/how-it-works"
@page "/ja/how-it-works"
@page "/hi/how-it-works"
@using DTOs
@using CriptoVersus.Web.Services
@inject CriptoVersus.Web.Services.CriptoVersusApiClient Api
@inject IJSRuntime JS
@inject IConfiguration Config
@inject NavigationManager Nav
@inject AppCultureService AppCulture
@inject LocalizationService L
@inject RouteLocalizationService RouteLocalization
@using System.Text.Json

<PageTitle>@T("seo.title")</PageTitle>
<HeadContent>
    <meta name="description" content="@T("seo.description")" />
    <meta name="keywords" content="@MetaKeywords" />
    <link rel="canonical" href="@SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildHowItWorksPath(CurrentCulture))" />
    <link rel="alternate" hreflang="x-default" href="@SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildHowItWorksPath("en"))" />
    <meta property="og:title" content="@T("seo.title")" />
    <meta property="og:description" content="@T("seo.description")" />
    <meta property="og:url" content="@SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildHowItWorksPath(CurrentCulture))" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="@SocialImageUrl" />
    <meta property="og:image:alt" content="@T("seo.title")" />
    <meta property="og:locale" content="@(AppCulture.ToOgLocale(CurrentCulture))" />
    <meta property="og:locale:alternate" content="@(AppCulture.GetAlternateOgLocale(CurrentCulture))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@T("seo.title")" />
    <meta name="twitter:description" content="@T("seo.description")" />
    <meta name="twitter:image" content="@SocialImageUrl" />
    <meta name="twitter:image:alt" content="@T("seo.title")" />
    <script type="application/ld+json">@((MarkupString)StructuredDataMarkup)</script>
</HeadContent>

<section class="tokenomics-page">
    <div class="tokenomics-hero">
        <img @key="HeroBannerUrl"
             class="tokenomics-hero__banner"
             src="@HeroBannerUrl"
             alt="@T("seo.title")"
             loading="eager"
             decoding="async"
             fetchpriority="high"
             @onerror="UseEnglishBannerFallback" />
    </div>

    @if (_loading)
    {
        <p>@T("loading")</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="rule-alert">@_error</div>
    }
    else if (_data is not null)
    {
        <div class="metrics-band">
            <article>
                <span>@T("metrics.activeCapital")</span>
                <strong>@FmtSol(_data.ActiveCapital)</strong>
                <small>@T("metrics.activePositions", _data.ActivePositions)</small>
            </article>
            <article>
                <span>@T("metrics.totalAllocated")</span>
                <strong>@FmtSol(_data.PrincipalAllocated)</strong>
                <small>@T("metrics.indexedUsers", _data.Users)</small>
            </article>
            <article>
                <span>@T("metrics.cyclesInProgress")</span>
                <strong>@_data.OngoingMatches</strong>
                <small>@T("metrics.pending", _data.PendingMatches)</small>
            </article>
            <article>
                <span>@T("metrics.inOpenMatches")</span>
                <strong>@FmtSol(_data.OpenEntryAmount)</strong>
                <small>@T("metrics.openEntries", _data.OpenEntries)</small>
            </article>
        </div>

        <section class="semantic-band">
            <article>
                <span>@T("semantic.openPositions.title")</span>
                <p>@T("semantic.openPositions.body")</p>
            </article>
            <article>
                <span>@T("semantic.cyclicalPools.title")</span>
                <p>@T("semantic.cyclicalPools.body")</p>
            </article>
            <article>
                <span>@T("semantic.rewardRedistribution.title")</span>
                <p>@T("semantic.rewardRedistribution.body")</p>
            </article>
        </section>

        <section class="topic-callout">
            <div>
                <span>@T("topic.label")</span>
                <h3>@T("topic.title")</h3>
                <p>@T("topic.body")</p>
            </div>
            <a class="topic-link" href="@($"{RouteLocalization.BuildHowItWorksPath(CurrentCulture)}#pontuacao")">@T("topic.link")</a>
        </section>

        <div class="rule-grid">
            <section class="rule-panel lead-panel" id="como-funciona">
                <span>01</span>
                <h3>@T("panels.howItWorks.title")</h3>
                <p>@T("panels.howItWorks.body")</p>
                <div class="flow-line">
                    <strong>@T("panels.howItWorks.stepDeposit")</strong>
                    <strong>@T("panels.howItWorks.stepEnter")</strong>
                    <strong>@T("panels.howItWorks.stepSettle")</strong>
                    <strong>@T("panels.howItWorks.stepContinue")</strong>
                </div>
            </section>

            <section class="rule-panel" id="posicoes">
                <span>02</span>
                <h3>@T("panels.positions.title")</h3>
                <p>@T("panels.positions.body")</p>
                <dl>
                    <div><dt>@T("panels.positions.active")</dt><dd>@_data.ActivePositions</dd></div>
                    <div><dt>@T("panels.positions.exitRequested")</dt><dd>@_data.ClosingPositions</dd></div>
                    <div><dt>@T("panels.positions.closed")</dt><dd>@_data.ClosedPositions</dd></div>
                </dl>
            </section>

            <section class="rule-panel" id="pontuacao">
                <span>03</span>
                <h3>@T("panels.scoring.title")</h3>
                <p>@T("panels.scoring.body", _data.PercentPerGoal.ToString("0.##"))</p>
                <dl>
                    <div><dt>@T("panels.scoring.percentPerGoal")</dt><dd>@_data.PercentPerGoal.ToString("0.##")%</dd></div>
                    <div><dt>@T("panels.scoring.capPerTeam")</dt><dd>@_data.MaxGoalsPerTeam</dd></div>
                </dl>
            </section>

            <section class="rule-panel" id="ciclos">
                <span>04</span>
                <h3>@T("panels.cycles.title")</h3>
                <p>@T("panels.cycles.body")</p>
                <dl>
                    <div><dt>@T("panels.cycles.targetDuration")</dt><dd>@_data.MatchDurationMinutes min</dd></div>
                    <div><dt>@T("panels.cycles.autoReentry")</dt><dd>@(_data.AutoReenterEnabled ? T("panels.cycles.enabled") : T("panels.cycles.paused"))</dd></div>
                </dl>
            </section>

            <section class="rule-panel settlement-panel" id="liquidacao">
                <span>05</span>
                <h3>@T("panels.settlement.title")</h3>
                <p>@T("panels.settlement.body")</p>
                <div class="settlement-chart" aria-label="@T("panels.settlement.chartLabel")">
                    <div class="settlement-chart__pie" @ref="_settlementPieRef"></div>
                    <div class="settlement-chart__summary">
                        <article class="settlement-chart__target settlement-chart__target--refund">
                            <small>@T("panels.settlement.loserRefund")</small>
                            <strong>@FmtPct(_data.LoserRefundRate)</strong>
                        </article>
                        <article class="settlement-chart__target settlement-chart__target--winners">
                            <small>@T("panels.settlement.winnersPool")</small>
                            <strong>@FmtPct(_data.WinnerPoolRate)</strong>
                        </article>
                        <article class="settlement-chart__target settlement-chart__target--house">
                            <small>@T("panels.settlement.houseFee")</small>
                            <strong>@FmtPct(_data.HouseFeeRate)</strong>
                        </article>
                    </div>
                </div>
                <div class="allocation-bar">
                    <i style="width:@PctCss(_data.LoserRefundRate)"></i>
                    <b style="width:@PctCss(_data.WinnerPoolRate)"></b>
                    <em style="width:@PctCss(_data.HouseFeeRate)"></em>
                </div>
                <div class="legend">
                    <span>@T("panels.settlement.legendLoser", FmtPct(_data.LoserRefundRate))</span>
                    <span>@T("panels.settlement.legendWinners", FmtPct(_data.WinnerPoolRate))</span>
                    <span>@T("panels.settlement.legendHouse", FmtPct(_data.HouseFeeRate))</span>
                </div>
            </section>

            <section class="rule-panel" id="taxas">
                <span>06</span>
                <h3>@T("panels.fees.title")</h3>
                <p>@T("panels.fees.body")</p>
                <dl>
                    <div><dt>@T("panels.settlement.houseFee")</dt><dd>@FmtPct(_data.HouseFeeRate)</dd></div>
                    <div><dt>@T("panels.fees.minimumCapital")</dt><dd>@FmtSol(_data.MinPositionCapital)</dd></div>
                </dl>
            </section>

            <section class="rule-panel" id="retirada">
                <span>07</span>
                <h3>@T("panels.withdrawal.title")</h3>
                <p>@T("panels.withdrawal.body")</p>
            </section>

            <section class="rule-panel" id="riscos">
                <span>08</span>
                <h3>@T("panels.risks.title")</h3>
                <p>@T("panels.risks.body")</p>
            </section>

            <section class="rule-panel contract-panel" id="contrato">
                <span>09</span>
                @if (IsOffChainCustodyMode)
                {
                    <h3>@T("panels.custody.title")</h3>
                    <p>@T("panels.custody.body", _data.Cluster)</p>
                    <dl>
                        <div><dt>@T("panels.custody.wallet")</dt><dd title="@_data.CustodyWalletPublicKey">@ShortAddress(_data.CustodyWalletPublicKey)</dd></div>
                        <div><dt>@T("panels.custody.label")</dt><dd>@DisplayCustodyWalletLabel</dd></div>
                        <div><dt>@T("panels.custody.network")</dt><dd>@_data.Cluster</dd></div>
                    </dl>
                }
                else
                {
                    <h3>@T("panels.onChain.title")</h3>
                    <p>@T("panels.onChain.body", _data.Cluster)</p>
                    <dl>
                        <div><dt>@T("panels.onChain.programId")</dt><dd title="@_data.ProgramId">@ShortAddress(_data.ProgramId)</dd></div>
                        <div><dt>@T("panels.onChain.authority")</dt><dd title="@_data.AuthorityWallet">@ShortAddress(_data.AuthorityWallet)</dd></div>
                        <div><dt>@T("panels.custody.network")</dt><dd>@_data.Cluster</dd></div>
                    </dl>
                }
            </section>
        </div>

        @if (_data.TopPositions.Count > 0)
        {
            <section class="positions-band">
                <div class="positions-band__header">
                    <span>@T("distribution.label")</span>
                    <h3>@T("distribution.title")</h3>
                    <p>@T("distribution.body")</p>
                </div>
                <div class="position-list">
                    @{
                        var rank = 1;
                    }
                    @foreach (var position in _data.TopPositions)
                    {
                        <article>
                            <div class="position-list__rank">@rank.ToString("00")</div>
                            <div class="position-list__body">
                                <strong class="@GetPositionTitleClass(position.Symbol)">
                                    <span>@GetBaseSymbol(position.Symbol)</span>
                                    <span class="position-list__quote" title="@GetBaseSymbol(position.Symbol)">
                                        <img src="@GetCoinIconUrl(GetBaseSymbol(position.Symbol))"
                                             alt="@GetBaseSymbol(position.Symbol)"
                                             loading="lazy"
                                             onerror="this.remove(); this.nextElementSibling?.classList.remove('d-none');" />
                                        <span class="position-list__quote-fallback d-none">@GetBaseSymbol(position.Symbol)</span>
                                    </span>
                                </strong>
                                <span>@FmtSol(position.CurrentCapital)</span>
                                <small>@T("distribution.capitalInPlay")</small>
                            </div>
                        </article>
                        rank++;
                    }
                </div>
            </section>
        }
    }
</section>

@code {
    private TokenomicsDto? _data;
    private bool _loading = true;
    private string? _error;
    private ElementReference _settlementPieRef;
    private bool _settlementChartRendered;

    private bool IsOffChainCustodyMode
        => string.Equals(_data?.BlockchainMode, "OffChainCustody", StringComparison.OrdinalIgnoreCase);

    private string CurrentCulture => AppCulture.GetCurrentRouteCulture(Nav);

    private string T(string key, params object?[] args)
        => L.T($"howItWorks.{key}", CurrentCulture, args);

    // Imagens físicas: wwwroot/images/how-it-works/criptoversus_banner_*.png
    // URLs públicas: /images/how-it-works/criptoversus_banner_*.png
    private const string BannerDirectory = "/images/how-it-works/";
    private bool _useEnglishBannerFallback;

    private string HeroBannerUrl => BannerDirectory + (_useEnglishBannerFallback
        ? "criptoversus_banner_en.png"
        : GetBannerFilename(CurrentCulture));

    private static string GetBannerFilename(string? culture)
    {
        var language = (culture ?? "en").Split('-', '_')[0].ToLowerInvariant();
        return language switch
        {
            "pt" => "criptoversus_banner_pt-BR.png",
            "es" => "criptoversus_banner_es-ES.png",
            "fr" => "criptoversus_banner_fr-FR.png",
            "de" => "criptoversus_banner_de-DE.png",
            "it" => "criptoversus_banner_it-IT.png",
            "ja" => "criptoversus_banner_ja-JP.png",
            "zh" => "criptoversus_banner_zh-CN.png",
            _ => "criptoversus_banner_en.png"
        };
    }

    private void UseEnglishBannerFallback()
    {
        // Evita repetição infinita quando até o arquivo inglês estiver indisponível.
        if (!_useEnglishBannerFallback && HeroBannerUrl != BannerDirectory + "criptoversus_banner_en.png")
            _useEnglishBannerFallback = true;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        _useEnglishBannerFallback = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private string MetaKeywords => $"{SeoDefaults.GlobalKeywords}, {T("seo.keywords")}";
    private string SocialImageUrl => SeoDefaults.BuildPublicAbsoluteUrl(Config, HeroBannerUrl);
    private MarkupString StructuredDataMarkup => new(BuildStructuredDataJson());

    private string DisplayCustodyWalletLabel
        => string.IsNullOrWhiteSpace(_data?.CustodyWalletLabel)
            ? T("panels.custody.title")
            : _data!.CustodyWalletLabel;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        try
        {
            _data = await Api.GetTokenomicsAsync();
        }
        catch (Exception ex)
        {
            _error = T("error.loadFailed", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is null || _settlementChartRendered)
            return;

        _settlementChartRendered = true;

        await JS.InvokeVoidAsync(
            "tokenomicsCharts.renderSettlementPie",
            _settlementPieRef,
            new
            {
                loserRefundRate = decimal.ToDouble(_data.LoserRefundRate),
                winnerPoolRate = decimal.ToDouble(_data.WinnerPoolRate),
                houseFeeRate = decimal.ToDouble(_data.HouseFeeRate)
            });
    }

    private static string FmtSol(decimal value)
        => $"{value:0.########} SOL";

    private static string FmtPct(decimal value)
        => $"{value * 100m:0.##}%";

    private static string PctCss(decimal value)
        => $"{Math.Max(0m, Math.Min(1m, value)) * 100m:0.##}%";

    private static string GetBaseSymbol(string pair)
    {
        if (string.IsNullOrWhiteSpace(pair))
            return "";

        var normalized = pair.Trim().ToUpperInvariant();
        var quotes = new[] { "USDT", "USDC", "BUSD", "BRL", "EUR", "BTC", "ETH" };

        foreach (var quote in quotes)
        {
            if (normalized.EndsWith(quote, StringComparison.OrdinalIgnoreCase) && normalized.Length > quote.Length)
                return normalized[..^quote.Length];
        }

        return normalized;
    }

    private string GetCoinIconUrl(string symbol)
        => CriptoVersus.Web.Services.EnvironmentIsolationGuard.BuildBinanceIconUrl(symbol.Trim().ToUpperInvariant());

    private static string GetPositionTitleClass(string pair)
    {
        var length = GetBaseSymbol(pair).Length;

        if (length >= 10)
            return "position-list__title position-list__title--xs";

        if (length >= 8)
            return "position-list__title position-list__title--sm";

        if (length >= 6)
            return "position-list__title position-list__title--md";

        return "position-list__title";
    }

    private static string ShortAddress(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        const int start = 7;
        const int end = 6;

        return value.Length <= start + end + 3
            ? value
            : $"{value[..start]}...{value[^end..]}";
    }

    private string BuildStructuredDataJson()
    {
        var pageUrl = SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildHowItWorksPath(CurrentCulture));
        var description = T("seo.description");
        var about = L.GetSection<string[]>("howItWorks.structured.about", CurrentCulture) ?? Array.Empty<string>();

        return JsonSerializer.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@graph"] = new object[]
            {
                new Dictionary<string, object?>
                {
                    ["@type"] = "WebPage",
                    ["name"] = T("seo.title"),
                    ["url"] = pageUrl,
                    ["description"] = description,
                    ["abstract"] = T("structured.abstract"),
                    ["about"] = about,
                    ["keywords"] = about,
                    ["inLanguage"] = AppCulture.ToHrefLang(CurrentCulture)
                },
                new Dictionary<string, object?>
                {
                    ["@type"] = "BreadcrumbList",
                    ["itemListElement"] = new object[]
                    {
                        new Dictionary<string, object?>
                        {
                            ["@type"] = "ListItem",
                            ["position"] = 1,
                            ["name"] = "CriptoVersus",
                            ["item"] = SeoDefaults.BuildPublicAbsoluteUrl(Config, RouteLocalization.BuildHomePath(CurrentCulture))
                        },
                        new Dictionary<string, object?>
                        {
                            ["@type"] = "ListItem",
                            ["position"] = 2,
                            ["name"] = L.T("nav.howItWorks", CurrentCulture),
                            ["item"] = pageUrl
                        }
                    }
                }
            }
        });
    }
}

<style>
    .tokenomics-page {
        --tk-bg: #07090d;
        --tk-panel: rgba(10, 13, 21, 0.96);
        --tk-panel-soft: rgba(12, 16, 26, 0.92);
        --tk-border: rgba(118, 131, 164, 0.18);
        --tk-text: #eef4ff;
        --tk-muted: #aab7cb;
        --tk-left: #C1F20F;
        --tk-right: #185957;
        --tk-purple: var(--tk-left);
        --tk-green: var(--tk-left);
        --tk-cyan: var(--tk-right);
        --tk-gold: var(--tk-left);
        display: grid;
        gap: 1.35rem;
        position: relative;
        width: 100%;
        max-width: min(1880px, calc(100vw - 24px));
        margin-inline: auto;
        padding-inline: 12px;
        color: var(--tk-text);
    }

        .tokenomics-page::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 8% 12%, rgba(193, 242, 15, 0.14), transparent 20%), radial-gradient(circle at 92% 16%, rgba(24, 89, 87, 0.10), transparent 24%);
        }

    .tokenomics-hero {
        width: 100%;
        min-width: 0;
        min-height: 0;
        border: 1px solid var(--tk-border);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.42);
    }

    .tokenomics-hero__banner {
        display: block;
        width: 100%;
        height: auto;
        max-height: 850px;
        object-fit: cover;
        object-position: center;
        background: #171C26;
    }

    .tokenomics-hero__board {
        aspect-ratio: 923 / 321;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0;
        padding: 1.6rem 1.7rem;
        align-items: stretch;
        background: radial-gradient(circle at 14% 18%, rgba(193, 242, 15, 0.22), transparent 24%), radial-gradient(circle at 84% 26%, rgba(24, 89, 87, 0.18), transparent 28%), linear-gradient(90deg, rgba(18, 9, 26, 0.97), rgba(4, 17, 14, 0.97)), #030507;
    }

    .tokenomics-hero__pillar {
        position: relative;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 1rem;
        align-items: center;
        padding: 1rem 1rem 1rem 1.15rem;
        min-width: 0;
    }

        .tokenomics-hero__pillar + .tokenomics-hero__pillar::before {
            content: "";
            position: absolute;
            left: 0;
            top: 18%;
            bottom: 18%;
            width: 1px;
            background: linear-gradient(180deg, transparent, rgba(255,255,255,0.16), transparent);
        }

    .tokenomics-hero__icon {
        width: 4rem;
        height: 4rem;
        border-radius: 20px;
        display: grid;
        place-items: center;
        font-size: 1.65rem;
        font-weight: 900;
        letter-spacing: .08em;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.08);
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
    }

    .tokenomics-hero__pillar strong,
    .tokenomics-hero__pillar span {
        display: block;
        text-transform: uppercase;
        line-height: 1.05;
    }

    .tokenomics-hero__pillar strong {
        font-size: clamp(1rem, 1vw + .5rem, 1.55rem);
        letter-spacing: .06em;
        margin-bottom: .38rem;
    }

    .tokenomics-hero__pillar span {
        color: #eef5ff;
        font-size: clamp(1rem, .92vw + .44rem, 1.45rem);
        font-weight: 800;
        letter-spacing: .03em;
        opacity: .95;
    }

    .tokenomics-hero__pillar--combat strong,
    .tokenomics-hero__pillar--combat .tokenomics-hero__icon {
        color: var(--tk-left);
    }

    .tokenomics-hero__pillar--strategy strong,
    .tokenomics-hero__pillar--strategy .tokenomics-hero__icon {
        color: var(--tk-right);
    }

    .tokenomics-hero__pillar--tech strong,
    .tokenomics-hero__pillar--tech .tokenomics-hero__icon {
        color: var(--tk-left);
    }

    .tokenomics-hero__pillar--ranking strong,
    .tokenomics-hero__pillar--ranking .tokenomics-hero__icon {
        color: var(--tk-left);
    }

    .tokenomics-hero__pillar--global strong,
    .tokenomics-hero__pillar--global .tokenomics-hero__icon {
        color: var(--tk-left);
    }

    .rule-panel span,
    .metrics-band span,
    .positions-band span {
        color: var(--tk-left);
        font-weight: 900;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    .metrics-band,
    .rule-panel,
    .positions-band,
    .rule-alert {
        position: relative;
        border: 1px solid var(--tk-border);
        border-radius: 24px;
        background: linear-gradient(180deg, rgba(10, 13, 21, 0.98), rgba(7, 9, 15, 0.99));
        box-shadow: 0 24px 70px rgba(0,0,0,0.34), inset 0 1px 0 rgba(255,255,255,0.03);
        overflow: hidden;
    }

        .metrics-band::before,
        .rule-panel::before,
        .positions-band::before,
        .rule-alert::before,
        .topic-callout::before {
            content: "";
            position: absolute;
