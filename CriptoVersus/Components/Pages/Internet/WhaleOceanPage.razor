@page "/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/en/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/pt/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/zh/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/es/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/fr/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/de/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/it/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/ja/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/hi/tv/whale-ocean/{MatchId:int}/{Slug}"
@using DTOs
@using Microsoft.JSInterop
@using CriptoVersus.Web.Services
@inject CriptoVersusApiClient Api
@inject DashboardHubClient Hub
@inject AppCultureService AppCulture
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject RouteLocalizationService RouteLocalization
@inject LocalizationService Localization
@inject ILogger<WhaleOceanPage> Logger
@inject IWebHostEnvironment HostEnvironment
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Whale Ocean 3D · @(_match?.TeamA ?? "") vs @(_match?.TeamB ?? "")</PageTitle>

<main class="whale-ocean" data-ocean-state="BOOTSTRAP_PENDING" data-match-state="@OfficialMatchState">
    <header class="whale-ocean__header">
        <div>
            <div class="whale-ocean__eyebrow">CRIPTOVERSUS · MARKET VISUALIZATION</div>
            <h1>Whale Ocean <span>3D</span></h1>
            <p>Real-time market flow, represented from the match's official trade stream.</p>
        </div>
        <div class="whale-ocean__actions">
            @if (_match is not null)
            {
                <a href="@RouteLocalization.BuildTvMatchPath(_culture, MatchId, Slug ?? string.Empty)">Back to TV</a>
            }
            <button type="button" @onclick="TogglePaused">Pause</button>
            <label>Quality <select @bind="_quality" @bind:after="QualityChangedAsync"><option>Low</option><option>Medium</option><option>High</option></select></label>
        </div>
    </header>

    @if (_match is null)
    {
        <section class="whale-ocean__loading" aria-live="polite">@(_loadError ?? "Loading match and ocean state…")</section>
    }
    else
    {
        <section class="whale-ocean__stage" aria-label="Whale Ocean 3D visualization">
            <canvas @ref="_canvas" class="whale-ocean__canvas"></canvas>
            <div class="whale-ocean__divider" data-whale-ocean="territory-divider" aria-hidden="true"></div>
            <div class="whale-ocean__labels" data-whale-ocean="labels" aria-hidden="true"></div>
            <div class="whale-ocean__topbar">
                <div class="whale-ocean__status" aria-live="polite">
                    <div class="whale-ocean__status-main"><i></i><span>@OfficialStatusLabel</span></div>
                    @if (OfficialEndTimeText is not null)
                    {
                        <small class="whale-ocean__status-ended">@OfficialEndTimeText</small>
                    }
                    <span class="whale-ocean__renderer-status" data-whale-ocean="renderer-status" aria-hidden="true"></span>
                </div>
                <div class="whale-ocean__state-note">No simulated market data · DEMO mode is off</div>
            </div>
            <div class="whale-ocean__direction whale-ocean__direction--left" aria-label="@Localization.T("whaleOcean.direction", _culture)"><span class="sell">← @Localization.T("whaleOcean.sell", _culture)</span><strong>@_match.TeamA</strong><span class="buy">@Localization.T("whaleOcean.buy", _culture) →</span></div>
            <div class="whale-ocean__direction whale-ocean__direction--right" aria-label="@Localization.T("whaleOcean.direction", _culture)"><span class="sell">← @Localization.T("whaleOcean.sell", _culture)</span><strong>@_match.TeamB</strong><span class="buy">@Localization.T("whaleOcean.buy", _culture) →</span></div>
            <div class="whale-ocean__territory whale-ocean__territory--left">
                <div class="whale-ocean__coin">
                    @if (!string.IsNullOrEmpty(LeftLogoUrl))
                    {
                        <img class="whale-ocean__coin-logo" src="@LeftLogoUrl" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                    }
                    <span class="whale-ocean__coin-fallback" style="@(string.IsNullOrEmpty(LeftLogoUrl) ? "display:grid" : null)">@LeftCoinInitials</span>
                    <strong>@_match.TeamA</strong>
                </div>
                <small data-whale-ocean="left-price">—</small>
                <div><span>BUY</span><b data-whale-ocean="left-buy">—</b></div>
                <div><span>SELL</span><b data-whale-ocean="left-sell">—</b></div>
                <em data-whale-ocean="left-change">@FormatPercent(_match.PctA)</em>
                <small>@Localization.T("whaleOcean.windowVolume", _culture) <span data-whale-ocean="left-volume">—</span> <span data-whale-ocean="left-currency">QUOTE</span></small>
            </div>
            <div class="whale-ocean__territory whale-ocean__territory--right">
                <div class="whale-ocean__coin">
                    @if (!string.IsNullOrEmpty(RightLogoUrl))
                    {
                        <img class="whale-ocean__coin-logo" src="@RightLogoUrl" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                    }
                    <span class="whale-ocean__coin-fallback" style="@(string.IsNullOrEmpty(RightLogoUrl) ? "display:grid" : null)">@RightCoinInitials</span>
                    <strong>@_match.TeamB</strong>
                </div>
                <small data-whale-ocean="right-price">—</small>
                <div><span>BUY</span><b data-whale-ocean="right-buy">—</b></div>
                <div><span>SELL</span><b data-whale-ocean="right-sell">—</b></div>
                <em data-whale-ocean="right-change">@FormatPercent(_match.PctB)</em>
                <small>@Localization.T("whaleOcean.windowVolume", _culture) <span data-whale-ocean="right-volume">—</span> <span data-whale-ocean="right-currency">QUOTE</span></small>
            </div>
            <div class="whale-ocean__legend"><span class="buy">● BUY AGGRESSOR</span><span class="sell">● SELL AGGRESSOR</span><span>Events <b data-whale-ocean="events">0</b></span></div>
            <div class="whale-ocean__alerts" data-whale-ocean="alerts" aria-live="polite"></div>
            @if (HostEnvironment.IsDevelopment())
            {
                <aside class="whale-ocean__diagnostics" data-whale-ocean="flow-diagnostics" aria-live="polite" aria-label="Money Flow development diagnostics"></aside>
                <style>
                    .whale-ocean__diagnostics { position:absolute; z-index:2; right:1rem; bottom:1rem; display:grid; gap:.28rem; max-width:min(760px,calc(100% - 2rem)); padding:.62rem .7rem; border:1px solid #6f9fb866; border-radius:.55rem; background:#031221e8; color:#cde4ef; font:600 .62rem/1.3 ui-monospace,SFMono-Regular,Consolas,monospace; pointer-events:none; }
                    .whale-ocean__diagnostics>strong { color:#ffe38a; font-size:.68rem; letter-spacing:.05em; } .whale-ocean__diagnostics>small { color:#8ab1c7; } .whale-ocean__diagnostic-row { display:grid; grid-template-columns:minmax(110px,1fr) minmax(185px,1.6fr) minmax(110px,1fr) minmax(90px,.8fr) auto; gap:.6rem; align-items:center; border-top:1px solid #28516a66; padding-top:.25rem; } .whale-ocean__diagnostic-row b { color:#9ab9cf; } .whale-ocean__diagnostic-row[data-origin=LIVE] b { color:#67f4a5; } .whale-ocean__diagnostic-row[data-origin=REPLAY] b { color:#ffd166; }
                </style>
            }
        </section>
    }
</main>

@code {
    [Parameter] public int MatchId { get; set; }
    [Parameter] public string? Slug { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _matchRefresh = new(1, 1);
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private MatchDto? _match;
    private string _culture = AppCultureService.DefaultRouteCulture;
    private string? _loadError;
    private string _quality = "Medium";
    private bool _paused;
    private bool _subscribed;
    private bool _dashboardSubscribed;
    private bool _disposed;
    private int _loadedMatchId;
    private Task? _statusMonitorTask;

    protected override async Task OnParametersSetAsync()
    {
        _culture = AppCulture.ResolveNavigationCulture(Nav, HttpContextAccessor.HttpContext);
        if (_loadedMatchId == MatchId && _match is not null) return;
        _loadedMatchId = MatchId;
        _match = null;
        _loadError = null;
        await DisposeJsAsync();
        try
        {
            _match = await Api.GetMatchByIdAsync(MatchId, includeParticipants: false, _lifetime.Token);
            if (_match is null)
            {
                _loadError = "Match not found.";
                return;
            }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Whale Ocean match load failed. MatchId={MatchId}", MatchId);
            _loadError = "Unable to load this match right now.";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_match is null || _module is not null || _lifetime.IsCancellationRequested) return;
        try
        {
            var leftPrice = await Api.GetAssetPriceSnapshotAsync(_match.TeamA, _lifetime.Token);
            var rightPrice = await Api.GetAssetPriceSnapshotAsync(_match.TeamB, _lifetime.Token);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/dist/whale-ocean/whale-ocean-bootstrap.js?v=20261112-whale-ocean-status-v1");
            await _module.InvokeVoidAsync("initialize", new
            {
                canvas = _canvas,
                matchId = MatchId,
                leftSymbol = _match.TeamA.ToUpperInvariant(),
                rightSymbol = _match.TeamB.ToUpperInvariant(),
                leftPrice = leftPrice?.LastPriceUsdt,
                rightPrice = rightPrice?.LastPriceUsdt,
                leftChange = leftPrice?.PercentageChange ?? _match.PctA ?? 0,
                rightChange = rightPrice?.PercentageChange ?? _match.PctB ?? 0,
                leftColor = "#ff9100",
                rightColor = "#18d8d2",
                quality = _quality,
                developmentDiagnostics = HostEnvironment.IsDevelopment(),
                debugWhaleOcean = DebugWhaleOceanEnabled()
            });
            Hub.MoneyFlowBatchReceived += OnMoneyFlowBatch;
            Hub.MoneyFlowConnectionChanged += OnMoneyFlowConnectionChanged;
            Hub.DashboardChanged -= OnDashboardChanged;
            Hub.DashboardChanged += OnDashboardChanged;
            _dashboardSubscribed = true;

            if (!IsOfficialMatchFinished)
                _subscribed = await Hub.SubscribeToMoneyFlowAsync(MatchId, _lifetime.Token);

            try { await Hub.EnsureStartedAsync(_lifetime.Token); }
            catch (OperationCanceledException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Whale Ocean dashboard hub unavailable; state verification continues."); }

            await _module.InvokeVoidAsync("setConnectionState", MatchId, _subscribed);
            await _module.InvokeVoidAsync("setMatchFinished", MatchId, IsOfficialMatchFinished);
            await _module.InvokeVoidAsync("completeReplay", MatchId);
            if (_statusMonitorTask is null || _statusMonitorTask.IsCompleted)
                _statusMonitorTask = RunStatusVerificationAsync(_lifetime.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or HttpRequestException)
        {
            Logger.LogWarning(ex, "Whale Ocean bootstrap failed. MatchId={MatchId}", MatchId);
            await DisposeJsAsync();
            _loadError = "The ocean renderer could not start on this device.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnMoneyFlowBatch(MoneyFlowClientBatchDto batch)
    {
        if (batch.MatchId != MatchId || _module is null || IsOfficialMatchFinished) return;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await _module.InvokeVoidAsync("receive", MatchId, new
                {
                    matchId = batch.MatchId,
                    symbol = batch.Symbol,
                    sequence = batch.Sequence,
                    eventTimeUtc = batch.EventTimeUtc,
                    tradeCount = batch.TradeCount,
                    takerBuyQuote = batch.TakerBuyQuote,
                    takerSellQuote = batch.TakerSellQuote,
                    lastPrice = batch.LastPrice,
                    isPartial = batch.IsPartial,
                    isReplay = batch.IsReplay
                });
            }
            catch (JSDisconnectedException) { }
        });
    }

    private void OnMoneyFlowConnectionChanged(bool connected)
    {
        if (_module is null || IsOfficialMatchFinished) return;
        _ = InvokeAsync(async () =>
        {
            try { await _module.InvokeVoidAsync("setConnectionState", MatchId, connected); }
            catch (JSDisconnectedException) { }
        });
    }

    private void OnDashboardChanged(string? payload)
    {
        if (!_disposed)
            _ = InvokeAsync(RefreshOfficialMatchStateAsync);
    }

    private async Task RunStatusVerificationAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (!_disposed && await timer.WaitForNextTickAsync(ct))
            {
                if (IsOfficialMatchFinished)
                    return;

                await InvokeAsync(RefreshOfficialMatchStateAsync);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshOfficialMatchStateAsync()
    {
        if (_disposed || MatchId <= 0)
            return;

        try
        {
            if (!await _matchRefresh.WaitAsync(0, _lifetime.Token))
                return;
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            var latest = await Api.GetMatchByIdAsync(MatchId, includeParticipants: false, _lifetime.Token);
            if (_disposed || latest is null)
                return;

            _match = latest;
            var finished = IsOfficialMatchFinished;
            if (_module is not null)
                await _module.InvokeVoidAsync("setMatchFinished", MatchId, finished);

            if (finished)
                await StopLiveFlowAsync();

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Whale Ocean official match state refresh failed. MatchId={MatchId}", MatchId);
        }
        finally
        {
            _matchRefresh.Release();
        }
    }

    private async Task StopLiveFlowAsync()
    {
        Hub.MoneyFlowConnectionChanged -= OnMoneyFlowConnectionChanged;
        Hub.MoneyFlowBatchReceived -= OnMoneyFlowBatch;
        if (_subscribed)
        {
            await Hub.UnsubscribeFromMoneyFlowAsync(MatchId, _lifetime.Token);
            _subscribed = false;
        }

        if (_dashboardSubscribed)
        {
            Hub.DashboardChanged -= OnDashboardChanged;
            _dashboardSubscribed = false;
        }
    }

    private async Task TogglePaused()
    {
        _paused = !_paused;
        if (_module is not null) await _module.InvokeVoidAsync("setPaused", MatchId, _paused);
    }

    private async Task QualityChangedAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("setQuality", MatchId, _quality);
    }

    private static string FormatPercent(decimal? value)
        => value.HasValue ? $"{(value.Value >= 0 ? "+" : string.Empty)}{value.Value:0.00}%" : "—";

    private string LeftLogoUrl => _match is null ? string.Empty : Api.BuildBinanceIconUrl(_match.TeamA);
    private string RightLogoUrl => _match is null ? string.Empty : Api.BuildBinanceIconUrl(_match.TeamB);
    private string LeftCoinInitials => CoinInitials(_match?.TeamA);
    private string RightCoinInitials => CoinInitials(_match?.TeamB);
    private bool IsOfficialMatchFinished => WhaleOceanMatchState.IsFinished(_match);
    private string OfficialMatchState => _match is null ? "BOOTSTRAP_PENDING" : IsOfficialMatchFinished ? "FINALIZED" : "LIVE";
    private string OfficialStatusLabel => Localization.T(
        IsOfficialMatchFinished ? "whaleOcean.finalized" : "whaleOcean.live",
        _culture);
    private string? OfficialEndTimeText => _match?.EndTime is not DateTime endTime
        ? null
        : Localization.T(
            "whaleOcean.endedAt",
            _culture,
            WhaleOceanMatchState.FormatEndDateUtc(endTime, AppCulture.ToCultureCode(_culture)),
            WhaleOceanMatchState.FormatEndClockUtc(endTime));

    private static string CoinInitials(string? symbol)
    {
        var baseSymbol = EnvironmentIsolationGuard.NormalizeBinanceIconSymbol(symbol);
        var letters = new string(baseSymbol.Where(char.IsLetter).Take(3).ToArray()).ToUpperInvariant();
        return string.IsNullOrEmpty(letters)
            ? new string(baseSymbol.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpperInvariant()
            : letters;
    }

    private bool DebugWhaleOceanEnabled()
        => !Nav.ToAbsoluteUri(Nav.Uri).Query
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Any(part => part.Equals("?debugWhaleOcean=0", StringComparison.OrdinalIgnoreCase)
                || part.Equals("debugWhaleOcean=0", StringComparison.OrdinalIgnoreCase));

    private async Task DisposeJsAsync()
    {
        Hub.MoneyFlowBatchReceived -= OnMoneyFlowBatch;
        Hub.MoneyFlowConnectionChanged -= OnMoneyFlowConnectionChanged;
        Hub.DashboardChanged -= OnDashboardChanged;
        _dashboardSubscribed = false;
        if (_subscribed)
        {
            await Hub.UnsubscribeFromMoneyFlowAsync(MatchId);
            _subscribed = false;
        }
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", MatchId); } catch (JSDisconnectedException) { }
            await _module.DisposeAsync();
            _module = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _lifetime.Cancel();
        if (_statusMonitorTask is not null)
        {
            try { await _statusMonitorTask; } catch (OperationCanceledException) { }
        }
        try { await _matchRefresh.WaitAsync(); _matchRefresh.Release(); } catch (ObjectDisposedException) { }
        await DisposeJsAsync();
        _matchRefresh.Dispose();
        _lifetime.Dispose();
    }
}
