@page "/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/en/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/pt/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/zh/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/es/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/fr/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/de/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/it/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/ja/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/hi/tv/whale-ocean/{MatchId:int}/{Slug}"
@using DTOs
@using Microsoft.JSInterop
@using CriptoVersus.Web.Services
@inject CriptoVersusApiClient Api
@inject DashboardHubClient Hub
@inject AppCultureService AppCulture
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject RouteLocalizationService RouteLocalization
@inject LocalizationService Localization
@inject MatchSeoService MatchSeo
@inject MatchSlugHelper MatchSlugHelper
@inject ILogger<WhaleOceanPage> Logger
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration Configuration
@rendermode InteractiveServer
@implements IAsyncDisposable

<BasicSeoHead Title="@CurrentSeo.Title"
              Description="@CurrentSeo.Description"
              CanonicalUrl="@CurrentSeo.CanonicalUrl"
              AlternateLinks="@CurrentSeo.AlternateLinks"
              XDefaultUrl="@CurrentSeo.XDefaultUrl"
              OgLocale="@CurrentSeo.OpenGraphLocale"
              OgAlternateLocale="@CurrentSeo.OpenGraphAlternateLocale"
              ImageUrl="@CurrentSeo.OpenGraphImageUrl"
              ImageAlt="@CurrentSeo.SocialImageAlt"
              OpenGraphTitle="@CurrentSeo.OpenGraphTitle"
              OpenGraphDescription="@CurrentSeo.OpenGraphDescription"
              OpenGraphUrl="@CurrentSeo.OpenGraphUrl"
              TwitterTitle="@CurrentSeo.TwitterTitle"
              TwitterDescription="@CurrentSeo.TwitterDescription"
              TwitterCard="@CurrentSeo.TwitterCard"
              JsonLd="@CurrentSeo.StructuredDataMarkup"
              Robots="@SeoRobots"
              RenderKeywords="false" />

<main class="whale-ocean" data-match-state="@OfficialMatchState" data-flow-state="@FlowStatus">
    <header class="whale-ocean__header">
        <div>
            <h1>@T("title")</h1>
            <p>@T("tagline")</p>
        </div>
        <div class="whale-ocean__actions">
            <a href="@RouteLocalization.BuildHomePath(_culture)">@T("backToHome")</a>
            @if (_match is not null)
            {
                <a href="@RouteLocalization.BuildTvMatchPath(_culture, MatchId, ResolvedSlug)">@T("watchOnTv")</a>
                <a href="@RouteLocalization.BuildCandleBattlesPath(_culture, MatchId, ResolvedSlug)">@Localization.T("candleBattles.arcade", _culture)</a>
            }
            <button type="button" @onclick="TogglePaused">@(_paused ? T("resume") : T("pause"))</button>
            <label>@T("quality") <select @bind="_quality" @bind:after="QualityChangedAsync"><option value="Low">@T("qualityLow")</option><option value="Medium">@T("qualityMedium")</option><option value="High">@T("qualityHigh")</option></select></label>
        </div>
    </header>

    @if (_match is null && !CalibrationEnabled)
    {
        <section class="whale-ocean__loading" aria-live="polite">
            <div class="whale-ocean__status" aria-live="polite">
                <div class="whale-ocean__status-main"><i></i><span>@DisplayedStatusLabel</span></div>
            </div>
            <span>@(_loadError ?? T("loading"))</span>
        </section>
    }
    else
    {
        <section class="whale-ocean__stage" aria-label="@T("stageAria")">
            <canvas @ref="_canvas" class="whale-ocean__canvas"></canvas>
            <div class="whale-ocean__divider" data-whale-ocean="territory-divider" aria-hidden="true"></div>
            <div class="whale-ocean__labels" data-whale-ocean="labels" aria-hidden="true"></div>
            @if (CalibrationEnabled)
            {
                <aside class="whale-ocean__calibration" data-whale-ocean-calibration="@MatchId" aria-label="Whale Ocean DEV Calibration">
                    <div class="whale-ocean__calibration-head"><strong>WHALE OCEAN · DEV CALIBRATION</strong><span data-calibration-status>Inicializando…</span><button type="button" data-calibration-action="toggle" aria-label="Recolher painel">−</button></div>
                    <details open><summary>Câmera</summary><div class="whale-ocean__calibration-grid">
                        <label>Target X<input type="range" min="-50" max="50" step="0.01" data-calibration-field="camera.targetX" /><input type="number" step="0.01" data-calibration-field="camera.targetX" /></label>
                        <label>Target Y<input type="range" min="-30" max="30" step="0.01" data-calibration-field="camera.targetY" /><input type="number" step="0.01" data-calibration-field="camera.targetY" /></label>
                        <label>Target Z<input type="range" min="-30" max="30" step="0.01" data-calibration-field="camera.targetZ" /><input type="number" step="0.01" data-calibration-field="camera.targetZ" /></label>
                        <label>Alpha<input type="range" min="-3.14" max="3.14" step="0.01" data-calibration-field="camera.alpha" /><input type="number" step="0.01" data-calibration-field="camera.alpha" /></label>
                        <label>Beta<input type="range" min="0.1" max="3.04" step="0.01" data-calibration-field="camera.beta" /><input type="number" step="0.01" data-calibration-field="camera.beta" /></label>
                        <label>Radius<input type="range" min="5" max="70" step="0.1" data-calibration-field="camera.radius" /><input type="number" step="0.1" data-calibration-field="camera.radius" /></label>
                        <label>FOV<input type="range" min="0.2" max="2.2" step="0.01" data-calibration-field="camera.fov" /><input type="number" step="0.01" data-calibration-field="camera.fov" /></label>
                        <label>Offset X px<input type="range" min="-500" max="500" step="1" data-calibration-field="screenOffsetX" /><input type="number" step="1" data-calibration-field="screenOffsetX" /></label>
                        <label>Offset Y px<input type="range" min="-300" max="300" step="1" data-calibration-field="screenOffsetY" /><input type="number" step="1" data-calibration-field="screenOffsetY" /></label>
                    </div><div class="whale-ocean__calibration-buttons"><button type="button" data-calibration-action="reset-camera">Reset Camera</button><button type="button" data-calibration-action="center-camera">Centralizar</button><button type="button" data-calibration-action="apply-offset">Aplicar offset</button></div></details>
                    <details open><summary>Territórios e limites · mundo</summary><div class="whale-ocean__calibration-grid">
                        <label>Limite A<input type="number" step="0.01" data-calibration-field="territories.left" /></label><label>Divisão central<input type="number" step="0.01" data-calibration-field="territories.center" /></label><label>Limite B<input type="number" step="0.01" data-calibration-field="territories.right" /></label>
                        <label>Altura mínima px<input type="number" step="1" data-calibration-field="vertical.minPx" /></label><label>Altura máxima px<input type="number" step="1" data-calibration-field="vertical.maxPx" /></label><label>Margem px<input type="number" min="0" step="1" data-calibration-field="vertical.safetyMarginPx" /></label>
                        <label>Spawn BUY<input type="number" step="0.01" data-calibration-field="spawn.buy" /></label><label>Spawn SELL<input type="number" step="0.01" data-calibration-field="spawn.sell" /></label><label>Saída BUY<input type="number" step="0.01" data-calibration-field="exit.buy" /></label><label>Saída SELL<input type="number" step="0.01" data-calibration-field="exit.sell" /></label>
                    </div></details>
                    <details open><summary>Peixes de teste · sem servidor</summary><div class="whale-ocean__calibration-test-grid">
                        <label>Side<select data-test-field="side"><option value="buy">BUY →</option><option value="sell">SELL ←</option></select></label><label>Território<select data-test-field="territory"><option value="left">A / left</option><option value="right">B / right</option></select></label><label>Espécie<select data-test-field="kind"><option value="sardine">P · sardine</option><option value="mackerel">M · mackerel</option><option value="grouper">G · grouper</option><option value="shark">shark</option><option value="whale">whale</option></select></label><label>Faixa<select data-test-field="band"><option value="0">surface</option><option value="1">high</option><option value="2" selected>central</option><option value="3">deep</option><option value="4">bottom</option></select></label><label>Velocidade<input type="number" min="0.05" max="4" step="0.05" value="1" data-test-field="speed" /></label><label>Quantidade<input type="number" min="1" max="24" step="1" value="1" data-test-field="quantity" /></label>
                    </div><div class="whale-ocean__calibration-buttons"><button type="button" data-calibration-action="spawn">Spawn Test Fish</button><button type="button" data-calibration-action="spawn-both">Spawn BUY + SELL</button><button type="button" data-calibration-action="all-bands">Testar todas as faixas</button><button type="button" data-calibration-action="pause">Pause simulation</button><button type="button" data-calibration-action="clear">Limpar TEST</button><button type="button" data-calibration-action="restart">Reiniciar trajetória</button></div></details>
                    <details><summary>Rastreamento e persistência</summary><div class="whale-ocean__calibration-checks"><label><input type="checkbox" checked data-calibration-field="guides" /> guias</label><label><input type="checkbox" checked data-calibration-field="grid" /> grade 100 px</label><label><input type="checkbox" checked data-calibration-field="traces" /> trajetórias</label><label>Slow motion<select data-calibration-field="slowMotion"><option value="0.25">0.25x</option><option value="0.5">0.5x</option><option value="1" selected>1x</option><option value="2">2x</option></select></label></div><div class="whale-ocean__calibration-buttons"><button type="button" data-calibration-action="save">Save Calibration</button><button type="button" data-calibration-action="load">Load Calibration</button><button type="button" data-calibration-action="reset-defaults">Reset Defaults</button><button type="button" data-calibration-action="export">Export JSON</button><button type="button" data-calibration-action="copy">Copy Settings</button></div><pre data-calibration-diagnostics aria-live="polite"></pre></details>
                </aside>
            }
            <section class="whale-ocean__scoreboard" aria-label="@T("battleScoreboard")">
                <div class="whale-ocean__scoreboard-topcard whale-ocean__scoreboard-topcard--left">
                    <div class="whale-ocean__score-team whale-ocean__score-team--left">
                        <div class="whale-ocean__score-heading"><strong>@DisplayTeamA</strong></div>
                        <div class="whale-ocean__score-meta"><span>@T("matchTotal") <b data-whale-ocean="left-total-trades">0</b></span><span>@T("last30Seconds") <b data-whale-ocean="left-window-trades">0</b></span></div>
                        <div class="whale-ocean__score-side"><span>@T("buy") <b data-whale-ocean="left-buy-points">0</b></span><span>@T("sell") <b data-whale-ocean="left-sell-points">0</b></span></div>
                    </div>
                </div>
                <div class="whale-ocean__score-control">
                    <div class="whale-ocean__score-values">
                        <b><span data-whale-ocean="left-score">0</span> <small>@T("points")</small></b>
                        <strong>VS</strong>
                        <b><span data-whale-ocean="right-score">0</span> <small>@T("points")</small></b>
                    </div>
                    <span>@T("oceanControl")</span>
                    <div class="whale-ocean__control-bar"><i data-whale-ocean="control-left-bar"></i><i data-whale-ocean="control-right-bar"></i></div>
                    <div class="whale-ocean__control-labels"><b data-whale-ocean="control-left">—</b><b data-whale-ocean="control-right">—</b></div>
                </div>
                <div class="whale-ocean__scoreboard-topcard whale-ocean__scoreboard-topcard--right">
                    <div class="whale-ocean__score-team whale-ocean__score-team--right">
                        <div class="whale-ocean__score-heading"><strong>@DisplayTeamB</strong></div>
                        <div class="whale-ocean__score-meta"><span>@T("last30Seconds") <b data-whale-ocean="right-window-trades">0</b></span><span>@T("matchTotal") <b data-whale-ocean="right-total-trades">0</b></span></div>
                        <div class="whale-ocean__score-side"><span>@T("buy") <b data-whale-ocean="right-buy-points">0</b></span><span>@T("sell") <b data-whale-ocean="right-sell-points">0</b></span></div>
                    </div>
                </div>
                <div class="whale-ocean__scoreboard-band">
                    <div class="whale-ocean__score-species-team whale-ocean__score-species-team--left">
                        <div class="whale-ocean__species-grid">
                            <span title="@T("small")"><img class="whale-ocean__species-icon whale-ocean__species-icon--small" src="/images/whale-ocean/hud/whale-hud-small.png" alt="" aria-hidden="true" /><b data-whale-ocean="left-small">0</b><em>@T("small")</em></span>
                            <span title="@T("medium")"><img class="whale-ocean__species-icon whale-ocean__species-icon--medium" src="/images/whale-ocean/hud/whale-hud-medium.png" alt="" aria-hidden="true" /><b data-whale-ocean="left-medium">0</b><em>@T("medium")</em></span>
                            <span title="@T("large")"><img class="whale-ocean__species-icon whale-ocean__species-icon--large" src="/images/whale-ocean/hud/whale-hud-large.png" alt="" aria-hidden="true" /><b data-whale-ocean="left-large">0</b><em>@T("large")</em></span>
                            <span title="@T("shark")"><img class="whale-ocean__species-icon whale-ocean__species-icon--shark" src="/images/whale-ocean/hud/whale-hud-shark.png" alt="" aria-hidden="true" /><b data-whale-ocean="left-shark">0</b><em>@T("shark")</em></span>
                            <span title="@T("whale")"><img class="whale-ocean__species-icon whale-ocean__species-icon--whale" src="/images/whale-ocean/hud/whale-hud-whale.png" alt="" aria-hidden="true" /><b data-whale-ocean="left-whale">0</b><em>@T("whale")</em></span>
                        </div>
                        <small class="whale-ocean__score-window">@T("last30Seconds"): <b data-whale-ocean="left-window-score">0</b> @T("points")</small>
                    </div>
                    <div class="whale-ocean__score-species-team whale-ocean__score-species-team--right">
                        <div class="whale-ocean__species-grid">
                            <span title="@T("whale")"><img class="whale-ocean__species-icon whale-ocean__species-icon--whale" src="/images/whale-ocean/hud/whale-hud-whale.png" alt="" aria-hidden="true" /><b data-whale-ocean="right-whale">0</b><em>@T("whale")</em></span>
                            <span title="@T("shark")"><img class="whale-ocean__species-icon whale-ocean__species-icon--shark" src="/images/whale-ocean/hud/whale-hud-shark.png" alt="" aria-hidden="true" /><b data-whale-ocean="right-shark">0</b><em>@T("shark")</em></span>
                            <span title="@T("large")"><img class="whale-ocean__species-icon whale-ocean__species-icon--large" src="/images/whale-ocean/hud/whale-hud-large.png" alt="" aria-hidden="true" /><b data-whale-ocean="right-large">0</b><em>@T("large")</em></span>
                            <span title="@T("medium")"><img class="whale-ocean__species-icon whale-ocean__species-icon--medium" src="/images/whale-ocean/hud/whale-hud-medium.png" alt="" aria-hidden="true" /><b data-whale-ocean="right-medium">0</b><em>@T("medium")</em></span>
                            <span title="@T("small")"><img class="whale-ocean__species-icon whale-ocean__species-icon--small" src="/images/whale-ocean/hud/whale-hud-small.png" alt="" aria-hidden="true" /><b data-whale-ocean="right-small">0</b><em>@T("small")</em></span>
                        </div>
                        <small class="whale-ocean__score-window">@T("last30Seconds"): <b data-whale-ocean="right-window-score">0</b> @T("points")</small>
                    </div>
                    <div class="whale-ocean__species-compare" role="group" aria-label="@T("speciesComparison")">
                        <span class="whale-ocean__species-compare-team whale-ocean__sr-only" id="whale-ocean-team-left">@DisplayTeamA</span>
                        <span class="whale-ocean__species-compare-team whale-ocean__sr-only" id="whale-ocean-team-right">@DisplayTeamB</span>
                        <span class="whale-ocean__species-compare-row" title="@T("small")" role="group">
                            <span class="whale-ocean__species-count whale-ocean__species-count--left" aria-describedby="whale-ocean-team-left"><b data-whale-ocean="left-small">0</b></span>
                            <img class="whale-ocean__species-compare-icon whale-ocean__species-compare-icon--small" src="/images/whale-ocean/hud/whale-hud-small.png" alt="@T("small")" />
                            <span class="whale-ocean__species-count whale-ocean__species-count--right" aria-describedby="whale-ocean-team-right"><b data-whale-ocean="right-small">0</b></span>
                        </span>
                        <span class="whale-ocean__species-compare-row" title="@T("medium")" role="group">
                            <span class="whale-ocean__species-count whale-ocean__species-count--left" aria-describedby="whale-ocean-team-left"><b data-whale-ocean="left-medium">0</b></span>
                            <img class="whale-ocean__species-compare-icon whale-ocean__species-compare-icon--medium" src="/images/whale-ocean/hud/whale-hud-medium.png" alt="@T("medium")" />
                            <span class="whale-ocean__species-count whale-ocean__species-count--right" aria-describedby="whale-ocean-team-right"><b data-whale-ocean="right-medium">0</b></span>
                        </span>
                        <span class="whale-ocean__species-compare-row" title="@T("large")" role="group">
                            <span class="whale-ocean__species-count whale-ocean__species-count--left" aria-describedby="whale-ocean-team-left"><b data-whale-ocean="left-large">0</b></span>
                            <img class="whale-ocean__species-compare-icon whale-ocean__species-compare-icon--large" src="/images/whale-ocean/hud/whale-hud-large.png" alt="@T("large")" />
                            <span class="whale-ocean__species-count whale-ocean__species-count--right" aria-describedby="whale-ocean-team-right"><b data-whale-ocean="right-large">0</b></span>
                        </span>
                        <span class="whale-ocean__species-compare-row" title="@T("shark")" role="group">
                            <span class="whale-ocean__species-count whale-ocean__species-count--left" aria-describedby="whale-ocean-team-left"><b data-whale-ocean="left-shark">0</b></span>
                            <img class="whale-ocean__species-compare-icon whale-ocean__species-compare-icon--shark" src="/images/whale-ocean/hud/whale-hud-shark.png" alt="@T("shark")" />
                            <span class="whale-ocean__species-count whale-ocean__species-count--right" aria-describedby="whale-ocean-team-right"><b data-whale-ocean="right-shark">0</b></span>
                        </span>
                        <span class="whale-ocean__species-compare-row" title="@T("whale")" role="group">
                            <span class="whale-ocean__species-count whale-ocean__species-count--left" aria-describedby="whale-ocean-team-left"><b data-whale-ocean="left-whale">0</b></span>
                            <img class="whale-ocean__species-compare-icon whale-ocean__species-compare-icon--whale" src="/images/whale-ocean/hud/whale-hud-whale.png" alt="@T("whale")" />
                            <span class="whale-ocean__species-count whale-ocean__species-count--right" aria-describedby="whale-ocean-team-right"><b data-whale-ocean="right-whale">0</b></span>
                        </span>
                    </div>
                </div>
            </section>
            <div class="whale-ocean__topbar">
                <div class="whale-ocean__status" aria-live="polite">
                    <div class="whale-ocean__status-main"><i></i><span>@DisplayedStatusLabel</span></div>
                    @if (OfficialEndTimeText is not null)
                    {
                        <small class="whale-ocean__status-ended">@OfficialEndTimeText</small>
                    }
                    @if (FinalResultText is not null)
                    {
                        <strong class="whale-ocean__final-result" aria-live="polite">@FinalResultText</strong>
                    }
                    <span class="whale-ocean__renderer-status" data-whale-ocean="renderer-status" aria-hidden="true"></span>
                    <span class="whale-ocean__renderer-error" data-whale-ocean="renderer-error" role="alert" hidden></span>
                </div>
                <div class="whale-ocean__state-note">@T("demoModeOff")</div>
            </div>
            <div class="whale-ocean__direction" aria-label="@T("direction")"><span class="sell">← @T("sell")</span><strong>@DisplayTeamA vs @DisplayTeamB</strong><span class="buy">@T("buy") →</span></div>
            <div class="whale-ocean__territory whale-ocean__territory--left">
                <div class="whale-ocean__coin">
                    @if (!string.IsNullOrEmpty(LeftLogoUrl))
                    {
                        <img class="whale-ocean__coin-logo" src="@LeftLogoUrl" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                    }
                    <span class="whale-ocean__coin-fallback" style="@(string.IsNullOrEmpty(LeftLogoUrl) ? "display:grid" : null)">@LeftCoinInitials</span>
                    <strong>@DisplayTeamA</strong>
                </div>
                <small data-whale-ocean="left-price">—</small>
                <div><span>@T("buy")</span><b data-whale-ocean="left-buy">—</b></div>
                <div><span>@T("sell")</span><b data-whale-ocean="left-sell">—</b></div>
                <em data-whale-ocean="left-change">@FormatPercent(_match?.PctA)</em>
                <small>@T("windowVolume") <span data-whale-ocean="left-volume">—</span> <span data-whale-ocean="left-currency">QUOTE</span></small>
            </div>
            <div class="whale-ocean__territory whale-ocean__territory--right">
                <div class="whale-ocean__coin">
                    @if (!string.IsNullOrEmpty(RightLogoUrl))
                    {
                        <img class="whale-ocean__coin-logo" src="@RightLogoUrl" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                    }
                    <span class="whale-ocean__coin-fallback" style="@(string.IsNullOrEmpty(RightLogoUrl) ? "display:grid" : null)">@RightCoinInitials</span>
                    <strong>@DisplayTeamB</strong>
                </div>
                <small data-whale-ocean="right-price">—</small>
                <div><span>@T("buy")</span><b data-whale-ocean="right-buy">—</b></div>
                <div><span>@T("sell")</span><b data-whale-ocean="right-sell">—</b></div>
                <em data-whale-ocean="right-change">@FormatPercent(_match?.PctB)</em>
                <small>@T("windowVolume") <span data-whale-ocean="right-volume">—</span> <span data-whale-ocean="right-currency">QUOTE</span></small>
            </div>
            @if (HostEnvironment.IsDevelopment())
            {
                <aside class="whale-ocean__diagnostics" data-whale-ocean="flow-diagnostics" aria-live="polite" aria-label="Money Flow development diagnostics"></aside>
                <style>
                    .whale-ocean__diagnostics { position:absolute; z-index:2; right:1rem; bottom:1rem; display:grid; gap:.28rem; max-width:min(760px,calc(100% - 2rem)); padding:.62rem .7rem; border:1px solid #6f9fb866; border-radius:.55rem; background:#031221e8; color:#cde4ef; font:600 .62rem/1.3 ui-monospace,SFMono-Regular,Consolas,monospace; pointer-events:none; }
