    private bool _rendererInitializationFailed;
    private string _flowStatus = "BOOTSTRAP_PENDING";
    private string _renderedCulture = string.Empty;
    private static readonly string[] LabelKeys = ["buy", "sell", "alertWhale", "alertShark", "rendererFailed"];

    private string T(string key, params object?[] args) => Localization.T($"whaleOcean.{key}", _culture, args);
    private Dictionary<string, string> JsLabels => LabelKeys.ToDictionary(k => k, k => T(k));
    private string ResolvedSlug => _match is null
        ? (string.IsNullOrWhiteSpace(MatchSlugHelper.ParseLegacySlug(Slug)) ? "match" : MatchSlugHelper.ParseLegacySlug(Slug))
        : MatchSlugHelper.BuildSlug(_match.TeamA, _match.TeamB);
    private MatchSeoMetadata CurrentSeo => _match is not null
        ? MatchSeo.BuildExperienceMetadata(_match, ResolvedSlug, _culture, MatchExperienceSeo.WhaleOcean)
        : BuildUnavailableSeo();
    private string? SeoRobots => _match is null || CalibrationEnabled ? "noindex, nofollow, noarchive" : null;

    private MatchSeoMetadata BuildUnavailableSeo()
    {
        var canonicalPath = RouteLocalization.BuildWhaleOceanPath(_culture, MatchId, ResolvedSlug);
        var canonicalUrl = SeoDefaults.BuildPublicAbsoluteUrl(Configuration, canonicalPath);
        return new MatchSeoMetadata
        {
            Title = $"{T("title")} | CriptoVersus",
            Description = T("tagline"),
            CanonicalUrl = canonicalUrl,
            AlternateLinks = MatchSeo.BuildExperienceAlternateLinks(MatchExperienceSeo.WhaleOcean, MatchId, ResolvedSlug),
            OpenGraphTitle = $"{T("title")} | CriptoVersus",
            OpenGraphDescription = T("tagline"),
            OpenGraphUrl = canonicalUrl,
            OpenGraphLocale = AppCulture.ToOgLocale(_culture),
            OpenGraphAlternateLocale = AppCulture.GetAlternateOgLocale(_culture),
            XDefaultUrl = SeoDefaults.BuildPublicAbsoluteUrl(Configuration, RouteLocalization.BuildWhaleOceanPath(AppCultureService.DefaultRouteCulture, MatchId, ResolvedSlug)),
            TwitterTitle = $"{T("title")} | CriptoVersus",
            TwitterDescription = T("tagline"),
            TwitterCard = "summary_large_image",
            StructuredDataMarkup = string.Empty
        };
    }

    private void MarkNotFound()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context is not null && !context.Response.HasStarted)
            context.Response.StatusCode = 404;
    }

    protected override async Task OnParametersSetAsync()
    {
        var gateEntered = false;
        try
        {
            await _rendererGate.WaitAsync(_lifetime.Token);
            gateEntered = true;
            _culture = AppCulture.ResolveNavigationCulture(Nav, HttpContextAccessor.HttpContext);
            if (_loadedMatchId == MatchId && _match is not null) return;
            _loadedMatchId = MatchId;
            _match = null;
            _scoreboard = null;
            _loadError = null;
            _initialMatchStateLogged = false;
            _officialMatchFinalized = false;
            _rendererInitializationFailed = false;
            _flowStatus = "BOOTSTRAP_PENDING";
            await DisposeJsCoreAsync();
            _match = await Api.GetMatchByIdAsync(MatchId, includeParticipants: false, _lifetime.Token);
            if (_match is null)
            {
                _loadError = T("matchNotFound");
                if (!CalibrationEnabled)
                {
                    MarkNotFound();
                    return;
                }
                _flowStatus = "BOOTSTRAP_PENDING";
                return;
            }

            try
            {
                _scoreboard = await Api.GetWhaleOceanScoreboardAsync(MatchId, _lifetime.Token);
                Logger.LogInformation(
                    "Whale Ocean scoreboard snapshot loaded. MatchId={MatchId} TeamA={TeamA} TeamB={TeamB} TeamAPoints={TeamAPoints} TeamBPoints={TeamBPoints} TeamATrades={TeamATrades} TeamBTrades={TeamBTrades}",
                    MatchId,
                    _scoreboard?.TeamA.Symbol,
                    _scoreboard?.TeamB.Symbol,
                    _scoreboard?.TeamA.MatchTotal.Points ?? 0,
                    _scoreboard?.TeamB.MatchTotal.Points ?? 0,
                    _scoreboard?.TeamA.MatchTotal.TradeCount ?? 0,
                    _scoreboard?.TeamB.MatchTotal.TradeCount ?? 0);
            }
            catch (Exception ex) when (ex is HttpRequestException or TimeoutException)
            {
                Logger.LogWarning(ex, "Whale Ocean scoreboard recovery failed; live replay will still be used. MatchId={MatchId}", MatchId);
            }

            _officialMatchFinalized = WhaleOceanMatchState.IsFinished(_match);
            _flowStatus = IsOfficialMatchFinished ? "FINALIZED" : "BOOTSTRAP_PENDING";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Whale Ocean match load failed. MatchId={MatchId}", MatchId);
            _loadError = T("loadFailed");
        }
        finally
        {
            if (gateEntered)
                _rendererGate.Release();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialMatchStateLogged)
        {
            _initialMatchStateLogged = true;
            await LogMatchStateAsync(_loadError is null ? "official state loaded" : "official state unavailable");
        }

        var labelModule = _module;
        if (!_disposed && labelModule is not null && !string.Equals(_renderedCulture, _culture, StringComparison.Ordinal))
        {
            _renderedCulture = _culture;
            try { await labelModule.InvokeVoidAsync("setLabels", MatchId, JsLabels); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }

        if (_disposed || _rendererInitializationFailed || (_match is null && !CalibrationEnabled) || _lifetime.IsCancellationRequested) return;
        if (!await _rendererGate.WaitAsync(0)) return;
        var gateEntered = true;
        try
        {
            if (_disposed || (_match is null && !CalibrationEnabled) || _module is not null || _lifetime.IsCancellationRequested) return;
            var matchId = MatchId;
            var match = _match;
            var culture = _culture;
            var labels = JsLabels;
            var leftSymbol = DisplayTeamA;
            var rightSymbol = DisplayTeamB;
            var leftPrice = match is null ? null : await Api.GetAssetPriceSnapshotAsync(leftSymbol, _lifetime.Token);
            var rightPrice = match is null ? null : await Api.GetAssetPriceSnapshotAsync(rightSymbol, _lifetime.Token);
            if (_disposed || _lifetime.IsCancellationRequested || MatchId != matchId) return;
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/dist/whale-ocean/whale-ocean-bootstrap.js?v=20261117-whale-ocean-species-audit-v2");
            if (module is null)
                throw new InvalidOperationException("Whale Ocean bootstrap module was not returned by JS interop.");
            if (_disposed || _lifetime.IsCancellationRequested || MatchId != matchId)
            {
                try { await module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (InvalidOperationException) { }
                return;
            }

            _module = module;
            _jsMatchId = matchId;
            await module.InvokeVoidAsync("initialize", new
            {
                canvas = _canvas,
                matchId,
                leftSymbol = leftSymbol.ToUpperInvariant(),
                rightSymbol = rightSymbol.ToUpperInvariant(),
                leftPrice = leftPrice?.LastPriceUsdt,
                rightPrice = rightPrice?.LastPriceUsdt,
                leftChange = leftPrice?.PercentageChange ?? match?.PctA ?? 0,
                rightChange = rightPrice?.PercentageChange ?? match?.PctB ?? 0,
                leftColor = "#ff9100",
                rightColor = "#18d8d2",
                quality = _quality,
                geometryProfile = "reference",
                labels,
                developmentDiagnostics = HostEnvironment.IsDevelopment(),
                debugWhaleOcean = DebugWhaleOceanEnabled() || CalibrationEnabled,
                calibrationEnabled = CalibrationEnabled,
                matchFinished = IsOfficialMatchFinished,
                officialStatus = OfficialMatchState,
                officialRawStatus = match?.Status,
                officialStartTimeUtc = match?.StartTime,
                officialEndTimeUtc = match?.EndTime,
                scoreboard = _scoreboard
            });
            if (_disposed || _lifetime.IsCancellationRequested) return;

            await module.InvokeVoidAsync("setMatchFinished", matchId, IsOfficialMatchFinished);
            if (CalibrationEnabled)
                await module.InvokeVoidAsync("initializeCalibrationPanel", matchId);
            _renderedCulture = culture;
            if (_disposed || _lifetime.IsCancellationRequested) return;

            if (IsOfficialMatchFinished)
            {
                SetFlowStatus("FINALIZED", "official match was already finalized before renderer bootstrap");
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (match is not null)
            {
                Hub.MoneyFlowBatchReceived += OnMoneyFlowBatch;
                Hub.MoneyFlowConnectionChanged += OnMoneyFlowConnectionChanged;
                Hub.DashboardChanged -= OnDashboardChanged;
                Hub.DashboardChanged += OnDashboardChanged;
                _dashboardSubscribed = true;

                if (!IsOfficialMatchFinished)
                {
                    _subscribed = await Hub.SubscribeToMoneyFlowAsync(matchId, _lifetime.Token);
                    _subscribedMatchId = _subscribed ? matchId : 0;
                }

                try { await Hub.EnsureStartedAsync(_lifetime.Token); }
                catch (OperationCanceledException) { }
                catch (Exception ex) { Logger.LogDebug(ex, "Whale Ocean dashboard hub unavailable; state verification continues."); }

                await module.InvokeVoidAsync("setConnectionState", matchId, _subscribed);
                await module.InvokeVoidAsync("completeReplay", matchId);
                SetFlowStatus("BOOTSTRAP_PENDING", "Money Flow subscription initialized; awaiting first batch");
                if (_statusMonitorTask is null || _statusMonitorTask.IsCompleted)
                    _statusMonitorTask = RunStatusVerificationAsync(_lifetime.Token);
            }
            else
            {
                await module.InvokeVoidAsync("setConnectionState", matchId, false);
                await module.InvokeVoidAsync("completeReplay", matchId);
                SetFlowStatus("PAUSED", "DEV calibration fallback initialized without API match data");
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or HttpRequestException or OperationCanceledException)
