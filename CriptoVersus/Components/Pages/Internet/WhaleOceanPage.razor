@page "/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/en/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/pt/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/zh/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/es/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/fr/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/de/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/it/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/ja/tv/whale-ocean/{MatchId:int}/{Slug}"
@page "/hi/tv/whale-ocean/{MatchId:int}/{Slug}"
@using DTOs
@using Microsoft.JSInterop
@using CriptoVersus.Web.Services
@inject CriptoVersusApiClient Api
@inject DashboardHubClient Hub
@inject AppCultureService AppCulture
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject RouteLocalizationService RouteLocalization
@inject LocalizationService Localization
@inject ILogger<WhaleOceanPage> Logger
@inject IWebHostEnvironment HostEnvironment
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>@T("pageTitle", _match?.TeamA ?? "", _match?.TeamB ?? "")</PageTitle>

<main class="whale-ocean" data-match-state="@OfficialMatchState" data-flow-state="@FlowStatus">
    <header class="whale-ocean__header">
        <div>
            <h1>@T("title")</h1>
            <p>@T("tagline")</p>
        </div>
        <div class="whale-ocean__actions">
            <a href="@RouteLocalization.BuildHomePath(_culture)">@T("backToHome")</a>
            <button type="button" @onclick="TogglePaused">@(_paused ? T("resume") : T("pause"))</button>
            <label>@T("quality") <select @bind="_quality" @bind:after="QualityChangedAsync"><option value="Low">@T("qualityLow")</option><option value="Medium">@T("qualityMedium")</option><option value="High">@T("qualityHigh")</option></select></label>
        </div>
    </header>

    @if (_match is null)
    {
        <section class="whale-ocean__loading" aria-live="polite">
            <div class="whale-ocean__status" aria-live="polite">
                <div class="whale-ocean__status-main"><i></i><span>@DisplayedStatusLabel</span></div>
            </div>
            <span>@(_loadError ?? T("loading"))</span>
        </section>
    }
    else
    {
        <section class="whale-ocean__stage" aria-label="@T("stageAria")">
            <canvas @ref="_canvas" class="whale-ocean__canvas"></canvas>
            <div class="whale-ocean__divider" data-whale-ocean="territory-divider" aria-hidden="true"></div>
            <div class="whale-ocean__labels" data-whale-ocean="labels" aria-hidden="true"></div>
            <div class="whale-ocean__topbar">
                <div class="whale-ocean__status" aria-live="polite">
                    <div class="whale-ocean__status-main"><i></i><span>@DisplayedStatusLabel</span></div>
                    @if (OfficialEndTimeText is not null)
                    {
                        <small class="whale-ocean__status-ended">@OfficialEndTimeText</small>
                    }
                    <span class="whale-ocean__renderer-status" data-whale-ocean="renderer-status" aria-hidden="true"></span>
                </div>
                <div class="whale-ocean__state-note">@T("demoModeOff")</div>
            </div>
            <div class="whale-ocean__direction" aria-label="@T("direction")"><span class="sell">← @T("sell")</span><strong>@_match.TeamA@_match.TeamB</strong><span class="buy">@T("buy") →</span></div>
            <div class="whale-ocean__territory whale-ocean__territory--left">
                <div class="whale-ocean__coin">
                    @if (!string.IsNullOrEmpty(LeftLogoUrl))
                    {
                        <img class="whale-ocean__coin-logo" src="@LeftLogoUrl" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                    }
                    <span class="whale-ocean__coin-fallback" style="@(string.IsNullOrEmpty(LeftLogoUrl) ? "display:grid" : null)">@LeftCoinInitials</span>
                    <strong>@_match.TeamA</strong>
                </div>
                <small data-whale-ocean="left-price">—</small>
                <div><span>@T("buy")</span><b data-whale-ocean="left-buy">—</b></div>
                <div><span>@T("sell")</span><b data-whale-ocean="left-sell">—</b></div>
                <em data-whale-ocean="left-change">@FormatPercent(_match.PctA)</em>
                <small>@T("windowVolume") <span data-whale-ocean="left-volume">—</span> <span data-whale-ocean="left-currency">QUOTE</span></small>
            </div>
            <div class="whale-ocean__territory whale-ocean__territory--right">
                <div class="whale-ocean__coin">
                    @if (!string.IsNullOrEmpty(RightLogoUrl))
                    {
                        <img class="whale-ocean__coin-logo" src="@RightLogoUrl" alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />
                    }
                    <span class="whale-ocean__coin-fallback" style="@(string.IsNullOrEmpty(RightLogoUrl) ? "display:grid" : null)">@RightCoinInitials</span>
                    <strong>@_match.TeamB</strong>
                </div>
                <small data-whale-ocean="right-price">—</small>
                <div><span>@T("buy")</span><b data-whale-ocean="right-buy">—</b></div>
                <div><span>@T("sell")</span><b data-whale-ocean="right-sell">—</b></div>
                <em data-whale-ocean="right-change">@FormatPercent(_match.PctB)</em>
                <small>@T("windowVolume") <span data-whale-ocean="right-volume">—</span> <span data-whale-ocean="right-currency">QUOTE</span></small>
            </div>
            <div class="whale-ocean__legend"><span class="buy">● @T("buyAggressor")</span><span class="sell">● @T("sellAggressor")</span><span>@T("events") <b data-whale-ocean="events">0</b></span></div>
            @if (HostEnvironment.IsDevelopment())
            {
                <aside class="whale-ocean__diagnostics" data-whale-ocean="flow-diagnostics" aria-live="polite" aria-label="Money Flow development diagnostics"></aside>
                <style>
                    .whale-ocean__diagnostics { position:absolute; z-index:2; right:1rem; bottom:1rem; display:grid; gap:.28rem; max-width:min(760px,calc(100% - 2rem)); padding:.62rem .7rem; border:1px solid #6f9fb866; border-radius:.55rem; background:#031221e8; color:#cde4ef; font:600 .62rem/1.3 ui-monospace,SFMono-Regular,Consolas,monospace; pointer-events:none; }
                    .whale-ocean__diagnostics>strong { color:#ffe38a; font-size:.68rem; letter-spacing:.05em; } .whale-ocean__diagnostics>small { color:#8ab1c7; } .whale-ocean__diagnostic-row { display:grid; grid-template-columns:minmax(110px,1fr) minmax(185px,1.6fr) minmax(110px,1fr) minmax(90px,.8fr) auto; gap:.6rem; align-items:center; border-top:1px solid #28516a66; padding-top:.25rem; } .whale-ocean__diagnostic-row b { color:#9ab9cf; } .whale-ocean__diagnostic-row[data-origin=LIVE] b { color:#67f4a5; } .whale-ocean__diagnostic-row[data-origin=REPLAY] b { color:#ffd166; }
                </style>
            }
        </section>
    }
</main>

@code {
    [Parameter] public int MatchId { get; set; }
    [Parameter] public string? Slug { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _matchRefresh = new(1, 1);
    private readonly SemaphoreSlim _rendererGate = new(1, 1);
    private ElementReference _canvas;
    private IJSObjectReference? _module;
    private int _jsMatchId;
    private MatchDto? _match;
    private string _culture = AppCultureService.DefaultRouteCulture;
    private string? _loadError;
    private string _quality = "Medium";
    private bool _paused;
    private bool _subscribed;
    private int _subscribedMatchId;
    private bool _dashboardSubscribed;
    private bool _disposed;
    private int _loadedMatchId;
    private Task? _statusMonitorTask;
    private bool _initialMatchStateLogged;
    private bool _officialMatchFinalized;
    private bool _rendererInitializationFailed;
    private string _flowStatus = "BOOTSTRAP_PENDING";
    private string _renderedCulture = string.Empty;
    private static readonly string[] LabelKeys = ["buy", "sell", "alertWhale", "alertShark"];

    private string T(string key, params object?[] args) => Localization.T($"whaleOcean.{key}", _culture, args);
    private Dictionary<string, string> JsLabels => LabelKeys.ToDictionary(k => k, k => T(k));

    protected override async Task OnParametersSetAsync()
    {
        var gateEntered = false;
        try
        {
            await _rendererGate.WaitAsync(_lifetime.Token);
            gateEntered = true;
            _culture = AppCulture.ResolveNavigationCulture(Nav, HttpContextAccessor.HttpContext);
            if (_loadedMatchId == MatchId && _match is not null) return;
            _loadedMatchId = MatchId;
            _match = null;
            _loadError = null;
            _initialMatchStateLogged = false;
            _officialMatchFinalized = false;
            _rendererInitializationFailed = false;
            _flowStatus = "BOOTSTRAP_PENDING";
            await DisposeJsCoreAsync();
            _match = await Api.GetMatchByIdAsync(MatchId, includeParticipants: false, _lifetime.Token);
            if (_match is null)
            {
                _loadError = T("matchNotFound");
                return;
            }

            _officialMatchFinalized = WhaleOceanMatchState.IsFinished(_match);
            _flowStatus = IsOfficialMatchFinished ? "FINALIZED" : "BOOTSTRAP_PENDING";
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Whale Ocean match load failed. MatchId={MatchId}", MatchId);
            _loadError = T("loadFailed");
        }
        finally
        {
            if (gateEntered)
                _rendererGate.Release();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialMatchStateLogged)
        {
            _initialMatchStateLogged = true;
            await LogMatchStateAsync(_loadError is null ? "official state loaded" : "official state unavailable");
        }

        var labelModule = _module;
        if (!_disposed && labelModule is not null && !string.Equals(_renderedCulture, _culture, StringComparison.Ordinal))
        {
            _renderedCulture = _culture;
            try { await labelModule.InvokeVoidAsync("setLabels", MatchId, JsLabels); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }

        if (_disposed || _rendererInitializationFailed || _match is null || _lifetime.IsCancellationRequested) return;
        if (!await _rendererGate.WaitAsync(0)) return;
        var gateEntered = true;
        try
        {
            if (_disposed || _match is null || _module is not null || _lifetime.IsCancellationRequested) return;
            var matchId = MatchId;
            var match = _match;
            var culture = _culture;
            var labels = JsLabels;
            var priceTasks = new[]
            {
                Api.GetAssetPriceSnapshotAsync(match.TeamA, _lifetime.Token),
                Api.GetAssetPriceSnapshotAsync(match.TeamB, _lifetime.Token)
            };
            await Task.WhenAll(priceTasks);
            var leftPrice = await priceTasks[0];
            var rightPrice = await priceTasks[1];
            if (_disposed || _lifetime.IsCancellationRequested || MatchId != matchId) return;
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/dist/whale-ocean/whale-ocean-bootstrap.js?v=20261113-whale-ocean-depth-bands-v12");
            if (module is null)
                throw new InvalidOperationException("Whale Ocean bootstrap module was not returned by JS interop.");
            if (_disposed || _lifetime.IsCancellationRequested || MatchId != matchId)
            {
                try { await module.DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (InvalidOperationException) { }
                return;
            }

            _module = module;
            _jsMatchId = matchId;
            await module.InvokeVoidAsync("initialize", new
            {
                canvas = _canvas,
                matchId,
                leftSymbol = match.TeamA.ToUpperInvariant(),
                rightSymbol = match.TeamB.ToUpperInvariant(),
                leftPrice = leftPrice?.LastPriceUsdt,
                rightPrice = rightPrice?.LastPriceUsdt,
                leftChange = leftPrice?.PercentageChange ?? match.PctA ?? 0,
                rightChange = rightPrice?.PercentageChange ?? match.PctB ?? 0,
                leftColor = "#ff9100",
                rightColor = "#18d8d2",
                quality = _quality,
                labels,
                developmentDiagnostics = HostEnvironment.IsDevelopment(),
                debugWhaleOcean = DebugWhaleOceanEnabled(),
                matchFinished = IsOfficialMatchFinished,
                officialStatus = OfficialMatchState,
                officialRawStatus = match.Status,
                officialStartTimeUtc = match.StartTime,
                officialEndTimeUtc = match.EndTime
            });
            if (_disposed || _lifetime.IsCancellationRequested) return;

            await module.InvokeVoidAsync("setMatchFinished", matchId, IsOfficialMatchFinished);
            _renderedCulture = culture;
            if (_disposed || _lifetime.IsCancellationRequested) return;

            if (IsOfficialMatchFinished)
            {
                SetFlowStatus("FINALIZED", "official match was already finalized before renderer bootstrap");
                await InvokeAsync(StateHasChanged);
                return;
            }

            Hub.MoneyFlowBatchReceived += OnMoneyFlowBatch;
            Hub.MoneyFlowConnectionChanged += OnMoneyFlowConnectionChanged;
            Hub.DashboardChanged -= OnDashboardChanged;
            Hub.DashboardChanged += OnDashboardChanged;
            _dashboardSubscribed = true;

            if (!IsOfficialMatchFinished)
            {
                _subscribed = await Hub.SubscribeToMoneyFlowAsync(matchId, _lifetime.Token);
                _subscribedMatchId = _subscribed ? matchId : 0;
            }

            try { await Hub.EnsureStartedAsync(_lifetime.Token); }
            catch (OperationCanceledException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Whale Ocean dashboard hub unavailable; state verification continues."); }

            await module.InvokeVoidAsync("setConnectionState", matchId, _subscribed);
            await module.InvokeVoidAsync("completeReplay", matchId);
            SetFlowStatus("BOOTSTRAP_PENDING", "Money Flow subscription initialized; awaiting first batch");
            if (_statusMonitorTask is null || _statusMonitorTask.IsCompleted)
                _statusMonitorTask = RunStatusVerificationAsync(_lifetime.Token);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or HttpRequestException or OperationCanceledException)
        {
            Logger.LogWarning(ex, "Whale Ocean bootstrap failed. MatchId={MatchId}", MatchId);
            _rendererInitializationFailed = true;
            await DisposeJsCoreAsync();
            if (!_disposed && !_lifetime.IsCancellationRequested)
            {
                _loadError = T("rendererFailed");
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            if (gateEntered)
                _rendererGate.Release();
        }
    }

    private void OnMoneyFlowBatch(MoneyFlowClientBatchDto batch)
    {
        if (_disposed || batch.MatchId != MatchId) return;
        if (IsOfficialMatchFinished)
        {
            _ = InvokeAsync(() =>
            {
                SetFlowStatus("LIVE", "Money Flow batch arrived after official finalization");
                return Task.CompletedTask;
            });
            return;
        }

        var module = _module;
        if (module is null) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            try
            {
                var becameLive = SetFlowStatus("LIVE", "Money Flow batch received");
                await module.InvokeVoidAsync("receive", batch.MatchId, new
                {
                    matchId = batch.MatchId,
                    symbol = batch.Symbol,
                    sequence = batch.Sequence,
                    eventTimeUtc = batch.EventTimeUtc,
                    tradeCount = batch.TradeCount,
                    takerBuyQuote = batch.TakerBuyQuote,
                    takerSellQuote = batch.TakerSellQuote,
                    lastPrice = batch.LastPrice,
                    isPartial = batch.IsPartial,
                    isReplay = batch.IsReplay
                });
                if (becameLive) await InvokeAsync(StateHasChanged);
            }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        });
    }

    private void OnMoneyFlowConnectionChanged(bool connected)
    {
        if (_disposed) return;
        if (IsOfficialMatchFinished)
        {
            _ = InvokeAsync(() =>
            {
                SetFlowStatus(connected ? "LIVE" : "BOOTSTRAP_PENDING", connected ? "SignalR connected after official finalization" : "SignalR disconnected after official finalization");
                return Task.CompletedTask;
            });
            return;
        }

        var module = _module;
        if (module is null) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed) return;
            try { await module.InvokeVoidAsync("setConnectionState", MatchId, connected); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            var nextFlowStatus = connected && string.Equals(_flowStatus, "LIVE", StringComparison.Ordinal)
                ? "LIVE"
                : "BOOTSTRAP_PENDING";
            var changed = SetFlowStatus(nextFlowStatus, connected ? "SignalR connected; awaiting Money Flow data" : "SignalR disconnected");
            if (changed && !_disposed) await InvokeAsync(StateHasChanged);
        });
    }

    private void OnDashboardChanged(string? payload)
    {
        if (!_disposed)
            _ = InvokeAsync(RefreshOfficialMatchStateAsync);
    }

    private async Task RunStatusVerificationAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (!_disposed && await timer.WaitForNextTickAsync(ct))
            {
                if (IsOfficialMatchFinished)
                    return;

                await InvokeAsync(RefreshOfficialMatchStateAsync);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    private async Task RefreshOfficialMatchStateAsync()
    {
        if (_disposed || MatchId <= 0)
            return;

        var matchId = MatchId;
        try
        {
            if (!await _matchRefresh.WaitAsync(0, _lifetime.Token))
                return;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        try
        {
            var latest = await Api.GetMatchByIdAsync(matchId, includeParticipants: false, _lifetime.Token);
            if (_disposed || MatchId != matchId || latest is null)
                return;

            _officialMatchFinalized |= WhaleOceanMatchState.IsFinished(latest);
            _match = latest;
            var finished = IsOfficialMatchFinished;
            var module = _module;
            if (module is not null)
                await module.InvokeVoidAsync(
                    "setOfficialMatchState",
                    matchId,
                    finished,
                    latest.Status,
                    latest.StartTime,
                    latest.EndTime);

            if (finished)
            {
                SetFlowStatus("FINALIZED", "official API verification reported the match ended");
                await StopLiveFlowAsync();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Whale Ocean official match state refresh failed. MatchId={MatchId}", matchId);
        }
        finally
        {
            try { _matchRefresh.Release(); } catch (ObjectDisposedException) { }
        }
    }

    private async Task StopLiveFlowAsync()
    {
        Hub.MoneyFlowConnectionChanged -= OnMoneyFlowConnectionChanged;
        Hub.MoneyFlowBatchReceived -= OnMoneyFlowBatch;
        if (_subscribed)
        {
            var subscribedMatchId = _subscribedMatchId;
            _subscribed = false;
            _subscribedMatchId = 0;
            try { await Hub.UnsubscribeFromMoneyFlowAsync(subscribedMatchId, _lifetime.Token); }
            catch (OperationCanceledException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }

        if (_dashboardSubscribed)
        {
            Hub.DashboardChanged -= OnDashboardChanged;
            _dashboardSubscribed = false;
        }
    }

    private async Task TogglePaused()
    {
        _paused = !_paused;
        var module = _module;
        if (module is null) return;
        try { await module.InvokeVoidAsync("setPaused", MatchId, _paused); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task QualityChangedAsync()
    {
        var module = _module;
        if (module is null) return;
        try { await module.InvokeVoidAsync("setQuality", MatchId, _quality); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private static string FormatPercent(decimal? value)
        => value.HasValue ? $"{(value.Value >= 0 ? "+" : string.Empty)}{value.Value:0.00}%" : "—";

    private string LeftLogoUrl => _match is null ? string.Empty : Api.BuildBinanceIconUrl(_match.TeamA);
    private string RightLogoUrl => _match is null ? string.Empty : Api.BuildBinanceIconUrl(_match.TeamB);
    private string LeftCoinInitials => CoinInitials(_match?.TeamA);
    private string RightCoinInitials => CoinInitials(_match?.TeamB);
    private bool IsOfficialMatchFinished => _officialMatchFinalized || WhaleOceanMatchState.IsFinished(_match);
    private string OfficialMatchState => _loadError is not null && _match is null
        ? "UNAVAILABLE"
        : IsOfficialMatchFinished ? "FINALIZED" : _match is null ? "UNAVAILABLE" : "LIVE";
    private string FlowStatus => _flowStatus;
    private string DisplayedStatusLabel => OfficialMatchState switch
    {
        "FINALIZED" => T("finalized"),
        "UNAVAILABLE" => T("statusUnavailable"),
        _ when _flowStatus == "BOOTSTRAP_PENDING" => T("bootstrapPending"),
        _ => T("live")
    };
    private string? OfficialEndTimeText => _match?.EndTime is not DateTime endTime
        ? null
        : T(
            "endedAt",
            WhaleOceanMatchState.FormatEndDateUtc(endTime, AppCulture.ToCultureCode(_culture)),
            WhaleOceanMatchState.FormatEndClockUtc(endTime));

    private bool SetFlowStatus(string nextStatus, string reason)
    {
        if (IsOfficialMatchFinished && nextStatus != "FINALIZED")
        {
            _ = LogMatchStateAsync(
                $"blocked flow transition: {reason}",
                $"{_flowStatus} -> {nextStatus}",
                warning: true);
            return false;
        }

        if (string.Equals(_flowStatus, nextStatus, StringComparison.Ordinal))
            return false;

        var previous = _flowStatus;
        _flowStatus = nextStatus;
        _ = LogMatchStateAsync(reason, $"{previous} -> {nextStatus}");
        return true;
    }

    private async Task LogMatchStateAsync(string reason, string? transition = null, bool warning = false)
    {
        if (_disposed) return;

        try
        {
            await JS.InvokeVoidAsync(
                warning ? "console.warn" : "console.info",
                "[WhaleOcean:MatchState]",
                new
                {
                    matchId = MatchId,
                    rawStatus = _match?.Status,
                    normalizedStatus = OfficialMatchState,
                    startTimeUtc = _match?.StartTime,
                    endTimeUtc = _match?.EndTime,
                    flowStatus = _flowStatus,
                    transition,
                    reason
                });
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private static string CoinInitials(string? symbol)
    {
        var baseSymbol = EnvironmentIsolationGuard.NormalizeBinanceIconSymbol(symbol);
        var letters = new string(baseSymbol.Where(char.IsLetter).Take(3).ToArray()).ToUpperInvariant();
        return string.IsNullOrEmpty(letters)
            ? new string(baseSymbol.Where(char.IsLetterOrDigit).Take(3).ToArray()).ToUpperInvariant()
            : letters;
    }

    private bool DebugWhaleOceanEnabled()
        => HostEnvironment.IsDevelopment()
            && Nav.ToAbsoluteUri(Nav.Uri).Query
                .Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Any(part => part.Equals("?debugWhaleOcean=1", StringComparison.OrdinalIgnoreCase)
                    || part.Equals("debugWhaleOcean=1", StringComparison.OrdinalIgnoreCase)
                    || part.Equals("?debugWhaleOcean=true", StringComparison.OrdinalIgnoreCase)
                    || part.Equals("debugWhaleOcean=true", StringComparison.OrdinalIgnoreCase));

    private async Task DisposeJsAsync()
    {
        var gateEntered = false;
        try
        {
            await _rendererGate.WaitAsync();
            gateEntered = true;
            await DisposeJsCoreAsync();
        }
        catch (ObjectDisposedException) { }
        finally
        {
            if (gateEntered)
            {
                try { _rendererGate.Release(); } catch (ObjectDisposedException) { }
            }
        }
    }

    // Callers must hold _rendererGate: module disposal must never interleave
    // with an in-flight bootstrap continuation that still owns _module.
    private async Task DisposeJsCoreAsync()
    {
        Hub.MoneyFlowBatchReceived -= OnMoneyFlowBatch;
        Hub.MoneyFlowConnectionChanged -= OnMoneyFlowConnectionChanged;
        Hub.DashboardChanged -= OnDashboardChanged;
        _dashboardSubscribed = false;
        if (_subscribed)
        {
            var subscribedMatchId = _subscribedMatchId;
            _subscribed = false;
            _subscribedMatchId = 0;
            try { await Hub.UnsubscribeFromMoneyFlowAsync(subscribedMatchId); }
            catch (OperationCanceledException) { }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Whale Ocean Money Flow unsubscribe failed during dispose. MatchId={MatchId}", subscribedMatchId); }
        }

        var module = _module;
        _module = null;
