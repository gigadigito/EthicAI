                await _module.InvokeVoidAsync("disposePriceCrossoverSocialCard", "price-crossover-social-card");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuito encerrado: nada a liberar no navegador.
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "[PRICE_CROSSOVER_SOCIAL] Module dispose failed.");
            }
        }
