        if (string.Equals(text, fullKey, StringComparison.Ordinal)
            || text.Contains("social.priceCrossover.", StringComparison.OrdinalIgnoreCase))
        {
            Logger.LogWarning(
                "[PRICE_CROSSOVER_SOCIAL] Unresolved localization key {Key} culture={Culture}.",
                fullKey,
                _resolvedCulture);
            return string.Empty;
        }

        return text;
    }

    private string PageTitleText => _model is null
        ? T("seo.title")
        : T("seo.titleWithMatch", _model.AssetA.DisplaySymbol, _model.AssetB.DisplaySymbol);

