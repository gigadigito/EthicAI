    { "id":"trends", "name":"Firecrawl Square Trends", "type":"n8n-nodes-base.httpRequest", "typeVersion":4.2, "position":[1390,80], "parameters":{"method":"POST","url":"https://api.firecrawl.dev/v2/scrape","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"{\"url\":\"https://www.binance.com/en/square/trends\",\"formats\":[\"markdown\"],\"maxAge\":0}","options":{"response":{"response":{"responseFormat":"json"}}}} },
    { "id":"tag", "name":"TopHashtag verificada", "type":"n8n-nodes-base.code", "typeVersion":2, "position":[1620,80], "parameters":{"jsCode":"const cfg=$('Validar preflight').first().json;const d=$json.data??$json.body?.data??$json.body??$json,m=String(d.markdown??''),meta=d.metadata??{},official='https://www.binance.com/en/square/trends';if(![meta.sourceURL,meta.url].includes(official)||Number(meta.statusCode)!==200)return [];const begin=m.indexOf('# Trending Topics on Binance Square');if(begin<0)return [];const tail=m.slice(begin),stop=tail.search(/Join global crypto users|# Most Searched \\(6H\\)/i),s=stop<0?tail:tail.slice(0,stop),seenRank=new Set(),seenTag=new Set(),x=[];for(const z of s.matchAll(/\\[([\\s\\S]*?)\\]\\(https:\\/\\/www\\.binance\\.com\\/en\\/square\\/hashtag\\/([^)\\s/?#]+)\\)/gi)){let slug,label=z[1].replace(/\\\\+/g,' ').replace(/\\s+/g,' ').trim();try{slug=decodeURIComponent(z[2]);label=decodeURIComponent(label)}catch{continue}const rank=Number(label.match(/^(10|[1-9])(?=\\s)/)?.[1]),count=label.match(/(\\d[\\d,.]*)\\s+Discussing\\b/i);if(!rank||!count||!slug||slug.length>150||/[\\s<>#]/.test(slug)||!label.includes('#'+slug)||seenRank.has(rank)||seenTag.has(slug.toLowerCase()))continue;seenRank.add(rank);seenTag.add(slug.toLowerCase());x.push({rank,tag:'#'+slug})}x.sort((a,b)=>a.rank-b.rank);const top=x.find(t=>t.tag.toLowerCase()!=='#criptoversus');return top?[{json:{...cfg,topHashtag:top.tag,hashtagRank:top.rank}}]:[];"} },
    { "id":"reserve", "name":"API - Reservar", "type":"n8n-nodes-base.httpRequest", "typeVersion":4.2, "position":[1850,80], "parameters":{"method":"POST","url":"={{ $json.apiBase + '/api/social/candle-battle/' + $json.matchId + '/reserve' }}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({owner:$json.owner,leaseSeconds:7200}) }}","options":{"response":{"response":{"responseFormat":"json"}}}} },
