    { "id":"caption", "name":"Legenda real e comando captura", "type":"n8n-nodes-base.code", "typeVersion":2, "position":[2310,80], "parameters":{"jsCode":"const c=$('TopHashtag verificada').first().json,b=$json.body??$json;if(b.matchId!==c.matchId||b.status!=='Completed'||b.replayAvailable!==true)throw new Error('historico_invalido');const base=s=>String(s).toUpperCase().replace(/USDT$/,'');const l=base(b.assetA.symbol),r=base(b.assetB.symbol),a=Number(b.scoreA),d=Number(b.scoreB);const goals=a+d===0?'A disputa terminou sem gols.':a===d?`Empate em ${a} a ${d}, com ${a+d} gols válidos.`:`Placar final ${a} a ${d}, com ${a+d} gols válidos.`;const postText=`⚔️ Candle Battle: $${l} vs $${r}\\n\\n🔥 ${goals}\\n🎬 Evolução real dos candles até o resultado final.\\n\\n${c.topHashtag} #CriptoVersus\\nDados históricos do mercado. Não é recomendação financeira.`;const text64=Buffer.from(postText).toString('base64');const command=`mkdir -p '${c.publisherRoot}/candle-battle-publications/candle-battle-video-${c.videoVersion}-${c.matchId}' && printf '%s' '${text64}' | base64 -d > '${c.publisherRoot}/candle-battle-publications/candle-battle-video-${c.videoVersion}-${c.matchId}/post.txt' && bash '${c.publisherRoot}/candle-battle-tools/candle-battle-publish.sh' capture '${c.matchId}' '${c.videoVersion}'`;return [{json:{...c,postText,captureCommand:command,reservedAtUtc:$('API - Reservar').first().json.body?.publication?.reservedAtUtc??$('API - Reservar').first().json.publication?.reservedAtUtc}}];"} },
