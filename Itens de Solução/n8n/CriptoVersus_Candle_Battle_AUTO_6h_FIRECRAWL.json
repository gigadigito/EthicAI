    { "id":"captured", "name":"Validar captura", "type":"n8n-nodes-base.code", "typeVersion":2, "position":[2770,80], "parameters":{"jsCode":"const c=$('Legenda real e comando captura').first().json,o=String($json.stdout??'');const ok=Number($json.code)===0&&/^CV_STATUS=captured$/m.test(o)&&/^CV_FRAMES=3600$/m.test(o);if(!ok)return [];return [{json:{...c,publishCommand:`bash '${c.publisherRoot}/candle-battle-tools/candle-battle-publish.sh' publish '${c.matchId}' '${c.videoVersion}' CONFIRM_PUBLISH`}}];"} },
